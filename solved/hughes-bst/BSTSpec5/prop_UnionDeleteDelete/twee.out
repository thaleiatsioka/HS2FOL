6899. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (not_2): not(true) = false.
Axiom 3 (not_1): not(false) = true.
Axiom 4 (isLT_1): isLT(lt) = true.
Axiom 5 (isLT_2): isLT(eq) = false.
Axiom 6 (isGT_1): isGT(lt) = false.
Axiom 7 (isGT_2): isGT(eq) = false.
Axiom 8 (toList_1): toList(leaf) = nil.
Axiom 9 (opAnd_1): opAnd(false, X) = false.
Axiom 10 (opAppend_1): opAppend(nil, X) = X.
Axiom 11 (join_1): join(leaf, X) = X.
Axiom 12 (belowNat_1): belowNat(X, leaf) = leaf.
Axiom 13 (aboveNat_1): aboveNat(X, leaf) = leaf.
Axiom 14 (unionNat_1): unionNat(leaf, X) = X.
Axiom 15 (deleteNat_1): deleteNat(X, leaf) = leaf.
Axiom 16 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 17 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 18 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 19 (compareNat_2): compareNat(zero, suc(X)) = lt.
Axiom 20 (fst_1): fst(pair(X, Y)) = X.
Axiom 21 (snd_1): snd(pair(X, Y)) = Y.
Axiom 22 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 23 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 24 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 25 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 26 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 27 (geNat_1): geNat(X, Y) = not(isLT(compareNat(X, Y))).
Axiom 28 (leNat_1): leNat(X, Y) = not(isGT(compareNat(X, Y))).
Axiom 29 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 30 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 31 (eqListPairNatNat_3): eqListPairNatNat(cons(X, Y), nil) = false.
Axiom 32 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 33 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 34 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 35 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 36 (belowNat_case1_1): belowNat_case1(true, X, Y, Z, W, V) = belowNat(X, Z).
Axiom 37 (aboveNat_case1_1): aboveNat_case1(true, X, Y, Z, W, V) = aboveNat(X, W).
Axiom 38 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 39 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 40 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 41 (deleteNat_case1_case1_1): deleteNat_case1_case1(true, X, Y, Z, W, V) = branch(Z, Y, V, deleteNat(X, W)).
Axiom 42 (aboveNat_case1_2): aboveNat_case1(false, X, Y, Z, W, V) = branch(aboveNat(X, Z), Y, V, W).
Axiom 43 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 44 (insertNat_case1_1): insertNat_case1(true, X, Y, Z, W, V, U) = branch(insertNat(X, V, Z), Y, U, W).
Axiom 45 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(gtNat(X, Z), X, Z, Y, V, W).
Axiom 46 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(ltNat(X, Y), X, Y, Z, W, V).
Axiom 47 (belowNat_2): belowNat(X, branch(Y, Z, W, V)) = belowNat_case1(leNat(X, Z), X, Z, Y, V, W).
Axiom 48 (aboveNat_2): aboveNat(X, branch(Y, Z, W, V)) = aboveNat_case1(geNat(X, Z), X, Z, Y, V, W).
Axiom 49 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 50 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 51 (prop_UnionDeleteDelete_1): prop_UnionDeleteDelete(X, Y, Z) = opEqTildeEqNatNat(unionNat(deleteNat(Z, tree(X)), deleteNat(Z, tree(Y))), deleteNat(Z, unionNat(tree(X), tree(Y)))).
Axiom 52 (unionNat_3): unionNat(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(unionNat(X, belowNat(Y, branch(V, U, T, S))), Y, Z, unionNat(W, aboveNat(Y, branch(V, U, T, S)))).

Lemma 53: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 29 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 22 (foldr_1) }
  nil_1

Lemma 54: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 8 (toList_1) }
  nil

Lemma 55: unionNat(nil_1, X) = X.
Proof:
  unionNat(nil_1, X)
= { by axiom 1 (nil_1_1) }
  unionNat(leaf, X)
= { by axiom 14 (unionNat_1) }
  X

Lemma 56: join(nil_1, X) = X.
Proof:
  join(nil_1, X)
= { by axiom 1 (nil_1_1) }
  join(leaf, X)
= { by axiom 11 (join_1) }
  X

Lemma 57: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 23 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 18 (compareNat_1) }
  isLT(eq)
= { by axiom 5 (isLT_2) }
  false

Lemma 58: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 24 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 18 (compareNat_1) }
  isGT(eq)
= { by axiom 7 (isGT_2) }
  false

Lemma 59: not(ltNat(X, Y)) = geNat(X, Y).
Proof:
  not(ltNat(X, Y))
= { by axiom 23 (ltNat_1) }
  not(isLT(compareNat(X, Y)))
= { by axiom 27 (geNat_1) R->L }
  geNat(X, Y)

Lemma 60: not(gtNat(X, Y)) = leNat(X, Y).
Proof:
  not(gtNat(X, Y))
= { by axiom 24 (gtNat_1) }
  not(isGT(compareNat(X, Y)))
= { by axiom 28 (leNat_1) R->L }
  leNat(X, Y)

Lemma 61: ltNat(zero, suc(X)) = true.
Proof:
  ltNat(zero, suc(X))
= { by axiom 23 (ltNat_1) }
  isLT(compareNat(zero, suc(X)))
= { by axiom 19 (compareNat_2) }
  isLT(lt)
= { by axiom 4 (isLT_1) }
  true

Lemma 62: gtNat(zero, suc(X)) = false.
Proof:
  gtNat(zero, suc(X))
= { by axiom 24 (gtNat_1) }
  isGT(compareNat(zero, suc(X)))
= { by axiom 19 (compareNat_2) }
  isGT(lt)
= { by axiom 6 (isGT_1) }
  false

Lemma 63: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 40 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 17 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 26 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 20 (fst_1) }
  insertNat_2(X, snd(pair(X, Y)))
= { by axiom 21 (snd_1) }
  insertNat_2(X, Y)

Lemma 64: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 21 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 20 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 40 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 65: opAppend(cons(X, nil), Y) = cons(X, Y).
Proof:
  opAppend(cons(X, nil), Y)
= { by axiom 33 (opAppend_2) }
  cons(X, opAppend(nil, Y))
= { by axiom 10 (opAppend_1) }
  cons(X, Y)

Lemma 66: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by lemma 65 R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 10 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 54 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 50 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 67: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 34 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 68: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 54 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 66 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 67 }
  toList(insertNat(X, Y, nil_1))

Lemma 69: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 64 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 25 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 70: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 64 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 29 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 43 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 29 (tree_1) R->L }
  tree(cons(X, Y))

Lemma 71: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 68 R->L }
  tree(cons(pair(X, Y), nil))
= { by lemma 70 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 53 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 69 }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 63 }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 32 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 72: opAppend(toList(insertNat(X, Y, nil_1)), Z) = cons(pair(X, Y), Z).
Proof:
  opAppend(toList(insertNat(X, Y, nil_1)), Z)
= { by lemma 68 R->L }
  opAppend(cons(pair(X, Y), nil), Z)
= { by lemma 65 }
  cons(pair(X, Y), Z)

Lemma 73: tree(toList(branch(nil_1, X, Y, Z))) = insertNat(X, Y, tree(toList(Z))).
Proof:
  tree(toList(branch(nil_1, X, Y, Z)))
= { by lemma 66 R->L }
  tree(cons(pair(X, Y), toList(Z)))
= { by lemma 70 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(toList(Z))))
= { by lemma 69 }
  app(uncurry(insertNat_0, pair(X, Y)), tree(toList(Z)))
= { by lemma 63 }
  app(insertNat_2(X, Y), tree(toList(Z)))
= { by axiom 32 (app_insertNat_2_1) }
  insertNat(X, Y, tree(toList(Z)))

Lemma 74: deleteNat(zero, branch(X, zero, Y, Z)) = join(X, Z).
Proof:
  deleteNat(zero, branch(X, zero, Y, Z))
= { by axiom 45 (deleteNat_2) }
  deleteNat_case1(gtNat(zero, zero), zero, zero, X, Z, Y)
= { by lemma 58 }
  deleteNat_case1(false, zero, zero, X, Z, Y)
= { by axiom 46 (deleteNat_case1_2) }
  deleteNat_case1_case1(ltNat(zero, zero), zero, zero, X, Z, Y)
= { by lemma 57 }
  deleteNat_case1_case1(false, zero, zero, X, Z, Y)
= { by axiom 35 (deleteNat_case1_case1_2) }
  join(X, Z)

Lemma 75: insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z) = insertNat(zero, Y, insertNat(suc(X), Z, nil_1)).
Proof:
  insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z)
= { by lemma 61 R->L }
  insertNat_case1(ltNat(zero, suc(X)), zero, suc(X), nil_1, nil_1, Y, Z)
= { by axiom 49 (insertNat_2) R->L }
  insertNat(zero, Y, branch(nil_1, suc(X), Z, nil_1))
= { by lemma 67 }
  insertNat(zero, Y, insertNat(suc(X), Z, nil_1))

Lemma 76: tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1)))) = insertNat(zero, X, insertNat(suc(Y), Z, nil_1)).
Proof:
  tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1))))
= { by lemma 75 R->L }
  tree(toList(insertNat_case1(true, zero, suc(Y), nil_1, nil_1, X, Z)))
= { by axiom 44 (insertNat_case1_1) }
  tree(toList(branch(insertNat(zero, X, nil_1), suc(Y), Z, nil_1)))
= { by axiom 50 (toList_2) }
  tree(opAppend(toList(insertNat(zero, X, nil_1)), opAppend(cons(pair(suc(Y), Z), nil), toList(nil_1))))
= { by lemma 72 }
  tree(cons(pair(zero, X), opAppend(cons(pair(suc(Y), Z), nil), toList(nil_1))))
= { by lemma 65 }
  tree(cons(pair(zero, X), cons(pair(suc(Y), Z), toList(nil_1))))
= { by lemma 66 }
  tree(cons(pair(zero, X), toList(branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 66 }
  tree(toList(branch(nil_1, zero, X, branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 73 }
  insertNat(zero, X, tree(toList(branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 73 }
  insertNat(zero, X, insertNat(suc(Y), Z, tree(toList(nil_1))))
= { by lemma 54 }
  insertNat(zero, X, insertNat(suc(Y), Z, tree(nil)))
= { by lemma 53 }
  insertNat(zero, X, insertNat(suc(Y), Z, nil_1))

Goal 1 (prop_UnionDeleteDelete): prop_UnionDeleteDelete(X, Y, Z) = false.
The goal is true when:
  X = toList(insertNat(zero, W, nil_1))
  Y = toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))
  Z = zero

Proof:
  prop_UnionDeleteDelete(toList(insertNat(zero, W, nil_1)), toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1))), zero)
= { by axiom 51 (prop_UnionDeleteDelete_1) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, W, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))), deleteNat(zero, unionNat(tree(toList(insertNat(zero, W, nil_1))), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 71 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, W, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))), deleteNat(zero, unionNat(tree(toList(insertNat(zero, W, nil_1))), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 71 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, W, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 67 R->L }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, branch(nil_1, zero, W, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 74 }
  opEqTildeEqNatNat(unionNat(join(nil_1, nil_1), deleteNat(zero, tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 56 }
  opEqTildeEqNatNat(unionNat(nil_1, deleteNat(zero, tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 55 }
  opEqTildeEqNatNat(deleteNat(zero, tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 76 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, insertNat(suc(Z), Y, nil_1))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 75 R->L }
  opEqTildeEqNatNat(deleteNat(zero, insertNat_case1(true, zero, suc(Z), nil_1, nil_1, X, Y)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 44 (insertNat_case1_1) }
  opEqTildeEqNatNat(deleteNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 45 (deleteNat_2) }
  opEqTildeEqNatNat(deleteNat_case1(gtNat(zero, suc(Z)), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 62 }
  opEqTildeEqNatNat(deleteNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 46 (deleteNat_case1_2) }
  opEqTildeEqNatNat(deleteNat_case1_case1(ltNat(zero, suc(Z)), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 61 }
  opEqTildeEqNatNat(deleteNat_case1_case1(true, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 41 (deleteNat_case1_case1_1) }
  opEqTildeEqNatNat(branch(insertNat(zero, X, nil_1), suc(Z), Y, deleteNat(zero, nil_1)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(branch(insertNat(zero, X, nil_1), suc(Z), Y, deleteNat(zero, leaf)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 15 (deleteNat_1) }
  opEqTildeEqNatNat(branch(insertNat(zero, X, nil_1), suc(Z), Y, leaf), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by axiom 44 (insertNat_case1_1) R->L }
  opEqTildeEqNatNat(insertNat_case1(true, zero, suc(Z), nil_1, nil_1, X, Y), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 75 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))))
= { by lemma 76 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), insertNat(zero, X, insertNat(suc(Z), Y, nil_1)))))
= { by lemma 75 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), insertNat_case1(true, zero, suc(Z), nil_1, nil_1, X, Y))))
= { by axiom 44 (insertNat_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1))))
= { by lemma 67 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, unionNat(branch(nil_1, zero, W, nil_1), branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1))))
= { by axiom 52 (unionNat_3) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(unionNat(nil_1, belowNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1))), zero, W, unionNat(nil_1, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1))))))
= { by lemma 55 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)), zero, W, unionNat(nil_1, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1))))))
= { by lemma 55 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)), zero, W, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)))))
= { by axiom 47 (belowNat_2) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(leNat(zero, suc(Z)), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), zero, W, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)))))
= { by lemma 60 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(not(gtNat(zero, suc(Z))), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), zero, W, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)))))
= { by lemma 62 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(not(false), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), zero, W, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)))))
= { by axiom 3 (not_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(true, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y), zero, W, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)))))
= { by axiom 36 (belowNat_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, insertNat(zero, X, nil_1)), zero, W, aboveNat(zero, branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)))))
= { by axiom 48 (aboveNat_2) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, insertNat(zero, X, nil_1)), zero, W, aboveNat_case1(geNat(zero, suc(Z)), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by lemma 59 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, insertNat(zero, X, nil_1)), zero, W, aboveNat_case1(not(ltNat(zero, suc(Z))), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by lemma 61 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, insertNat(zero, X, nil_1)), zero, W, aboveNat_case1(not(true), zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 2 (not_2) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, insertNat(zero, X, nil_1)), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by lemma 67 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, branch(nil_1, zero, X, nil_1)), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 47 (belowNat_2) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(leNat(zero, zero), zero, zero, nil_1, nil_1, X), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by lemma 60 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(not(gtNat(zero, zero)), zero, zero, nil_1, nil_1, X), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by lemma 58 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(not(false), zero, zero, nil_1, nil_1, X), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 3 (not_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat_case1(true, zero, zero, nil_1, nil_1, X), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 36 (belowNat_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, nil_1), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(belowNat(zero, leaf), zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 12 (belowNat_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(leaf, zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, aboveNat_case1(false, zero, suc(Z), insertNat(zero, X, nil_1), nil_1, Y))))
= { by axiom 42 (aboveNat_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat(zero, insertNat(zero, X, nil_1)), suc(Z), Y, nil_1))))
= { by lemma 67 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat(zero, branch(nil_1, zero, X, nil_1)), suc(Z), Y, nil_1))))
= { by axiom 48 (aboveNat_2) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat_case1(geNat(zero, zero), zero, zero, nil_1, nil_1, X), suc(Z), Y, nil_1))))
= { by lemma 59 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat_case1(not(ltNat(zero, zero)), zero, zero, nil_1, nil_1, X), suc(Z), Y, nil_1))))
= { by lemma 57 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat_case1(not(false), zero, zero, nil_1, nil_1, X), suc(Z), Y, nil_1))))
= { by axiom 3 (not_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat_case1(true, zero, zero, nil_1, nil_1, X), suc(Z), Y, nil_1))))
= { by axiom 37 (aboveNat_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat(zero, nil_1), suc(Z), Y, nil_1))))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(aboveNat(zero, leaf), suc(Z), Y, nil_1))))
= { by axiom 13 (aboveNat_1) }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(leaf, suc(Z), Y, nil_1))))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, branch(nil_1, suc(Z), Y, nil_1))))
= { by lemma 67 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), deleteNat(zero, branch(nil_1, zero, W, insertNat(suc(Z), Y, nil_1))))
= { by lemma 74 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), join(nil_1, insertNat(suc(Z), Y, nil_1)))
= { by lemma 56 }
  opEqTildeEqNatNat(insertNat(zero, X, insertNat(suc(Z), Y, nil_1)), insertNat(suc(Z), Y, nil_1))
= { by lemma 75 R->L }
  opEqTildeEqNatNat(insertNat_case1(true, zero, suc(Z), nil_1, nil_1, X, Y), insertNat(suc(Z), Y, nil_1))
= { by axiom 30 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat_case1(true, zero, suc(Z), nil_1, nil_1, X, Y)), toList(insertNat(suc(Z), Y, nil_1)))
= { by axiom 44 (insertNat_case1_1) }
  eqListPairNatNat(toList(branch(insertNat(zero, X, nil_1), suc(Z), Y, nil_1)), toList(insertNat(suc(Z), Y, nil_1)))
= { by axiom 50 (toList_2) }
  eqListPairNatNat(opAppend(toList(insertNat(zero, X, nil_1)), opAppend(cons(pair(suc(Z), Y), nil), toList(nil_1))), toList(insertNat(suc(Z), Y, nil_1)))
= { by lemma 65 }
  eqListPairNatNat(opAppend(toList(insertNat(zero, X, nil_1)), cons(pair(suc(Z), Y), toList(nil_1))), toList(insertNat(suc(Z), Y, nil_1)))
= { by lemma 66 }
  eqListPairNatNat(opAppend(toList(insertNat(zero, X, nil_1)), toList(branch(nil_1, suc(Z), Y, nil_1))), toList(insertNat(suc(Z), Y, nil_1)))
= { by lemma 67 }
  eqListPairNatNat(opAppend(toList(insertNat(zero, X, nil_1)), toList(insertNat(suc(Z), Y, nil_1))), toList(insertNat(suc(Z), Y, nil_1)))
= { by lemma 72 }
  eqListPairNatNat(cons(pair(zero, X), toList(insertNat(suc(Z), Y, nil_1))), toList(insertNat(suc(Z), Y, nil_1)))
= { by lemma 66 }
  eqListPairNatNat(toList(branch(nil_1, zero, X, insertNat(suc(Z), Y, nil_1))), toList(insertNat(suc(Z), Y, nil_1)))
= { by lemma 68 R->L }
  eqListPairNatNat(toList(branch(nil_1, zero, X, insertNat(suc(Z), Y, nil_1))), cons(pair(suc(Z), Y), nil))
= { by lemma 66 R->L }
  eqListPairNatNat(cons(pair(zero, X), toList(insertNat(suc(Z), Y, nil_1))), cons(pair(suc(Z), Y), nil))
= { by axiom 39 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(zero, X), pair(suc(Z), Y)), eqListPairNatNat(toList(insertNat(suc(Z), Y, nil_1)), nil))
= { by lemma 68 R->L }
  opAnd(eqPairNatNat(pair(zero, X), pair(suc(Z), Y)), eqListPairNatNat(cons(pair(suc(Z), Y), nil), nil))
= { by axiom 31 (eqListPairNatNat_3) }
  opAnd(eqPairNatNat(pair(zero, X), pair(suc(Z), Y)), false)
= { by axiom 38 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(zero, suc(Z)), eqNat(X, Y)), false)
= { by axiom 16 (eqNat_2) }
  opAnd(opAnd(false, eqNat(X, Y)), false)
= { by axiom 9 (opAnd_1) }
  opAnd(false, false)
= { by axiom 9 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
