6853. branch(insertNat_case1(true, X, zero, Y, nil_1, Z, W), suc(V), U, unionNat(T, nil_1)) -> unionNat(branch(nil_1, suc(V), U, T), insertNat_case1(true, X, zero, Y, nil_1, Z, W))
