Lemma 56: join(nil_1, X) = X.
Proof:
  join(nil_1, X)
= { by axiom 1 (nil_1_1) }
  join(leaf, X)
= { by axiom 11 (join_1) }
  X

Lemma 57: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 23 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 18 (compareNat_1) }
  isLT(eq)
= { by axiom 5 (isLT_2) }
  false

Lemma 58: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 24 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 18 (compareNat_1) }
  isGT(eq)
= { by axiom 7 (isGT_2) }
  false

Lemma 59: not(ltNat(X, Y)) = geNat(X, Y).
Proof:
  not(ltNat(X, Y))
= { by axiom 23 (ltNat_1) }
  not(isLT(compareNat(X, Y)))
= { by axiom 27 (geNat_1) R->L }
  geNat(X, Y)

Lemma 60: not(gtNat(X, Y)) = leNat(X, Y).
Proof:
  not(gtNat(X, Y))
= { by axiom 24 (gtNat_1) }
  not(isGT(compareNat(X, Y)))
= { by axiom 28 (leNat_1) R->L }
  leNat(X, Y)

Lemma 61: ltNat(zero, suc(X)) = true.
Proof:
  ltNat(zero, suc(X))
= { by axiom 23 (ltNat_1) }
  isLT(compareNat(zero, suc(X)))
= { by axiom 19 (compareNat_2) }
  isLT(lt)
= { by axiom 4 (isLT_1) }
  true

Lemma 62: gtNat(zero, suc(X)) = false.
Proof:
  gtNat(zero, suc(X))
= { by axiom 24 (gtNat_1) }
  isGT(compareNat(zero, suc(X)))
= { by axiom 19 (compareNat_2) }
  isGT(lt)
= { by axiom 6 (isGT_1) }
  false

Lemma 63: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 40 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 17 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 26 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 20 (fst_1) }
  insertNat_2(X, snd(pair(X, Y)))
= { by axiom 21 (snd_1) }
  insertNat_2(X, Y)

Lemma 64: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 21 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 20 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 40 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 65: opAppend(cons(X, nil), Y) = cons(X, Y).
Proof:
  opAppend(cons(X, nil), Y)
= { by axiom 33 (opAppend_2) }
  cons(X, opAppend(nil, Y))
= { by axiom 10 (opAppend_1) }
  cons(X, Y)

Lemma 66: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by lemma 65 R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 10 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 54 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 50 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 67: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 34 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 68: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 54 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 66 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 67 }
  toList(insertNat(X, Y, nil_1))

Lemma 69: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 64 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 25 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 70: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 64 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 29 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 43 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 29 (tree_1) R->L }
  tree(cons(X, Y))

Lemma 71: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 68 R->L }
  tree(cons(pair(X, Y), nil))
= { by lemma 70 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 53 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 69 }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 63 }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 32 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 72: opAppend(toList(insertNat(X, Y, nil_1)), Z) = cons(pair(X, Y), Z).
Proof:
  opAppend(toList(insertNat(X, Y, nil_1)), Z)
= { by lemma 68 R->L }
  opAppend(cons(pair(X, Y), nil), Z)
= { by lemma 65 }
  cons(pair(X, Y), Z)

Lemma 73: tree(toList(branch(nil_1, X, Y, Z))) = insertNat(X, Y, tree(toList(Z))).
Proof:
  tree(toList(branch(nil_1, X, Y, Z)))
= { by lemma 66 R->L }
  tree(cons(pair(X, Y), toList(Z)))
= { by lemma 70 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(toList(Z))))
= { by lemma 69 }
  app(uncurry(insertNat_0, pair(X, Y)), tree(toList(Z)))
= { by lemma 63 }
  app(insertNat_2(X, Y), tree(toList(Z)))
= { by axiom 32 (app_insertNat_2_1) }
  insertNat(X, Y, tree(toList(Z)))

Lemma 74: deleteNat(zero, branch(X, zero, Y, Z)) = join(X, Z).
Proof:
  deleteNat(zero, branch(X, zero, Y, Z))
= { by axiom 45 (deleteNat_2) }
  deleteNat_case1(gtNat(zero, zero), zero, zero, X, Z, Y)
= { by lemma 58 }
  deleteNat_case1(false, zero, zero, X, Z, Y)
= { by axiom 46 (deleteNat_case1_2) }
  deleteNat_case1_case1(ltNat(zero, zero), zero, zero, X, Z, Y)
= { by lemma 57 }
  deleteNat_case1_case1(false, zero, zero, X, Z, Y)
= { by axiom 35 (deleteNat_case1_case1_2) }
  join(X, Z)

Lemma 75: insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z) = insertNat(zero, Y, insertNat(suc(X), Z, nil_1)).
Proof:
  insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z)
= { by lemma 61 R->L }
  insertNat_case1(ltNat(zero, suc(X)), zero, suc(X), nil_1, nil_1, Y, Z)
= { by axiom 49 (insertNat_2) R->L }
  insertNat(zero, Y, branch(nil_1, suc(X), Z, nil_1))
= { by lemma 67 }
  insertNat(zero, Y, insertNat(suc(X), Z, nil_1))

Lemma 76: tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1)))) = insertNat(zero, X, insertNat(suc(Y), Z, nil_1)).
Proof:
  tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1))))
= { by lemma 75 R->L }
  tree(toList(insertNat_case1(true, zero, suc(Y), nil_1, nil_1, X, Z)))
= { by axiom 44 (insertNat_case1_1) }
  tree(toList(branch(insertNat(zero, X, nil_1), suc(Y), Z, nil_1)))
= { by axiom 50 (toList_2) }
  tree(opAppend(toList(insertNat(zero, X, nil_1)), opAppend(cons(pair(suc(Y), Z), nil), toList(nil_1))))
= { by lemma 72 }
  tree(cons(pair(zero, X), opAppend(cons(pair(suc(Y), Z), nil), toList(nil_1))))
= { by lemma 65 }
  tree(cons(pair(zero, X), cons(pair(suc(Y), Z), toList(nil_1))))
= { by lemma 66 }
  tree(cons(pair(zero, X), toList(branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 66 }
  tree(toList(branch(nil_1, zero, X, branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 73 }
  insertNat(zero, X, tree(toList(branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 73 }
