5920. branch(X, Y, Z, join(deleteNat_case1(true, suc(W), zero, V, U, T), insertNat(S, X2, nil_1))) -> deleteNat_case1_case1(true, suc(W), Y, X, join(branch(V, zero, T, U), insertNat(S, X2, nil_1)), Z)
5921. deleteNat_case1_case1(true, suc(X), Y, Z, join(branch(nil_1, zero, W, V), insertNat(U, T, nil_1)), S) -> branch(Z, Y, S, join(branch(nil_1, zero, W, V), insertNat(U, T, nil_1)))
5922. join(branch(X, Y, Z, W), insertNat_case1(false, suc(suc(V)), suc(zero), U, T, S, X2)) -> insertNat_case1_case1(true, suc(suc(V)), Y, X, branch(join(W, U), suc(zero), X2, T), S, Z)
5923. foldr(app(X, Y), Z, cons(foldr(X, W, V), cons(uncurry(X, pair(U, T)), nil))) = app(foldr(X, W, cons(Y, V)), app(foldr(X, T, cons(Y, cons(U, nil))), Z))
5924. app(foldr(X, Y, cons(Z, cons(W, nil))), app(foldr(X, V, cons(Z, U)), T)) = foldr(app(X, Z), T, cons(uncurry(X, pair(W, Y)), cons(foldr(X, V, U), nil)))
5925. app(insertNat(zero, X, Y), app(branch(Z, zero, X, W), app(insertNat(zero, X, V), U))) -> foldr(insertNat_2(zero, X), U, cons(Y, cons(branch(Z, zero, ?, W), cons(V, nil))))
5926. eqListPairNatNat(opAppend(opAppend(cons(X, Y), Z), W), toList(insertNat_case1_case1(true, V, U, nil_1, T, S, X2))) -> opAnd(eqPairNatNat(X, pair(U, X2)), eqListPairNatNat(opAppend(opAppend(Y, Z), W), toList(insertNat(V, S, T))))
5927. eqListPairNatNat(opAppend(cons(X, Y), Z), opAppend(toList(insertNat_case1_case1(true, W, V, nil_1, U, T, S)), X2)) -> opAnd(eqPairNatNat(X, pair(V, S)), eqListPairNatNat(opAppend(Y, Z), opAppend(toList(insertNat(W, T, U)), X2)))
5928. eqListPairNatNat(toList(insertNat_case1_case1(true, X, Y, nil_1, Z, W, V)), opAppend(opAppend(cons(U, T), S), X2)) -> opAnd(eqPairNatNat(pair(Y, V), U), eqListPairNatNat(toList(insertNat(X, W, Z)), opAppend(opAppend(T, S), X2)))
5929. eqListPairNatNat(cons(X, Y), opAppend(opAppend(toList(insertNat_case1_case1(true, Z, W, nil_1, V, U, T)), S), X2)) -> opAnd(eqPairNatNat(X, pair(W, T)), eqListPairNatNat(Y, opAppend(opAppend(toList(insertNat(Z, U, V)), S), X2)))
5930. opAppend(cons(X, toList(Y)), opAppend(toList(tree(cons(Z, nil))), toList(insertNat(W, V, U)))) = cons(X, toList(insertNat_case1_case1(true, W, fst(Z), Y, U, V, snd(Z))))
5931. opEqTildeEqNatNat(deleteNat(X, deleteNat(Y, insertNat(Z, W, insertNat(V, U, nil_1)))), deleteNat(Y, deleteNat(X, insertNat(Z, W, insertNat(V, U, nil_1))))) -> prop_DeleteDelete(X, Y, toList(insertNat_case1(true, Z, V, nil_1, nil_1, W, U)))
5932. prop_DeleteDelete(X, Y, toList(insertNat_case1(true, zero, zero, nil_1, nil_1, Z, W))) -> prop_DeleteDelete(X, Y, toList(insertNat(zero, Z, nil_1)))
5933. prop_DeleteDelete(X, Y, toList(insertNat_case1(true, suc(zero), suc(zero), nil_1, nil_1, Z, W))) -> prop_DeleteDelete(X, Y, toList(insertNat(suc(zero), Z, nil_1)))
5934. prop_DeleteDelete(X, Y, toList(insertNat_case1(true, suc(suc(zero)), suc(suc(zero)), nil_1, nil_1, Z, W))) -> prop_DeleteDelete(X, Y, toList(insertNat(suc(suc(zero)), Z, nil_1)))
5935. opEqTildeEqNatNat(deleteNat(X, insertNat(zero, Y, insertNat(suc(Z), W, nil_1))), deleteNat(zero, deleteNat(X, insertNat(zero, Y, insertNat(suc(Z), W, nil_1))))) -> prop_DeleteDelete(X, zero, toList(insertNat(zero, Y, insertNat(suc(Z), W, nil_1))))
5936. prop_DeleteDelete(suc(zero), zero, toList(insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))) -> false
5937. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_1): isLT(lt) = true.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_1): isGT(lt) = false.
Axiom 5 (isGT_2): isGT(eq) = false.
Axiom 6 (toList_1): toList(leaf) = nil.
Axiom 7 (opAppend_1): opAppend(nil, X) = X.
Axiom 8 (join_1): join(leaf, X) = X.
Axiom 9 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 10 (compareNat_2): compareNat(zero, suc(X)) = lt.
Axiom 11 (compareNat_4): compareNat(suc(X), suc(Y)) = compareNat(X, Y).
Axiom 12 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 13 (deleteNat_1): deleteNat(X, leaf) = leaf.
Axiom 14 (fst_1): fst(pair(X, Y)) = X.
Axiom 15 (snd_1): snd(pair(X, Y)) = Y.
Axiom 16 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 17 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 18 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 19 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 20 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 21 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 22 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 23 (eqListPairNatNat_3): eqListPairNatNat(cons(X, Y), nil) = false.
Axiom 24 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 25 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 26 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 27 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 28 (join_2): join(branch(X, Y, Z, W), leaf) = branch(X, Y, Z, W).
Axiom 29 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 30 (deleteNat_case1_case1_1): deleteNat_case1_case1(true, X, Y, Z, W, V) = branch(Z, Y, V, deleteNat(X, W)).
Axiom 31 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 32 (insertNat_case1_1): insertNat_case1(true, X, Y, Z, W, V, U) = branch(insertNat(X, V, Z), Y, U, W).
Axiom 33 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(gtNat(X, Z), X, Z, Y, V, W).
Axiom 34 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(ltNat(X, Y), X, Y, Z, W, V).
Axiom 35 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 36 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 37 (prop_DeleteDelete_1): prop_DeleteDelete(X, Y, Z) = opEqTildeEqNatNat(deleteNat(X, deleteNat(Y, tree(Z))), deleteNat(Y, deleteNat(X, tree(Z)))).

Lemma 38: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 6 (toList_1) }
  nil

Lemma 39: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 16 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 9 (compareNat_1) }
  isLT(eq)
= { by axiom 3 (isLT_2) }
  false

Lemma 40: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 17 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 9 (compareNat_1) }
  isGT(eq)
= { by axiom 5 (isGT_2) }
  false

Lemma 41: ltNat(zero, suc(X)) = true.
Proof:
  ltNat(zero, suc(X))
= { by axiom 16 (ltNat_1) }
  isLT(compareNat(zero, suc(X)))
= { by axiom 10 (compareNat_2) }
  isLT(lt)
= { by axiom 2 (isLT_1) }
  true

Lemma 42: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 29 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 12 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 20 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 14 (fst_1) }
  insertNat_2(X, snd(pair(X, Y)))
= { by axiom 15 (snd_1) }
  insertNat_2(X, Y)

Lemma 43: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 15 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 14 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 29 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 44: opAppend(cons(X, nil), Y) = cons(X, Y).
Proof:
  opAppend(cons(X, nil), Y)
= { by axiom 25 (opAppend_2) }
  cons(X, opAppend(nil, Y))
= { by axiom 7 (opAppend_1) }
  cons(X, Y)

Lemma 45: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by lemma 44 R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 7 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 38 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 36 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 46: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 26 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 47: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 38 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 45 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 46 }
  toList(insertNat(X, Y, nil_1))

Lemma 48: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 43 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 19 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 49: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 43 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 21 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 31 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 21 (tree_1) R->L }
  tree(cons(X, Y))

Lemma 50: tree(cons(pair(X, Y), Z)) = insertNat(X, Y, tree(Z)).
Proof:
  tree(cons(pair(X, Y), Z))
= { by lemma 49 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(Z)))
= { by lemma 48 }
  app(uncurry(insertNat_0, pair(X, Y)), tree(Z))
= { by lemma 42 }
  app(insertNat_2(X, Y), tree(Z))
= { by axiom 24 (app_insertNat_2_1) }
  insertNat(X, Y, tree(Z))

Lemma 51: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 47 R->L }
  tree(cons(pair(X, Y), nil))
= { by lemma 49 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 21 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 18 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 48 }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 42 }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 24 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 52: insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z) = insertNat(zero, Y, insertNat(suc(X), Z, nil_1)).
Proof:
  insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z)
= { by lemma 41 R->L }
  insertNat_case1(ltNat(zero, suc(X)), zero, suc(X), nil_1, nil_1, Y, Z)
= { by axiom 35 (insertNat_2) R->L }
  insertNat(zero, Y, branch(nil_1, suc(X), Z, nil_1))
= { by lemma 46 }
  insertNat(zero, Y, insertNat(suc(X), Z, nil_1))

Lemma 53: deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1))) = insertNat(zero, X, nil_1).
Proof:
  deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))
= { by lemma 52 R->L }
  deleteNat(suc(zero), insertNat_case1(true, zero, suc(zero), nil_1, nil_1, X, Y))
= { by axiom 32 (insertNat_case1_1) }
  deleteNat(suc(zero), branch(insertNat(zero, X, nil_1), suc(zero), Y, nil_1))
= { by axiom 33 (deleteNat_2) }
  deleteNat_case1(gtNat(suc(zero), suc(zero)), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 17 (gtNat_1) }
  deleteNat_case1(isGT(compareNat(suc(zero), suc(zero))), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 11 (compareNat_4) }
  deleteNat_case1(isGT(compareNat(zero, zero)), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 17 (gtNat_1) R->L }
  deleteNat_case1(gtNat(zero, zero), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by lemma 40 }
  deleteNat_case1(false, suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 34 (deleteNat_case1_2) }
  deleteNat_case1_case1(ltNat(suc(zero), suc(zero)), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 16 (ltNat_1) }
  deleteNat_case1_case1(isLT(compareNat(suc(zero), suc(zero))), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 11 (compareNat_4) }
  deleteNat_case1_case1(isLT(compareNat(zero, zero)), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 16 (ltNat_1) R->L }
  deleteNat_case1_case1(ltNat(zero, zero), suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by lemma 39 }
  deleteNat_case1_case1(false, suc(zero), suc(zero), insertNat(zero, X, nil_1), nil_1, Y)
= { by axiom 27 (deleteNat_case1_case1_2) }
  join(insertNat(zero, X, nil_1), nil_1)
= { by lemma 46 R->L }
  join(branch(nil_1, zero, X, nil_1), nil_1)
= { by axiom 1 (nil_1_1) }
  join(branch(nil_1, zero, X, nil_1), leaf)
= { by axiom 28 (join_2) }
  branch(nil_1, zero, X, nil_1)
= { by lemma 46 }
  insertNat(zero, X, nil_1)

Goal 1 (prop_DeleteDelete): prop_DeleteDelete(X, Y, Z) = false.
The goal is true when:
  X = suc(zero)
  Y = zero
  Z = toList(insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))

Proof:
  prop_DeleteDelete(suc(zero), zero, toList(insertNat(zero, X, insertNat(suc(zero), Y, nil_1))))
= { by lemma 52 R->L }
  prop_DeleteDelete(suc(zero), zero, toList(insertNat_case1(true, zero, suc(zero), nil_1, nil_1, X, Y)))
= { by axiom 32 (insertNat_case1_1) }
  prop_DeleteDelete(suc(zero), zero, toList(branch(insertNat(zero, X, nil_1), suc(zero), Y, nil_1)))
= { by axiom 36 (toList_2) }
  prop_DeleteDelete(suc(zero), zero, opAppend(toList(insertNat(zero, X, nil_1)), opAppend(cons(pair(suc(zero), Y), nil), toList(nil_1))))
= { by lemma 44 }
  prop_DeleteDelete(suc(zero), zero, opAppend(toList(insertNat(zero, X, nil_1)), cons(pair(suc(zero), Y), toList(nil_1))))
= { by lemma 45 }
  prop_DeleteDelete(suc(zero), zero, opAppend(toList(insertNat(zero, X, nil_1)), toList(branch(nil_1, suc(zero), Y, nil_1))))
= { by lemma 46 }
  prop_DeleteDelete(suc(zero), zero, opAppend(toList(insertNat(zero, X, nil_1)), toList(insertNat(suc(zero), Y, nil_1))))
= { by lemma 47 R->L }
  prop_DeleteDelete(suc(zero), zero, opAppend(cons(pair(zero, X), nil), toList(insertNat(suc(zero), Y, nil_1))))
= { by lemma 44 }
  prop_DeleteDelete(suc(zero), zero, cons(pair(zero, X), toList(insertNat(suc(zero), Y, nil_1))))
= { by axiom 37 (prop_DeleteDelete_1) }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat(zero, tree(cons(pair(zero, X), toList(insertNat(suc(zero), Y, nil_1)))))), deleteNat(zero, deleteNat(suc(zero), tree(cons(pair(zero, X), toList(insertNat(suc(zero), Y, nil_1)))))))
= { by lemma 50 }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat(zero, insertNat(zero, X, tree(toList(insertNat(suc(zero), Y, nil_1)))))), deleteNat(zero, deleteNat(suc(zero), tree(cons(pair(zero, X), toList(insertNat(suc(zero), Y, nil_1)))))))
= { by lemma 50 }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat(zero, insertNat(zero, X, tree(toList(insertNat(suc(zero), Y, nil_1)))))), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, tree(toList(insertNat(suc(zero), Y, nil_1)))))))
= { by lemma 51 }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat(zero, insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, tree(toList(insertNat(suc(zero), Y, nil_1)))))))
= { by lemma 51 }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat(zero, insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by lemma 52 R->L }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat(zero, insertNat_case1(true, zero, suc(zero), nil_1, nil_1, X, Y))), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by axiom 32 (insertNat_case1_1) }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat(zero, branch(insertNat(zero, X, nil_1), suc(zero), Y, nil_1))), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by axiom 33 (deleteNat_2) }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat_case1(gtNat(zero, suc(zero)), zero, suc(zero), insertNat(zero, X, nil_1), nil_1, Y)), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by axiom 17 (gtNat_1) }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat_case1(isGT(compareNat(zero, suc(zero))), zero, suc(zero), insertNat(zero, X, nil_1), nil_1, Y)), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by axiom 10 (compareNat_2) }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat_case1(isGT(lt), zero, suc(zero), insertNat(zero, X, nil_1), nil_1, Y)), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by axiom 4 (isGT_1) }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat_case1(false, zero, suc(zero), insertNat(zero, X, nil_1), nil_1, Y)), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by axiom 34 (deleteNat_case1_2) }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat_case1_case1(ltNat(zero, suc(zero)), zero, suc(zero), insertNat(zero, X, nil_1), nil_1, Y)), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by lemma 41 }
  opEqTildeEqNatNat(deleteNat(suc(zero), deleteNat_case1_case1(true, zero, suc(zero), insertNat(zero, X, nil_1), nil_1, Y)), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
