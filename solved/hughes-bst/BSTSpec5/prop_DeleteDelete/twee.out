  opEqTildeEqNatNat(deleteNat(suc(zero), insertNat_case1(true, zero, suc(zero), nil_1, nil_1, X, Y)), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
= { by lemma 52 }
  opEqTildeEqNatNat(deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1))), deleteNat(zero, deleteNat(suc(zero), insertNat(zero, X, insertNat(suc(zero), Y, nil_1)))))
