1123. prop_FindDelete(suc(zero), suc(zero), cons(pair(suc(suc(X)), Y), cons(pair(suc(zero), ?), nil))) -> true
1124. join(join(tree(cons(X, nil)), tree(cons(Y, nil))), insertNat(Z, W, nil_1)) -> join(tree(cons(X, nil)), branch(tree(cons(Y, nil)), Z, W, nil_1))
1125. deleteNat(suc(suc(zero)), insertNat_case1(false, suc(suc(suc(X))), suc(suc(zero)), Y, Z, W, ?)) -> join(Y, insertNat(suc(suc(suc(X))), W, Z))
1126. deleteNat(suc(suc(zero)), insertNat(suc(suc(suc(X))), Y, insertNat(suc(suc(zero)), ?, nil_1))) -> insertNat(suc(suc(suc(X))), Y, nil_1)
1127. deleteNat(zero, join(insertNat(suc(X), Y, insertNat(zero, ?, nil_1)), insertNat(Z, W, nil_1))) -> insertNat_case1(true, suc(X), Z, nil_1, nil_1, Y, W)
1128. deleteNat(suc(suc(X)), join(branch(Y, suc(zero), ?, Z), branch(W, V, U, T))) -> deleteNat(suc(suc(X)), branch(join(Z, W), V, ?, T))
1129. deleteNat(suc(suc(X)), join(branch(Y, suc(zero), ?, Z), insertNat(W, V, nil_1))) -> deleteNat(suc(suc(X)), branch(join(Z, nil_1), W, ?, nil_1))
1130. foldr(uncurry(insertNat_0, X), Y, cons(tree(Z), cons(foldr(uncurry_1(insertNat_0), W, V), nil))) = app(tree(cons(X, Z)), app(foldr(uncurry_1(insertNat_0), W, cons(X, V)), Y))
1131. deleteNat(zero, join(insertNat_case1_case1(true, X, zero, Y, Z, W, ?), branch(V, U, T, S))) -> join(Y, branch(join(insertNat(X, W, Z), V), U, T, S))
1132. deleteNat(zero, join(branch(X, zero, ?, Y), insertNat_case1(true, Z, W, V, U, T, S))) -> join(X, branch(join(Y, insertNat(Z, T, V)), W, S, U))
1133. tree(cons(X, cons(pair(Y, Z), cons(pair(Y, W), V)))) = app(uncurry(insertNat_0, X), foldr(insertNat_1(Y), tree(V), cons(Z, cons(W, nil))))
1134. app(uncurry(uncurry_1(X), Y), foldr(uncurry_1(app(X, fst(fst(Y)))), Z, W)) = foldr(uncurry_1(app(X, fst(fst(Y)))), Z, cons(pair(snd(fst(Y)), snd(Y)), W))
1135. foldr(uncurry(insertNat_0, X), Y, cons(foldr(uncurry_1(insertNat_0), Z, W), cons(tree(V), nil))) = app(foldr(uncurry_1(insertNat_0), Z, cons(X, W)), app(tree(cons(X, V)), Y))
1136. eqMaybeNat(findNat(zero, deleteNat(suc(X), insertNat(Y, ?, nil_1))), findNat(zero, insertNat(Y, Z, nil_1))) -> prop_FindDelete(zero, suc(X), cons(pair(Y, Z), nil))
1137. prop_FindDelete(zero, suc(X), cons(pair(zero, Y), nil)) -> false
1138. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isLT_3): isLT(gt) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (isGT_3): isGT(gt) = true.
Axiom 6 (deleteNat_1): deleteNat(X, leaf) = leaf.
Axiom 7 (findNat_1): findNat(X, leaf) = nothing.
Axiom 8 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 9 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 10 (compareNat_3): compareNat(suc(X), zero) = gt.
Axiom 11 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 12 (fst_1): fst(pair(X, Y)) = X.
Axiom 13 (snd_1): snd(pair(X, Y)) = Y.
Axiom 14 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 15 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 16 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 17 (eqMaybeNat_2): eqMaybeNat(nothing, just(X)) = false.
Axiom 18 (prop_FindDelete_case1_case1_2): prop_FindDelete_case1_case1(false, X, Y) = findNat(X, tree(Y)).
Axiom 19 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 20 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 21 (deleteNat_case1_case1_1): deleteNat_case1_case1(true, X, Y, Z) = deleteNat(X, Z).
Axiom 22 (findNat_case1_case1_2): findNat_case1_case1(false, X, Y, Z) = just(Z).
Axiom 23 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 24 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 25 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 26 (prop_FindDelete_case1_1): prop_FindDelete_case1(X, Y, Z) = prop_FindDelete_case1_case1(eqNat(X, Y), X, Z).
Axiom 27 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W) = deleteNat_case1_case1(gtNat(X, Y), X, Z, W).
Axiom 28 (findNat_case1_2): findNat_case1(false, X, Y, Z, W, V) = findNat_case1_case1(gtNat(X, Y), X, W, V).
Axiom 29 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 30 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V).
Axiom 31 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 32 (findNat_2): findNat(X, branch(Y, Z, W, V)) = findNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 33 (prop_FindDelete_1): prop_FindDelete(X, Y, Z) = eqMaybeNat(findNat(X, deleteNat(Y, tree(Z))), prop_FindDelete_case1(X, Y, Z)).

Lemma 34: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 13 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 12 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 29 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 35: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 25 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 36: tree(cons(pair(X, Y), nil)) = insertNat(X, Y, nil_1).
Proof:
  tree(cons(pair(X, Y), nil))
= { by axiom 23 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 31 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 23 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 34 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 23 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 16 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 34 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 19 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 29 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 11 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 20 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 12 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 13 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 24 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Goal 1 (prop_FindDelete): prop_FindDelete(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = suc(Y)
  Z = cons(pair(zero, X), nil)

Proof:
  prop_FindDelete(zero, suc(Y), cons(pair(zero, X), nil))
= { by axiom 33 (prop_FindDelete_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), tree(cons(pair(zero, X), nil)))), prop_FindDelete_case1(zero, suc(Y), cons(pair(zero, X), nil)))
= { by lemma 36 }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), prop_FindDelete_case1(zero, suc(Y), cons(pair(zero, X), nil)))
= { by axiom 26 (prop_FindDelete_case1_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), prop_FindDelete_case1_case1(eqNat(zero, suc(Y)), zero, cons(pair(zero, X), nil)))
= { by axiom 8 (eqNat_2) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), prop_FindDelete_case1_case1(false, zero, cons(pair(zero, X), nil)))
= { by axiom 18 (prop_FindDelete_case1_case1_2) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 36 }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat(zero, insertNat(zero, X, nil_1)))
= { by lemma 35 R->L }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat(zero, branch(nil_1, zero, X, nil_1)))
= { by axiom 32 (findNat_2) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X))
= { by axiom 14 (ltNat_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1(isLT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, X))
= { by axiom 9 (compareNat_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1(isLT(eq), zero, zero, nil_1, nil_1, X))
= { by axiom 2 (isLT_2) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1(false, zero, zero, nil_1, nil_1, X))
= { by axiom 28 (findNat_case1_2) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1_case1(gtNat(zero, zero), zero, nil_1, X))
= { by axiom 15 (gtNat_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1_case1(isGT(compareNat(zero, zero)), zero, nil_1, X))
= { by axiom 9 (compareNat_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1_case1(isGT(eq), zero, nil_1, X))
= { by axiom 4 (isGT_2) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), findNat_case1_case1(false, zero, nil_1, X))
= { by axiom 22 (findNat_case1_case1_2) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), insertNat(zero, X, nil_1))), just(X))
= { by lemma 35 R->L }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), branch(nil_1, zero, X, nil_1))), just(X))
= { by axiom 30 (deleteNat_2) }
  eqMaybeNat(findNat(zero, deleteNat_case1(ltNat(suc(Y), zero), suc(Y), zero, nil_1, nil_1)), just(X))
= { by axiom 14 (ltNat_1) }
  eqMaybeNat(findNat(zero, deleteNat_case1(isLT(compareNat(suc(Y), zero)), suc(Y), zero, nil_1, nil_1)), just(X))
= { by axiom 10 (compareNat_3) }
  eqMaybeNat(findNat(zero, deleteNat_case1(isLT(gt), suc(Y), zero, nil_1, nil_1)), just(X))
= { by axiom 3 (isLT_3) }
  eqMaybeNat(findNat(zero, deleteNat_case1(false, suc(Y), zero, nil_1, nil_1)), just(X))
= { by axiom 27 (deleteNat_case1_2) }
  eqMaybeNat(findNat(zero, deleteNat_case1_case1(gtNat(suc(Y), zero), suc(Y), nil_1, nil_1)), just(X))
= { by axiom 15 (gtNat_1) }
  eqMaybeNat(findNat(zero, deleteNat_case1_case1(isGT(compareNat(suc(Y), zero)), suc(Y), nil_1, nil_1)), just(X))
= { by axiom 10 (compareNat_3) }
  eqMaybeNat(findNat(zero, deleteNat_case1_case1(isGT(gt), suc(Y), nil_1, nil_1)), just(X))
= { by axiom 5 (isGT_3) }
  eqMaybeNat(findNat(zero, deleteNat_case1_case1(true, suc(Y), nil_1, nil_1)), just(X))
= { by axiom 21 (deleteNat_case1_case1_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), nil_1)), just(X))
= { by axiom 1 (nil_1_1) }
  eqMaybeNat(findNat(zero, deleteNat(suc(Y), leaf)), just(X))
= { by axiom 6 (deleteNat_1) }
  eqMaybeNat(findNat(zero, leaf), just(X))
= { by axiom 7 (findNat_1) }
  eqMaybeNat(nothing, just(X))
= { by axiom 17 (eqMaybeNat_2) }
  false

RESULT: Theorem (the conjecture is true).
