283. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (not_1): not(false) = true.
Axiom 3 (isLT_3): isLT(gt) = false.
Axiom 4 (isGT_3): isGT(gt) = true.
Axiom 5 (toList_1): toList(leaf) = nil.
Axiom 6 (implies_2): implies(true, X) = X.
Axiom 7 (opAppend_1): opAppend(nil, X) = X.
Axiom 8 (deleteNat_1): deleteNat(X, leaf) = leaf.
Axiom 9 (compareNat_3): compareNat(suc(X), zero) = gt.
Axiom 10 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 11 (neqNat_1): neqNat(X, Y) = not(eqNat(X, Y)).
Axiom 12 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 13 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 14 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 15 (deleteNat_case1_case1_1): deleteNat_case1_case1(true, X, Y, Z) = deleteNat(X, Z).
Axiom 16 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 17 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 18 (eqListPairNatNat_3): eqListPairNatNat(cons(X, Y), nil) = false.
Axiom 19 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 20 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 21 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W) = deleteNat_case1_case1(gtNat(X, Y), X, Z, W).
Axiom 22 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V).
Axiom 23 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 24 (prop_InsertDeleteWeak_1): prop_InsertDeleteWeak(pair(X, Y), Z, W) = implies(neqNat(X, Z), opEqTildeEqNatNat(insertNat(X, Y, deleteNat(Z, tree(W))), deleteNat(Z, insertNat(X, Y, tree(W))))).

Lemma 25: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 16 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 14 (foldr_1) }
  nil_1

Lemma 26: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 5 (toList_1) }
  nil

Lemma 27: deleteNat(X, nil_1) = nil_1.
Proof:
  deleteNat(X, nil_1)
= { by axiom 1 (nil_1_1) }
  deleteNat(X, leaf)
= { by axiom 8 (deleteNat_1) }
  leaf
= { by axiom 1 (nil_1_1) R->L }
  nil_1

Lemma 28: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 20 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Goal 1 (prop_InsertDeleteWeak): prop_InsertDeleteWeak(X, Y, Z) = false.
The goal is true when:
  X = pair(zero, X)
  Y = suc(Y)
  Z = nil

Proof:
  prop_InsertDeleteWeak(pair(zero, X), suc(Y), nil)
= { by axiom 24 (prop_InsertDeleteWeak_1) }
  implies(neqNat(zero, suc(Y)), opEqTildeEqNatNat(insertNat(zero, X, deleteNat(suc(Y), tree(nil))), deleteNat(suc(Y), insertNat(zero, X, tree(nil)))))
= { by lemma 25 }
  implies(neqNat(zero, suc(Y)), opEqTildeEqNatNat(insertNat(zero, X, deleteNat(suc(Y), nil_1)), deleteNat(suc(Y), insertNat(zero, X, tree(nil)))))
= { by lemma 27 }
  implies(neqNat(zero, suc(Y)), opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), insertNat(zero, X, tree(nil)))))
= { by lemma 25 }
  implies(neqNat(zero, suc(Y)), opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), insertNat(zero, X, nil_1))))
= { by axiom 11 (neqNat_1) }
  implies(not(eqNat(zero, suc(Y))), opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), insertNat(zero, X, nil_1))))
= { by axiom 10 (eqNat_2) }
  implies(not(false), opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), insertNat(zero, X, nil_1))))
= { by axiom 2 (not_1) }
  implies(true, opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), insertNat(zero, X, nil_1))))
= { by axiom 6 (implies_2) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), insertNat(zero, X, nil_1)))
= { by lemma 28 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), branch(nil_1, zero, X, nil_1)))
= { by axiom 22 (deleteNat_2) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1(ltNat(suc(Y), zero), suc(Y), zero, nil_1, nil_1))
= { by axiom 12 (ltNat_1) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1(isLT(compareNat(suc(Y), zero)), suc(Y), zero, nil_1, nil_1))
= { by axiom 9 (compareNat_3) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1(isLT(gt), suc(Y), zero, nil_1, nil_1))
= { by axiom 3 (isLT_3) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1(false, suc(Y), zero, nil_1, nil_1))
= { by axiom 21 (deleteNat_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1_case1(gtNat(suc(Y), zero), suc(Y), nil_1, nil_1))
= { by axiom 13 (gtNat_1) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1_case1(isGT(compareNat(suc(Y), zero)), suc(Y), nil_1, nil_1))
= { by axiom 9 (compareNat_3) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1_case1(isGT(gt), suc(Y), nil_1, nil_1))
= { by axiom 4 (isGT_3) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat_case1_case1(true, suc(Y), nil_1, nil_1))
= { by axiom 15 (deleteNat_case1_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(suc(Y), nil_1))
= { by lemma 27 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), nil_1)
= { by axiom 17 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, X, nil_1)), toList(nil_1))
= { by lemma 26 }
  eqListPairNatNat(toList(insertNat(zero, X, nil_1)), nil)
= { by lemma 28 R->L }
  eqListPairNatNat(toList(branch(nil_1, zero, X, nil_1)), nil)
= { by axiom 23 (toList_2) }
  eqListPairNatNat(opAppend(toList(nil_1), opAppend(cons(pair(zero, X), nil), toList(nil_1))), nil)
= { by lemma 26 }
  eqListPairNatNat(opAppend(nil, opAppend(cons(pair(zero, X), nil), toList(nil_1))), nil)
= { by axiom 7 (opAppend_1) }
  eqListPairNatNat(opAppend(cons(pair(zero, X), nil), toList(nil_1)), nil)
= { by axiom 19 (opAppend_2) }
  eqListPairNatNat(cons(pair(zero, X), opAppend(nil, toList(nil_1))), nil)
= { by axiom 7 (opAppend_1) }
  eqListPairNatNat(cons(pair(zero, X), toList(nil_1)), nil)
= { by lemma 26 }
  eqListPairNatNat(cons(pair(zero, X), nil), nil)
= { by axiom 18 (eqListPairNatNat_3) }
  false

RESULT: Theorem (the conjecture is true).
