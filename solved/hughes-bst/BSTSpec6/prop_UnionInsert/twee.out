1898. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (toList_1): toList(leaf) = nil.
Axiom 5 (opAnd_2): opAnd(true, X) = X.
Axiom 6 (opAppend_1): opAppend(nil, X) = X.
Axiom 7 (union_1): union(leaf, X) = X.
Axiom 8 (eqNat_1): eqNat(zero, zero) = true.
Axiom 9 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 10 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 11 (fst_1): fst(pair(X, Y)) = X.
Axiom 12 (snd_1): snd(pair(X, Y)) = Y.
Axiom 13 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 14 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 15 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 16 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 17 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 18 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 19 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 20 (eqListPairNatNat_3): eqListPairNatNat(cons(X, Y), nil) = false.
Axiom 21 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 22 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 23 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 24 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 25 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 26 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 27 (insertNat_case1_case1_2): insertNat_case1_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, V, W).
Axiom 28 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 29 (insertNat_case1_case1_1): insertNat_case1_case1(true, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 30 (insertNat_case1_1): insertNat_case1(true, X, Y, Z, W, V, U) = branch(insertNat(X, V, Z), Y, U, W).
Axiom 31 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 32 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = insertNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V, U).
Axiom 33 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 34 (union_3): union(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(X, Y, Z, branch(union(W, V), U, T, S)).
Axiom 35 (prop_UnionInsert_1): prop_UnionInsert(X, Y, pair(Z, W)) = opEqTildeEqNatNat(union(insertNat(Z, W, tree(X)), tree(Y)), insertNat(Z, W, union(tree(X), tree(Y)))).

Lemma 36: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 18 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 15 (foldr_1) }
  nil_1

Lemma 37: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 4 (toList_1) }
  nil

Lemma 38: union(nil_1, X) = X.
Proof:
  union(nil_1, X)
= { by axiom 1 (nil_1_1) }
  union(leaf, X)
= { by axiom 7 (union_1) }
  X

Lemma 39: eqListPairNatNat(toList(X), nil) = opEqTildeEqNatNat(X, nil_1).
Proof:
  eqListPairNatNat(toList(X), nil)
= { by lemma 37 R->L }
  eqListPairNatNat(toList(X), toList(nil_1))
= { by axiom 19 (opEqTildeEqNatNat_1) R->L }
  opEqTildeEqNatNat(X, nil_1)

Lemma 40: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 12 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 11 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 26 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 41: opAppend(cons(X, nil), Y) = cons(X, Y).
Proof:
  opAppend(cons(X, nil), Y)
= { by axiom 22 (opAppend_2) }
  cons(X, opAppend(nil, Y))
= { by axiom 6 (opAppend_1) }
  cons(X, Y)

Lemma 42: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by lemma 41 R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 6 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 37 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 33 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 43: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 23 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 44: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 37 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 42 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 43 }
  toList(insertNat(X, Y, nil_1))

Lemma 45: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 44 R->L }
  tree(cons(pair(X, Y), nil))
= { by axiom 18 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 28 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 18 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 40 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 36 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 40 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 16 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 26 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 10 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 17 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 11 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 12 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 21 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 46: opAppend(toList(insertNat(X, Y, nil_1)), Z) = cons(pair(X, Y), Z).
Proof:
  opAppend(toList(insertNat(X, Y, nil_1)), Z)
= { by lemma 44 R->L }
  opAppend(cons(pair(X, Y), nil), Z)
= { by lemma 41 }
  cons(pair(X, Y), Z)

Goal 1 (prop_UnionInsert): prop_UnionInsert(X, Y, Z) = false.
The goal is true when:
  X = nil
  Y = toList(insertNat(zero, X, nil_1))
  Z = pair(zero, zero)

Proof:
  prop_UnionInsert(nil, toList(insertNat(zero, X, nil_1)), pair(zero, zero))
= { by axiom 35 (prop_UnionInsert_1) }
  opEqTildeEqNatNat(union(insertNat(zero, zero, tree(nil)), tree(toList(insertNat(zero, X, nil_1)))), insertNat(zero, zero, union(tree(nil), tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 36 }
  opEqTildeEqNatNat(union(insertNat(zero, zero, nil_1), tree(toList(insertNat(zero, X, nil_1)))), insertNat(zero, zero, union(tree(nil), tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 36 }
  opEqTildeEqNatNat(union(insertNat(zero, zero, nil_1), tree(toList(insertNat(zero, X, nil_1)))), insertNat(zero, zero, union(nil_1, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 38 }
  opEqTildeEqNatNat(union(insertNat(zero, zero, nil_1), tree(toList(insertNat(zero, X, nil_1)))), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 45 }
  opEqTildeEqNatNat(union(insertNat(zero, zero, nil_1), insertNat(zero, X, nil_1)), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 43 R->L }
  opEqTildeEqNatNat(union(branch(nil_1, zero, zero, nil_1), insertNat(zero, X, nil_1)), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 43 R->L }
  opEqTildeEqNatNat(union(branch(nil_1, zero, zero, nil_1), branch(nil_1, zero, X, nil_1)), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by axiom 34 (union_3) }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, branch(union(nil_1, nil_1), zero, X, nil_1)), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 38 }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, branch(nil_1, zero, X, nil_1)), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 43 }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, insertNat(zero, X, nil_1)), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by axiom 29 (insertNat_case1_case1_1) R->L }
  opEqTildeEqNatNat(insertNat_case1_case1(true, zero, zero, nil_1, nil_1, X, zero), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by axiom 19 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat_case1_case1(true, zero, zero, nil_1, nil_1, X, zero)), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by axiom 29 (insertNat_case1_case1_1) }
  eqListPairNatNat(toList(branch(nil_1, zero, zero, insertNat(zero, X, nil_1))), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 42 R->L }
  eqListPairNatNat(cons(pair(zero, zero), toList(insertNat(zero, X, nil_1))), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 46 R->L }
  eqListPairNatNat(opAppend(toList(insertNat(zero, zero, nil_1)), toList(insertNat(zero, X, nil_1))), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 43 R->L }
  eqListPairNatNat(opAppend(toList(insertNat(zero, zero, nil_1)), toList(branch(nil_1, zero, X, nil_1))), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 42 R->L }
  eqListPairNatNat(opAppend(toList(insertNat(zero, zero, nil_1)), cons(pair(zero, X), toList(nil_1))), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 41 R->L }
  eqListPairNatNat(opAppend(toList(insertNat(zero, zero, nil_1)), opAppend(cons(pair(zero, X), nil), toList(nil_1))), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by axiom 33 (toList_2) R->L }
  eqListPairNatNat(toList(branch(insertNat(zero, zero, nil_1), zero, X, nil_1)), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by axiom 30 (insertNat_case1_1) R->L }
  eqListPairNatNat(toList(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X)), toList(insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by axiom 19 (opEqTildeEqNatNat_1) R->L }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat(zero, zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 45 }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat(zero, zero, insertNat(zero, X, nil_1)))
= { by lemma 43 R->L }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat(zero, zero, branch(nil_1, zero, X, nil_1)))
= { by axiom 31 (insertNat_2) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, zero, X))
= { by axiom 13 (ltNat_1) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1(isLT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, zero, X))
= { by axiom 9 (compareNat_1) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1(isLT(eq), zero, zero, nil_1, nil_1, zero, X))
= { by axiom 2 (isLT_2) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1(false, zero, zero, nil_1, nil_1, zero, X))
= { by axiom 32 (insertNat_case1_2) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, nil_1, zero, X))
= { by axiom 14 (gtNat_1) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1_case1(isGT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, zero, X))
= { by axiom 9 (compareNat_1) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1_case1(isGT(eq), zero, zero, nil_1, nil_1, zero, X))
= { by axiom 3 (isGT_2) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat_case1_case1(false, zero, zero, nil_1, nil_1, zero, X))
= { by axiom 27 (insertNat_case1_case1_2) }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), branch(nil_1, zero, zero, nil_1))
= { by lemma 43 }
  opEqTildeEqNatNat(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X), insertNat(zero, zero, nil_1))
= { by axiom 19 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat_case1(true, zero, zero, nil_1, nil_1, zero, X)), toList(insertNat(zero, zero, nil_1)))
= { by axiom 30 (insertNat_case1_1) }
  eqListPairNatNat(toList(branch(insertNat(zero, zero, nil_1), zero, X, nil_1)), toList(insertNat(zero, zero, nil_1)))
= { by axiom 33 (toList_2) }
  eqListPairNatNat(opAppend(toList(insertNat(zero, zero, nil_1)), opAppend(cons(pair(zero, X), nil), toList(nil_1))), toList(insertNat(zero, zero, nil_1)))
= { by lemma 46 }
  eqListPairNatNat(cons(pair(zero, zero), opAppend(cons(pair(zero, X), nil), toList(nil_1))), toList(insertNat(zero, zero, nil_1)))
= { by lemma 41 }
  eqListPairNatNat(cons(pair(zero, zero), cons(pair(zero, X), toList(nil_1))), toList(insertNat(zero, zero, nil_1)))
= { by lemma 42 }
  eqListPairNatNat(cons(pair(zero, zero), toList(branch(nil_1, zero, X, nil_1))), toList(insertNat(zero, zero, nil_1)))
= { by lemma 42 }
  eqListPairNatNat(toList(branch(nil_1, zero, zero, branch(nil_1, zero, X, nil_1))), toList(insertNat(zero, zero, nil_1)))
= { by lemma 44 R->L }
  eqListPairNatNat(toList(branch(nil_1, zero, zero, branch(nil_1, zero, X, nil_1))), cons(pair(zero, zero), nil))
= { by lemma 42 R->L }
  eqListPairNatNat(cons(pair(zero, zero), toList(branch(nil_1, zero, X, nil_1))), cons(pair(zero, zero), nil))
= { by axiom 25 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, zero)), eqListPairNatNat(toList(branch(nil_1, zero, X, nil_1)), nil))
= { by lemma 39 }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, zero)), opEqTildeEqNatNat(branch(nil_1, zero, X, nil_1), nil_1))
= { by axiom 24 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(zero, zero), eqNat(zero, zero)), opEqTildeEqNatNat(branch(nil_1, zero, X, nil_1), nil_1))
= { by axiom 8 (eqNat_1) }
  opAnd(opAnd(true, eqNat(zero, zero)), opEqTildeEqNatNat(branch(nil_1, zero, X, nil_1), nil_1))
= { by axiom 5 (opAnd_2) }
  opAnd(eqNat(zero, zero), opEqTildeEqNatNat(branch(nil_1, zero, X, nil_1), nil_1))
= { by lemma 39 R->L }
  opAnd(eqNat(zero, zero), eqListPairNatNat(toList(branch(nil_1, zero, X, nil_1)), nil))
= { by lemma 42 R->L }
  opAnd(eqNat(zero, zero), eqListPairNatNat(cons(pair(zero, X), toList(nil_1)), nil))
= { by axiom 20 (eqListPairNatNat_3) }
  opAnd(eqNat(zero, zero), false)
= { by axiom 8 (eqNat_1) }
  opAnd(true, false)
= { by axiom 5 (opAnd_2) }
  false

RESULT: Theorem (the conjecture is true).
