3809. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (toList_1): toList(leaf) = nil.
Axiom 5 (opAppend_1): opAppend(nil, X) = X.
Axiom 6 (union_1): union(leaf, X) = X.
Axiom 7 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 8 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 9 (fst_1): fst(pair(X, Y)) = X.
Axiom 10 (snd_1): snd(pair(X, Y)) = Y.
Axiom 11 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 12 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 13 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 14 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 15 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 16 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 17 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 18 (eqListPairNatNat_3): eqListPairNatNat(cons(X, Y), nil) = false.
Axiom 19 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 20 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 21 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 22 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = union(Z, W).
Axiom 23 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 24 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 25 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 26 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 27 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 28 (union_3): union(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(X, Y, Z, branch(union(W, V), U, T, S)).
Axiom 29 (prop_DeleteUnion_1): prop_DeleteUnion(X, Y, Z) = opEqTildeEqNatNat(deleteNat(X, union(tree(Y), tree(Z))), union(deleteNat(X, tree(Y)), deleteNat(X, tree(Z)))).

Lemma 30: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 4 (toList_1) }
  nil

Lemma 31: union(nil_1, X) = X.
Proof:
  union(nil_1, X)
= { by axiom 1 (nil_1_1) }
  union(leaf, X)
= { by axiom 6 (union_1) }
  X

Lemma 32: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 10 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 9 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 23 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 33: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 21 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 34: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 30 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by axiom 5 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(nil_1)))
= { by axiom 20 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(nil_1))
= { by axiom 5 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by lemma 30 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by axiom 27 (toList_2) R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 33 }
  toList(insertNat(X, Y, nil_1))

Lemma 35: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 34 R->L }
  tree(cons(pair(X, Y), nil))
= { by axiom 16 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 24 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 16 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 32 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 16 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 13 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 32 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 14 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 23 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 8 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 15 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 9 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 10 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 19 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 36: deleteNat(zero, branch(X, zero, Y, Z)) = union(X, Z).
Proof:
  deleteNat(zero, branch(X, zero, Y, Z))
= { by axiom 25 (deleteNat_2) }
  deleteNat_case1(ltNat(zero, zero), zero, zero, X, Z, Y)
= { by axiom 11 (ltNat_1) }
  deleteNat_case1(isLT(compareNat(zero, zero)), zero, zero, X, Z, Y)
= { by axiom 7 (compareNat_1) }
  deleteNat_case1(isLT(eq), zero, zero, X, Z, Y)
= { by axiom 2 (isLT_2) }
  deleteNat_case1(false, zero, zero, X, Z, Y)
= { by axiom 26 (deleteNat_case1_2) }
  deleteNat_case1_case1(gtNat(zero, zero), zero, zero, X, Z, Y)
= { by axiom 12 (gtNat_1) }
  deleteNat_case1_case1(isGT(compareNat(zero, zero)), zero, zero, X, Z, Y)
= { by axiom 7 (compareNat_1) }
  deleteNat_case1_case1(isGT(eq), zero, zero, X, Z, Y)
= { by axiom 3 (isGT_2) }
  deleteNat_case1_case1(false, zero, zero, X, Z, Y)
= { by axiom 22 (deleteNat_case1_case1_2) }
  union(X, Z)

Lemma 37: deleteNat(zero, insertNat(zero, X, nil_1)) = nil_1.
Proof:
  deleteNat(zero, insertNat(zero, X, nil_1))
= { by lemma 33 R->L }
  deleteNat(zero, branch(nil_1, zero, X, nil_1))
= { by lemma 36 }
  union(nil_1, nil_1)
= { by lemma 31 }
  nil_1

Goal 1 (prop_DeleteUnion): prop_DeleteUnion(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = toList(insertNat(zero, Y, nil_1))
  Z = toList(insertNat(zero, X, nil_1))

Proof:
  prop_DeleteUnion(zero, toList(insertNat(zero, Y, nil_1)), toList(insertNat(zero, X, nil_1)))
= { by axiom 29 (prop_DeleteUnion_1) }
  opEqTildeEqNatNat(deleteNat(zero, union(tree(toList(insertNat(zero, Y, nil_1))), tree(toList(insertNat(zero, X, nil_1))))), union(deleteNat(zero, tree(toList(insertNat(zero, Y, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 35 }
  opEqTildeEqNatNat(deleteNat(zero, union(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, X, nil_1))))), union(deleteNat(zero, tree(toList(insertNat(zero, Y, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 35 }
  opEqTildeEqNatNat(deleteNat(zero, union(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, X, nil_1))))), union(deleteNat(zero, insertNat(zero, Y, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 37 }
  opEqTildeEqNatNat(deleteNat(zero, union(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, X, nil_1))))), union(nil_1, deleteNat(zero, tree(toList(insertNat(zero, X, nil_1))))))
= { by lemma 31 }
  opEqTildeEqNatNat(deleteNat(zero, union(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, X, nil_1))))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 35 }
  opEqTildeEqNatNat(deleteNat(zero, union(insertNat(zero, Y, nil_1), insertNat(zero, X, nil_1))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 33 R->L }
  opEqTildeEqNatNat(deleteNat(zero, union(branch(nil_1, zero, Y, nil_1), insertNat(zero, X, nil_1))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 33 R->L }
  opEqTildeEqNatNat(deleteNat(zero, union(branch(nil_1, zero, Y, nil_1), branch(nil_1, zero, X, nil_1))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by axiom 28 (union_3) }
  opEqTildeEqNatNat(deleteNat(zero, branch(nil_1, zero, Y, branch(union(nil_1, nil_1), zero, X, nil_1))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 31 }
  opEqTildeEqNatNat(deleteNat(zero, branch(nil_1, zero, Y, branch(nil_1, zero, X, nil_1))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 33 }
  opEqTildeEqNatNat(deleteNat(zero, branch(nil_1, zero, Y, insertNat(zero, X, nil_1))), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 36 }
  opEqTildeEqNatNat(union(nil_1, insertNat(zero, X, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 31 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 35 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, insertNat(zero, X, nil_1)))
= { by lemma 37 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), nil_1)
= { by axiom 17 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, X, nil_1)), toList(nil_1))
= { by lemma 30 }
  eqListPairNatNat(toList(insertNat(zero, X, nil_1)), nil)
= { by lemma 34 R->L }
  eqListPairNatNat(cons(pair(zero, X), nil), nil)
= { by axiom 18 (eqListPairNatNat_3) }
  false

RESULT: Theorem (the conjecture is true).
