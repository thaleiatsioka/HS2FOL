1024. eqNat(X, X) = prop_UnionPost(cons(pair(zero, suc(X)), nil), cons(?, nil), zero)
1025. prop_UnionPost(cons(pair(zero, X), nil), cons(?, nil), zero) -> prop_UnionPost(nil, cons(pair(zero, X), nil), zero)
