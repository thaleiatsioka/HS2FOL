1014. foldr(uncurry_1(uncurry_1(X)), foldr(uncurry(X, fst(Y)), Z, W), cons(V, cons(Y, nil))) -> app(uncurry(uncurry_1(X), V), foldr(uncurry(X, fst(Y)), Z, cons(snd(Y), W)))
