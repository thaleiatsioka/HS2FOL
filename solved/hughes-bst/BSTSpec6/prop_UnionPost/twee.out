1017. foldr(insertNat_2(X, Y), snd(Z), cons(foldr(insertNat_1(X), W, V), cons(fst(Z), nil))) = app(foldr(insertNat_1(X), W, cons(Y, V)), uncurry(insertNat_2(X, Y), Z))
