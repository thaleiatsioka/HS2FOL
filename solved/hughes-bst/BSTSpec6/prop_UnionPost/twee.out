1019. eqMaybeNat(findNat(X, union(insertNat(Y, Z, nil_1), tree(W))), opLtBarGt(findNat(X, insertNat(Y, Z, nil_1)), findNat(X, tree(W)))) -> prop_UnionPost(cons(pair(Y, Z), nil), W, X)
1020. prop_UnionPost(cons(pair(fst(X), snd(X)), nil), Y, Z) -> prop_UnionPost(cons(X, nil), Y, Z)
