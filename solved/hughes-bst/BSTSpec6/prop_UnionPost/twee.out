1011. insertNat(zero, X, insertNat(suc(Y), Z, insertNat(suc(W), V, insertNat(zero, U, nil_1)))) -> insertNat(suc(Y), Z, insertNat(suc(W), V, insertNat(zero, X, nil_1)))
