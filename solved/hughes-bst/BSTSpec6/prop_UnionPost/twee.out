1031. eqMaybeNat(findNat(zero, union(insertNat(suc(X), Y, nil_1), tree(Z))), findNat(zero, tree(Z))) -> prop_UnionPost(cons(pair(suc(X), Y), nil), Z, zero)
1032. prop_UnionPost(cons(pair(suc(X), Y), nil), cons(Z, nil), zero) -> eqMaybeNat(nothing, findNat(zero, tree(cons(Z, nil))))
1033. equals(eqMaybeNat(nothing, findNat(zero, tree(cons(X, nil)))), false) -> false
1034. equals(eqMaybeNat(nothing, findNat(zero, insertNat(X, Y, nil_1))), false) -> false
1035. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_1): isLT(lt) = true.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (opLtBarGt_1): opLtBarGt(nothing, X) = X.
Axiom 6 (union_1): union(leaf, X) = X.
Axiom 7 (findNat_1): findNat(X, leaf) = nothing.
Axiom 8 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 9 (compareNat_2): compareNat(zero, suc(X)) = lt.
Axiom 10 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 11 (fst_1): fst(pair(X, Y)) = X.
Axiom 12 (snd_1): snd(pair(X, Y)) = Y.
Axiom 13 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 14 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 15 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 16 (eqMaybeNat_2): eqMaybeNat(nothing, just(X)) = false.
Axiom 17 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 18 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 19 (findNat_case1_case1_2): findNat_case1_case1(false, X, Y, Z) = just(Z).
Axiom 20 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 21 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 22 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 23 (findNat_case1_1): findNat_case1(true, X, Y, Z, W, V) = findNat(X, Z).
Axiom 24 (findNat_case1_2): findNat_case1(false, X, Y, Z, W, V) = findNat_case1_case1(gtNat(X, Y), X, W, V).
Axiom 25 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 26 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 27 (findNat_2): findNat(X, branch(Y, Z, W, V)) = findNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 28 (union_3): union(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(X, Y, Z, branch(union(W, V), U, T, S)).
Axiom 29 (prop_UnionPost_1): prop_UnionPost(X, Y, Z) = eqMaybeNat(findNat(Z, union(tree(X), tree(Y))), opLtBarGt(findNat(Z, tree(X)), findNat(Z, tree(Y)))).

Lemma 30: findNat(X, nil_1) = nothing.
Proof:
  findNat(X, nil_1)
= { by axiom 1 (nil_1_1) }
  findNat(X, leaf)
= { by axiom 7 (findNat_1) }
  nothing

Lemma 31: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 12 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 11 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 25 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 32: app(uncurry(insertNat_0, X), nil_1) = tree(cons(X, nil)).
Proof:
  app(uncurry(insertNat_0, X), nil_1)
= { by axiom 17 (app_uncurry_1_1) R->L }
  app(app(uncurry_1(insertNat_0), X), nil_1)
= { by lemma 31 }
  uncurry(uncurry_1(insertNat_0), pair(X, nil_1))
= { by axiom 15 (foldr_1) R->L }
  uncurry(uncurry_1(insertNat_0), pair(X, foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 20 (tree_1) R->L }
  uncurry(uncurry_1(insertNat_0), pair(X, tree(nil)))
= { by lemma 31 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(nil))
= { by axiom 20 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 26 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, nil))
= { by axiom 20 (tree_1) R->L }
  tree(cons(X, nil))

Lemma 33: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 22 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 34: insertNat_2(fst(X), snd(X)) = uncurry(insertNat_0, X).
Proof:
  insertNat_2(fst(X), snd(X))
= { by axiom 18 (app_insertNat_1_1) R->L }
  app(insertNat_1(fst(X)), snd(X))
= { by axiom 10 (app_insertNat_0_1) R->L }
  app(app(insertNat_0, fst(X)), snd(X))
= { by axiom 25 (uncurry_1) R->L }
  uncurry(insertNat_0, X)

Lemma 35: tree(cons(pair(X, Y), nil)) = insertNat(X, Y, nil_1).
Proof:
  tree(cons(pair(X, Y), nil))
= { by lemma 32 R->L }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 34 R->L }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 11 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 12 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 21 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 36: insertNat(fst(X), snd(X), Y) = app(uncurry(insertNat_0, X), Y).
Proof:
  insertNat(fst(X), snd(X), Y)
= { by axiom 21 (app_insertNat_2_1) R->L }
  app(insertNat_2(fst(X), snd(X)), Y)
= { by lemma 34 }
  app(uncurry(insertNat_0, X), Y)

Lemma 37: findNat(zero, branch(X, suc(Y), Z, W)) = findNat(zero, X).
Proof:
  findNat(zero, branch(X, suc(Y), Z, W))
= { by axiom 27 (findNat_2) }
  findNat_case1(ltNat(zero, suc(Y)), zero, suc(Y), X, W, Z)
= { by axiom 13 (ltNat_1) }
  findNat_case1(isLT(compareNat(zero, suc(Y))), zero, suc(Y), X, W, Z)
= { by axiom 9 (compareNat_2) }
  findNat_case1(isLT(lt), zero, suc(Y), X, W, Z)
= { by axiom 2 (isLT_1) }
  findNat_case1(true, zero, suc(Y), X, W, Z)
= { by axiom 23 (findNat_case1_1) }
  findNat(zero, X)

Goal 1 (prop_UnionPost): prop_UnionPost(X, Y, Z) = false.
The goal is true when:
  X = cons(pair(suc(Y), Z), nil)
  Y = cons(pair(zero, X), nil)
  Z = zero

Proof:
  prop_UnionPost(cons(pair(suc(Y), Z), nil), cons(pair(zero, X), nil), zero)
= { by axiom 29 (prop_UnionPost_1) }
  eqMaybeNat(findNat(zero, union(tree(cons(pair(suc(Y), Z), nil)), tree(cons(pair(zero, X), nil)))), opLtBarGt(findNat(zero, tree(cons(pair(suc(Y), Z), nil))), findNat(zero, tree(cons(pair(zero, X), nil)))))
= { by lemma 35 }
  eqMaybeNat(findNat(zero, union(insertNat(suc(Y), Z, nil_1), tree(cons(pair(zero, X), nil)))), opLtBarGt(findNat(zero, tree(cons(pair(suc(Y), Z), nil))), findNat(zero, tree(cons(pair(zero, X), nil)))))
= { by lemma 35 }
  eqMaybeNat(findNat(zero, union(insertNat(suc(Y), Z, nil_1), tree(cons(pair(zero, X), nil)))), opLtBarGt(findNat(zero, insertNat(suc(Y), Z, nil_1)), findNat(zero, tree(cons(pair(zero, X), nil)))))
= { by lemma 33 R->L }
  eqMaybeNat(findNat(zero, union(insertNat(suc(Y), Z, nil_1), tree(cons(pair(zero, X), nil)))), opLtBarGt(findNat(zero, branch(nil_1, suc(Y), Z, nil_1)), findNat(zero, tree(cons(pair(zero, X), nil)))))
= { by lemma 37 }
  eqMaybeNat(findNat(zero, union(insertNat(suc(Y), Z, nil_1), tree(cons(pair(zero, X), nil)))), opLtBarGt(findNat(zero, nil_1), findNat(zero, tree(cons(pair(zero, X), nil)))))
= { by lemma 30 }
  eqMaybeNat(findNat(zero, union(insertNat(suc(Y), Z, nil_1), tree(cons(pair(zero, X), nil)))), opLtBarGt(nothing, findNat(zero, tree(cons(pair(zero, X), nil)))))
= { by axiom 5 (opLtBarGt_1) }
  eqMaybeNat(findNat(zero, union(insertNat(suc(Y), Z, nil_1), tree(cons(pair(zero, X), nil)))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 33 R->L }
  eqMaybeNat(findNat(zero, union(branch(nil_1, suc(Y), Z, nil_1), tree(cons(pair(zero, X), nil)))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 32 R->L }
  eqMaybeNat(findNat(zero, union(branch(nil_1, suc(Y), Z, nil_1), app(uncurry(insertNat_0, pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 36 R->L }
  eqMaybeNat(findNat(zero, union(branch(nil_1, suc(Y), Z, nil_1), insertNat(fst(pair(zero, X)), snd(pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 33 R->L }
  eqMaybeNat(findNat(zero, union(branch(nil_1, suc(Y), Z, nil_1), branch(nil_1, fst(pair(zero, X)), snd(pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by axiom 28 (union_3) }
  eqMaybeNat(findNat(zero, branch(nil_1, suc(Y), Z, branch(union(nil_1, nil_1), fst(pair(zero, X)), snd(pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by axiom 1 (nil_1_1) }
  eqMaybeNat(findNat(zero, branch(nil_1, suc(Y), Z, branch(union(leaf, nil_1), fst(pair(zero, X)), snd(pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by axiom 6 (union_1) }
  eqMaybeNat(findNat(zero, branch(nil_1, suc(Y), Z, branch(nil_1, fst(pair(zero, X)), snd(pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 33 }
  eqMaybeNat(findNat(zero, branch(nil_1, suc(Y), Z, insertNat(fst(pair(zero, X)), snd(pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 36 }
  eqMaybeNat(findNat(zero, branch(nil_1, suc(Y), Z, app(uncurry(insertNat_0, pair(zero, X)), nil_1))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 32 }
  eqMaybeNat(findNat(zero, branch(nil_1, suc(Y), Z, tree(cons(pair(zero, X), nil)))), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 37 }
  eqMaybeNat(findNat(zero, nil_1), findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 30 }
  eqMaybeNat(nothing, findNat(zero, tree(cons(pair(zero, X), nil))))
= { by lemma 35 }
  eqMaybeNat(nothing, findNat(zero, insertNat(zero, X, nil_1)))
= { by lemma 33 R->L }
  eqMaybeNat(nothing, findNat(zero, branch(nil_1, zero, X, nil_1)))
= { by axiom 27 (findNat_2) }
  eqMaybeNat(nothing, findNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X))
= { by axiom 13 (ltNat_1) }
  eqMaybeNat(nothing, findNat_case1(isLT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, X))
= { by axiom 8 (compareNat_1) }
  eqMaybeNat(nothing, findNat_case1(isLT(eq), zero, zero, nil_1, nil_1, X))
= { by axiom 3 (isLT_2) }
  eqMaybeNat(nothing, findNat_case1(false, zero, zero, nil_1, nil_1, X))
= { by axiom 24 (findNat_case1_2) }
  eqMaybeNat(nothing, findNat_case1_case1(gtNat(zero, zero), zero, nil_1, X))
= { by axiom 14 (gtNat_1) }
  eqMaybeNat(nothing, findNat_case1_case1(isGT(compareNat(zero, zero)), zero, nil_1, X))
= { by axiom 8 (compareNat_1) }
  eqMaybeNat(nothing, findNat_case1_case1(isGT(eq), zero, nil_1, X))
= { by axiom 4 (isGT_2) }
  eqMaybeNat(nothing, findNat_case1_case1(false, zero, nil_1, X))
= { by axiom 19 (findNat_case1_case1_2) }
  eqMaybeNat(nothing, just(X))
= { by axiom 16 (eqMaybeNat_2) }
  false

RESULT: Theorem (the conjecture is true).
