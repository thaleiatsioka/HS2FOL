480. foldr(insertNat_1(suc(zero)), nil_1, cons(X, toList(tree(cons(Y, nil))))) -> insertNat(suc(zero), X, nil_1)
481. insertNat_case1(true, X, Y, insertNat(X, Z, W), V, U, T) = branch(foldr(insertNat_1(X), W, cons(U, cons(Z, nil))), Y, T, V)
482. foldr(uncurry_1(X), Y, toList(insertNat_case1(true, Z, Z, nil_1, nil_1, W, V))) -> foldr(app(X, Z), Y, cons(W, cons(V, nil)))
483. tree(toList(insertNat_case1(true, X, X, nil_1, nil_1, Y, Z))) -> insertNat(X, Y, insertNat(X, Z, nil_1))
484. insertNat_case1_case1(true, X, Y, Z, insertNat(X, W, V), U, T) = branch(Z, Y, T, foldr(insertNat_1(X), V, cons(U, cons(W, nil))))
485. app(tree(cons(X, nil)), uncurry(uncurry(insertNat_0, X), Y)) = foldr(uncurry(insertNat_0, X), snd(Y), cons(nil_1, cons(fst(Y), nil)))
486. union(insertNat_case1(true, X, Y, Z, nil_1, W, V), insertNat(U, T, nil_1)) -> insertNat_case1(true, X, Y, Z, insertNat(U, T, nil_1), W, V)
487. foldr(uncurry(insertNat_0, X), Y, cons(tree(Z), cons(tree(W), nil))) = app(tree(cons(X, Z)), app(tree(cons(X, W)), Y))
488. toList(insertNat_case1_case1(true, X, fst(Y), nil_1, Z, W, snd(Y))) -> opAppend(toList(tree(cons(Y, nil))), toList(insertNat(X, W, Z)))
489. opAppend(opAppend(cons(X, toList(tree(cons(Y, nil)))), Z), W) -> opAppend(cons(X, toList(tree(cons(Y, nil)))), opAppend(Z, W))
490. union(insertNat(X, Y, nil_1), insertNat_case1_case1(true, Z, W, V, U, T, S)) -> branch(nil_1, X, Y, insertNat_case1_case1(true, Z, W, V, U, T, S))
491. union(insertNat(X, Y, nil_1), insertNat_case1(true, Z, W, V, U, T, S)) -> branch(nil_1, X, Y, insertNat_case1(true, Z, W, V, U, T, S))
492. opEqTildeEqNatNat(insertNat_case1(true, X, X, nil_1, nil_1, Y, Y), insertNat(X, Y, nil_1)) -> prop_UnionUnionIdem(toList(insertNat(X, Y, nil_1)))
493. opEqTildeEqNatNat(branch(tree(cons(X, nil)), fst(X), snd(X), nil_1), tree(cons(X, nil))) -> prop_UnionUnionIdem(cons(X, nil))
494. opEqTildeEqNatNat(nil_1, branch(insertNat_case1(true, X, Y, nil_1, Z, W, V), U, T, S)) -> false
495. opAppend(cons(X, cons(Y, toList(Z))), toList(insertNat(W, V, nil_1))) -> cons(X, cons(Y, toList(branch(Z, W, V, nil_1))))
496. tree(opAppend(opAppend(toList(branch(nil_1, X, Y, Z)), W), V)) -> insertNat(X, Y, tree(opAppend(opAppend(toList(Z), W), V)))
497. opEqTildeEqNatNat(branch(insertNat_case1(true, X, Y, nil_1, Z, W, V), U, T, S), nil_1) -> false
498. foldr(app(X, fst(Y)), Z, cons(W, cons(snd(Y), nil))) -> foldr(uncurry_1(X), Z, cons(pair(fst(Y), W), cons(Y, nil)))
499. uncurry(tree(cons(X, nil)), pair(foldr(uncurry(insertNat_0, X), Y, Z), W)) -> app(foldr(uncurry(insertNat_0, X), Y, cons(nil_1, Z)), W)
500. uncurry(insertNat(X, Y, Z), pair(app(insertNat(X, Y, W), V), U)) -> app(foldr(insertNat_2(X, Y), V, cons(Z, cons(W, nil))), U)
501. opAppend(toList(tree(cons(X, nil))), toList(tree(cons(Y, nil)))) -> toList(union(tree(cons(X, nil)), tree(cons(Y, nil))))
502. branch(X, Y, Z, insertNat_case1_case1(true, W, V, union(U, T), S, X2, Y2)) -> union(branch(X, Y, Z, U), insertNat_case1_case1(true, W, V, T, S, X2, Y2))
503. union(insertNat_case1(true, X, Y, Z, W, V, U), branch(T, S, X2, Y2)) -> insertNat_case1(true, X, Y, Z, branch(union(W, T), S, X2, Y2), V, U)
504. app(tree(opAppend(cons(X, Y), Z)), foldr(uncurry(insertNat_0, X), W, V)) -> foldr(uncurry(insertNat_0, X), W, cons(tree(opAppend(Y, Z)), V))
505. uncurry(tree(cons(X, Y)), pair(foldr(uncurry(insertNat_0, X), Z, W), V)) -> app(foldr(uncurry(insertNat_0, X), Z, cons(tree(Y), W)), V)
506. foldr(uncurry_1(X), app(uncurry(X, Y), Z), cons(W, cons(V, nil))) -> foldr(uncurry_1(X), Z, cons(W, cons(V, cons(Y, nil))))
507. opAppend(cons(X, cons(Y, toList(tree(cons(Z, nil))))), nil) -> cons(X, cons(Y, toList(tree(cons(Z, nil)))))
508. opAppend(toList(branch(nil_1, X, Y, tree(cons(Z, nil)))), nil) -> toList(branch(nil_1, X, Y, tree(cons(Z, nil))))
509. foldr(uncurry_1(uncurry_1(insertNat_0)), X, cons(Y, toList(insertNat(Z, nil_1, nil_1)))) -> app(uncurry(uncurry_1(insertNat_0), Y), app(tree(cons(Z, nil)), X))
510. eqListPairNatNat(nil, opAppend(opAppend(toList(insertNat_case1_case1(true, X, Y, nil_1, Z, W, V)), U), T)) -> false
511. eqListPairNatNat(opAppend(opAppend(toList(insertNat_case1_case1(true, X, Y, nil_1, Z, W, V)), U), T), nil) -> false
512. app(insertNat(pair(fst(X), snd(X)), Y, Z), W) = uncurry(foldr(insertNat_0, Y, toList(tree(cons(X, nil)))), pair(Z, W))
513. opEqTildeEqNatNat(insertNat_case1(true, X, Y, nil_1, nil_1, Z, W), insertNat(V, U, nil_1)) -> opAnd(eqPairNatNat(pair(X, Z), pair(V, U)), false)
514. opAnd(eqPairNatNat(pair(X, Y), pair(X, Y)), false) -> prop_UnionUnionIdem(toList(insertNat(X, Y, nil_1)))
515. prop_UnionUnionIdem(toList(insertNat(zero, X, nil_1))) = opAnd(eqNat(X, X), false)
516. equals(opAnd(eqNat(X, X), false), false) -> false
517. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (toList_1): toList(leaf) = nil.
Axiom 3 (opAnd_2): opAnd(true, X) = X.
Axiom 4 (opAppend_1): opAppend(nil, X) = X.
Axiom 5 (union_1): union(leaf, X) = X.
Axiom 6 (eqNat_1): eqNat(zero, zero) = true.
Axiom 7 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 8 (fst_1): fst(pair(X, Y)) = X.
Axiom 9 (snd_1): snd(pair(X, Y)) = Y.
Axiom 10 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 11 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 12 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 13 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 14 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 15 (eqListPairNatNat_3): eqListPairNatNat(cons(X, Y), nil) = false.
Axiom 16 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 17 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 18 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 19 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 20 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 21 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 22 (prop_UnionUnionIdem_1): prop_UnionUnionIdem(X) = opEqTildeEqNatNat(union(tree(X), tree(X)), tree(X)).
Axiom 23 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 24 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 25 (union_3): union(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(X, Y, Z, branch(union(W, V), U, T, S)).

Lemma 26: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 2 (toList_1) }
  nil

Lemma 27: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 9 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 8 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 21 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 28: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by axiom 4 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(Z)))
= { by axiom 17 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 4 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 26 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 24 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 29: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 18 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 30: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 26 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 28 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 29 }
  toList(insertNat(X, Y, nil_1))

Lemma 31: tree(cons(pair(X, Y), nil)) = insertNat(X, Y, nil_1).
Proof:
  tree(cons(pair(X, Y), nil))
= { by axiom 13 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 23 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 13 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 27 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 13 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 10 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 27 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 11 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 21 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 7 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 12 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 8 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 9 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 16 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Goal 1 (prop_UnionUnionIdem): prop_UnionUnionIdem(X) = false.
The goal is true when:
  X = toList(insertNat(zero, zero, nil_1))

Proof:
  prop_UnionUnionIdem(toList(insertNat(zero, zero, nil_1)))
= { by lemma 30 R->L }
  prop_UnionUnionIdem(cons(pair(zero, zero), nil))
= { by axiom 22 (prop_UnionUnionIdem_1) }
  opEqTildeEqNatNat(union(tree(cons(pair(zero, zero), nil)), tree(cons(pair(zero, zero), nil))), tree(cons(pair(zero, zero), nil)))
= { by lemma 31 }
  opEqTildeEqNatNat(union(insertNat(zero, zero, nil_1), tree(cons(pair(zero, zero), nil))), tree(cons(pair(zero, zero), nil)))
= { by lemma 31 }
  opEqTildeEqNatNat(union(insertNat(zero, zero, nil_1), tree(cons(pair(zero, zero), nil))), insertNat(zero, zero, nil_1))
= { by lemma 31 }
  opEqTildeEqNatNat(union(insertNat(zero, zero, nil_1), insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1))
= { by lemma 29 R->L }
  opEqTildeEqNatNat(union(branch(nil_1, zero, zero, nil_1), insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1))
= { by lemma 29 R->L }
  opEqTildeEqNatNat(union(branch(nil_1, zero, zero, nil_1), branch(nil_1, zero, zero, nil_1)), insertNat(zero, zero, nil_1))
= { by axiom 25 (union_3) }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, branch(union(nil_1, nil_1), zero, zero, nil_1)), insertNat(zero, zero, nil_1))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, branch(union(leaf, nil_1), zero, zero, nil_1)), insertNat(zero, zero, nil_1))
= { by axiom 5 (union_1) }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, branch(nil_1, zero, zero, nil_1)), insertNat(zero, zero, nil_1))
= { by lemma 29 }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1))
= { by axiom 14 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(branch(nil_1, zero, zero, insertNat(zero, zero, nil_1))), toList(insertNat(zero, zero, nil_1)))
= { by lemma 30 R->L }
  eqListPairNatNat(toList(branch(nil_1, zero, zero, insertNat(zero, zero, nil_1))), cons(pair(zero, zero), nil))
= { by lemma 28 R->L }
  eqListPairNatNat(cons(pair(zero, zero), toList(insertNat(zero, zero, nil_1))), cons(pair(zero, zero), nil))
= { by axiom 20 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, zero)), eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), nil))
= { by lemma 30 R->L }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, zero)), eqListPairNatNat(cons(pair(zero, zero), nil), nil))
= { by axiom 15 (eqListPairNatNat_3) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, zero)), false)
= { by axiom 19 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(zero, zero), eqNat(zero, zero)), false)
= { by axiom 6 (eqNat_1) }
  opAnd(opAnd(true, eqNat(zero, zero)), false)
= { by axiom 3 (opAnd_2) }
  opAnd(eqNat(zero, zero), false)
= { by axiom 6 (eqNat_1) }
  opAnd(true, false)
= { by axiom 3 (opAnd_2) }
  false

RESULT: Theorem (the conjecture is true).
