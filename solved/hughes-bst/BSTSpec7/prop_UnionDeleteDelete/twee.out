4284. foldr(insertNat_1(suc(X)), branch(Y, zero, Z, W), cons(V, cons(U, cons(T, nil)))) = insertNat_case1(false, suc(X), zero, Y, insertNat(suc(X), U, insertNat(suc(X), T, W)), V, Z)
4285. opEqTildeEqNatNat(nil_1, foldr(insertNat_1(suc(X)), branch(nil_1, zero, Y, Z), cons(W, cons(V, cons(U, nil))))) -> false
4286. opEqTildeEqNatNat(nil_1, foldr(insertNat_1(suc(X)), insertNat(zero, Y, nil_1), cons(Z, cons(W, cons(V, nil))))) -> false
4287. opEqTildeEqNatNat(nil_1, insertNat(suc(X), Y, insertNat(suc(X), Z, insertNat(suc(X), W, insertNat(zero, V, nil_1))))) -> false
4288. opEqTildeEqNatNat(foldr(insertNat_1(suc(X)), branch(nil_1, zero, Y, Z), cons(W, cons(V, cons(U, nil)))), nil_1) -> false
4289. opEqTildeEqNatNat(foldr(insertNat_1(suc(X)), insertNat(zero, Y, nil_1), cons(Z, cons(W, cons(V, nil)))), nil_1) -> false
4290. opEqTildeEqNatNat(insertNat(suc(X), Y, insertNat(suc(X), Z, insertNat(suc(X), W, insertNat(zero, V, nil_1)))), nil_1) -> false
4291. insertNat_case1(false, suc(X), zero, nil_1, insertNat(suc(X), Y, insertNat(suc(X), Z, nil_1)), W, V) = foldr(insertNat_1(suc(X)), insertNat(zero, V, nil_1), cons(W, cons(Y, cons(Z, nil))))
4292. branch(X, zero, Y, foldr(insertNat_1(suc(Z)), W, cons(V, cons(U, cons(T, nil))))) = insertNat_case1(false, suc(Z), zero, X, insertNat(suc(Z), U, insertNat(suc(Z), T, W)), V, Y)
4293. unionNat(join(branch(X, suc(Y), Z, W), insertNat(V, U, nil_1)), insertNat(zero, T, nil_1)) -> branch(nil_1, zero, T, join(branch(X, suc(Y), Z, W), insertNat(V, U, nil_1)))
4294. opAnd(eqPairNatNat(X, pair(Y, Z)), eqListPairNatNat(W, toList(branch(join(V, nil_1), U, T, nil_1)))) -> eqListPairNatNat(cons(X, W), toList(join(branch(nil_1, Y, Z, V), insertNat(U, T, nil_1))))
4295. eqListPairNatNat(cons(pair(zero, X), Y), toList(join(branch(nil_1, suc(Z), W, V), insertNat(U, T, nil_1)))) -> false
4296. eqListPairNatNat(cons(pair(suc(X), Y), Z), toList(join(branch(nil_1, zero, W, V), insertNat(U, T, nil_1)))) -> false
4297. eqListPairNatNat(cons(X, nil), toList(join(branch(nil_1, Y, Z, W), insertNat(V, U, nil_1)))) -> opAnd(eqPairNatNat(X, pair(Y, Z)), opEqTildeEqNatNat(nil_1, branch(join(W, nil_1), V, U, nil_1)))
4298. eqListPairNatNat(cons(pair(zero, X), Y), toList(join(branch(nil_1, suc(Z), W, V), tree(cons(U, nil))))) -> false
4299. eqListPairNatNat(cons(pair(suc(X), Y), Z), toList(join(branch(nil_1, zero, W, V), tree(cons(U, nil))))) -> false
4300. opEqTildeEqNatNat(unionNat(deleteNat(X, insertNat(Y, Z, nil_1)), deleteNat(X, tree(W))), deleteNat(X, unionNat(insertNat(Y, Z, nil_1), tree(W)))) -> prop_UnionDeleteDelete(toList(insertNat(Y, Z, nil_1)), W, X)
4301. opEqTildeEqNatNat(deleteNat(zero, tree(X)), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(X)))) -> prop_UnionDeleteDelete(toList(insertNat(zero, Y, nil_1)), X, zero)
4302. opEqTildeEqNatNat(deleteNat(suc(zero), tree(X)), deleteNat(suc(zero), unionNat(insertNat(suc(zero), Y, nil_1), tree(X)))) -> prop_UnionDeleteDelete(toList(insertNat(suc(zero), Y, nil_1)), X, suc(zero))
4303. prop_UnionDeleteDelete(toList(insertNat(zero, X, nil_1)), toList(insertNat(zero, Y, insertNat(suc(Z), W, nil_1))), zero) -> false
4304. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_1): isLT(lt) = true.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (toList_1): toList(leaf) = nil.
Axiom 6 (opAnd_1): opAnd(false, X) = false.
Axiom 7 (opAppend_1): opAppend(nil, X) = X.
Axiom 8 (join_1): join(leaf, X) = X.
Axiom 9 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 10 (compareNat_2): compareNat(zero, suc(X)) = lt.
Axiom 11 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 12 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 13 (eqNat_3): eqNat(suc(X), zero) = false.
Axiom 14 (unionNat_1): unionNat(leaf, X) = X.
Axiom 15 (fst_1): fst(pair(X, Y)) = X.
Axiom 16 (snd_1): snd(pair(X, Y)) = Y.
Axiom 17 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 18 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 19 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 20 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 21 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 22 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 23 (eqListPairNatNat_2): eqListPairNatNat(nil, cons(X, Y)) = false.
Axiom 24 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 25 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 26 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 27 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 28 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 29 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 30 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 31 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 32 (deleteNat_case1_1): deleteNat_case1(true, X, Y, Z, W, V) = branch(deleteNat(X, Z), Y, V, W).
Axiom 33 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 34 (insertNat_case1_case1_1): insertNat_case1_case1(true, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 35 (insertNat_case1_1): insertNat_case1(true, X, Y, Z, W, V, U) = branch(insertNat(X, V, Z), Y, U, W).
Axiom 36 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 37 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 38 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 39 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 40 (unionNat_case1_case1_1): unionNat_case1_case1(true, X, Y, Z, W, V, U, T, S) = branch(Z, X, T, branch(unionNat(V, W), Y, S, U)).
Axiom 41 (unionNat_3): unionNat(branch(X, Y, Z, W), branch(V, U, T, S)) = unionNat_case1(eqNat(Y, U), Y, U, X, V, W, S, Z, T).
Axiom 42 (unionNat_case1_2): unionNat_case1(false, X, Y, Z, W, V, U, T, S) = unionNat_case1_case1(ltNat(X, Y), X, Y, Z, W, V, U, T, S).
Axiom 43 (prop_UnionDeleteDelete_1): prop_UnionDeleteDelete(X, Y, Z) = opEqTildeEqNatNat(unionNat(deleteNat(Z, tree(X)), deleteNat(Z, tree(Y))), deleteNat(Z, unionNat(tree(X), tree(Y)))).

Lemma 44: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 22 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 19 (foldr_1) }
  nil_1

Lemma 45: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 5 (toList_1) }
  nil

Lemma 46: unionNat(nil_1, X) = X.
Proof:
  unionNat(nil_1, X)
= { by axiom 1 (nil_1_1) }
  unionNat(leaf, X)
= { by axiom 14 (unionNat_1) }
  X

Lemma 47: join(nil_1, X) = X.
Proof:
  join(nil_1, X)
= { by axiom 1 (nil_1_1) }
  join(leaf, X)
= { by axiom 8 (join_1) }
  X

Lemma 48: ltNat(zero, suc(X)) = true.
Proof:
  ltNat(zero, suc(X))
= { by axiom 17 (ltNat_1) }
  isLT(compareNat(zero, suc(X)))
= { by axiom 10 (compareNat_2) }
  isLT(lt)
= { by axiom 2 (isLT_1) }
  true

Lemma 49: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 31 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 11 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 21 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 15 (fst_1) }
  insertNat_2(X, snd(pair(X, Y)))
= { by axiom 16 (snd_1) }
  insertNat_2(X, Y)

Lemma 50: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 16 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 15 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 31 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 51: opAppend(cons(X, nil), Y) = cons(X, Y).
Proof:
  opAppend(cons(X, nil), Y)
= { by axiom 26 (opAppend_2) }
  cons(X, opAppend(nil, Y))
= { by axiom 7 (opAppend_1) }
  cons(X, Y)

Lemma 52: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by lemma 51 R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 7 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 45 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 39 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 53: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 27 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 54: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 45 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 52 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 53 }
  toList(insertNat(X, Y, nil_1))

Lemma 55: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 50 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 20 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 56: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 50 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 22 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 33 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 22 (tree_1) R->L }
  tree(cons(X, Y))

Lemma 57: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 54 R->L }
  tree(cons(pair(X, Y), nil))
= { by lemma 56 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 44 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 55 }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 49 }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 25 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 58: deleteNat(zero, branch(X, zero, Y, Z)) = join(X, Z).
Proof:
  deleteNat(zero, branch(X, zero, Y, Z))
= { by axiom 36 (deleteNat_2) }
  deleteNat_case1(ltNat(zero, zero), zero, zero, X, Z, Y)
= { by axiom 17 (ltNat_1) }
  deleteNat_case1(isLT(compareNat(zero, zero)), zero, zero, X, Z, Y)
= { by axiom 9 (compareNat_1) }
  deleteNat_case1(isLT(eq), zero, zero, X, Z, Y)
= { by axiom 3 (isLT_2) }
  deleteNat_case1(false, zero, zero, X, Z, Y)
= { by axiom 37 (deleteNat_case1_2) }
  deleteNat_case1_case1(gtNat(zero, zero), zero, zero, X, Z, Y)
= { by axiom 18 (gtNat_1) }
  deleteNat_case1_case1(isGT(compareNat(zero, zero)), zero, zero, X, Z, Y)
= { by axiom 9 (compareNat_1) }
  deleteNat_case1_case1(isGT(eq), zero, zero, X, Z, Y)
= { by axiom 4 (isGT_2) }
  deleteNat_case1_case1(false, zero, zero, X, Z, Y)
= { by axiom 28 (deleteNat_case1_case1_2) }
  join(X, Z)

Lemma 59: deleteNat(zero, insertNat(zero, X, nil_1)) = nil_1.
Proof:
  deleteNat(zero, insertNat(zero, X, nil_1))
= { by lemma 53 R->L }
  deleteNat(zero, branch(nil_1, zero, X, nil_1))
= { by lemma 58 }
  join(nil_1, nil_1)
= { by lemma 47 }
  nil_1

Lemma 60: opAppend(toList(insertNat(X, Y, nil_1)), Z) = cons(pair(X, Y), Z).
Proof:
  opAppend(toList(insertNat(X, Y, nil_1)), Z)
= { by lemma 54 R->L }
  opAppend(cons(pair(X, Y), nil), Z)
= { by lemma 51 }
  cons(pair(X, Y), Z)

Lemma 61: tree(toList(branch(nil_1, X, Y, Z))) = insertNat(X, Y, tree(toList(Z))).
Proof:
  tree(toList(branch(nil_1, X, Y, Z)))
= { by lemma 52 R->L }
  tree(cons(pair(X, Y), toList(Z)))
= { by lemma 56 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(toList(Z))))
= { by lemma 55 }
  app(uncurry(insertNat_0, pair(X, Y)), tree(toList(Z)))
= { by lemma 49 }
  app(insertNat_2(X, Y), tree(toList(Z)))
= { by axiom 25 (app_insertNat_2_1) }
  insertNat(X, Y, tree(toList(Z)))

Lemma 62: insertNat(zero, X, branch(Y, suc(Z), W, V)) = insertNat_case1(true, zero, suc(Z), Y, V, X, W).
Proof:
  insertNat(zero, X, branch(Y, suc(Z), W, V))
= { by axiom 38 (insertNat_2) }
  insertNat_case1(ltNat(zero, suc(Z)), zero, suc(Z), Y, V, X, W)
= { by lemma 48 }
  insertNat_case1(true, zero, suc(Z), Y, V, X, W)

Lemma 63: insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z) = insertNat(zero, Y, insertNat(suc(X), Z, nil_1)).
Proof:
  insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z)
= { by lemma 62 R->L }
  insertNat(zero, Y, branch(nil_1, suc(X), Z, nil_1))
= { by lemma 53 }
  insertNat(zero, Y, insertNat(suc(X), Z, nil_1))

Lemma 64: tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1)))) = insertNat(zero, X, insertNat(suc(Y), Z, nil_1)).
Proof:
  tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1))))
= { by lemma 63 R->L }
  tree(toList(insertNat_case1(true, zero, suc(Y), nil_1, nil_1, X, Z)))
= { by axiom 35 (insertNat_case1_1) }
  tree(toList(branch(insertNat(zero, X, nil_1), suc(Y), Z, nil_1)))
= { by axiom 39 (toList_2) }
  tree(opAppend(toList(insertNat(zero, X, nil_1)), opAppend(cons(pair(suc(Y), Z), nil), toList(nil_1))))
= { by lemma 60 }
  tree(cons(pair(zero, X), opAppend(cons(pair(suc(Y), Z), nil), toList(nil_1))))
= { by lemma 51 }
  tree(cons(pair(zero, X), cons(pair(suc(Y), Z), toList(nil_1))))
= { by lemma 52 }
  tree(cons(pair(zero, X), toList(branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 52 }
  tree(toList(branch(nil_1, zero, X, branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 61 }
  insertNat(zero, X, tree(toList(branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 61 }
  insertNat(zero, X, insertNat(suc(Y), Z, tree(toList(nil_1))))
= { by lemma 45 }
  insertNat(zero, X, insertNat(suc(Y), Z, tree(nil)))
= { by lemma 44 }
  insertNat(zero, X, insertNat(suc(Y), Z, nil_1))

Goal 1 (prop_UnionDeleteDelete): prop_UnionDeleteDelete(X, Y, Z) = false.
The goal is true when:
  X = toList(insertNat(zero, W, nil_1))
  Y = toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))
  Z = zero

Proof:
  prop_UnionDeleteDelete(toList(insertNat(zero, W, nil_1)), toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1))), zero)
= { by axiom 43 (prop_UnionDeleteDelete_1) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, W, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))), deleteNat(zero, unionNat(tree(toList(insertNat(zero, W, nil_1))), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 57 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, W, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))), deleteNat(zero, unionNat(tree(toList(insertNat(zero, W, nil_1))), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 57 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, W, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 59 }
  opEqTildeEqNatNat(unionNat(nil_1, deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 46 }
  opEqTildeEqNatNat(deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1))))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 64 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, Y, insertNat(suc(Z), X, nil_1))), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 63 R->L }
  opEqTildeEqNatNat(deleteNat(zero, insertNat_case1(true, zero, suc(Z), nil_1, nil_1, Y, X)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by axiom 35 (insertNat_case1_1) }
  opEqTildeEqNatNat(deleteNat(zero, branch(insertNat(zero, Y, nil_1), suc(Z), X, nil_1)), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by axiom 36 (deleteNat_2) }
  opEqTildeEqNatNat(deleteNat_case1(ltNat(zero, suc(Z)), zero, suc(Z), insertNat(zero, Y, nil_1), nil_1, X), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 48 }
  opEqTildeEqNatNat(deleteNat_case1(true, zero, suc(Z), insertNat(zero, Y, nil_1), nil_1, X), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by axiom 32 (deleteNat_case1_1) }
  opEqTildeEqNatNat(branch(deleteNat(zero, insertNat(zero, Y, nil_1)), suc(Z), X, nil_1), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 59 }
  opEqTildeEqNatNat(branch(nil_1, suc(Z), X, nil_1), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 53 }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), tree(toList(insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))))
= { by lemma 64 }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))
= { by lemma 63 R->L }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), insertNat_case1(true, zero, suc(Z), nil_1, nil_1, Y, X))))
= { by axiom 35 (insertNat_case1_1) }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat(insertNat(zero, W, nil_1), branch(insertNat(zero, Y, nil_1), suc(Z), X, nil_1))))
= { by lemma 53 R->L }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat(branch(nil_1, zero, W, nil_1), branch(insertNat(zero, Y, nil_1), suc(Z), X, nil_1))))
= { by axiom 41 (unionNat_3) }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat_case1(eqNat(zero, suc(Z)), zero, suc(Z), nil_1, insertNat(zero, Y, nil_1), nil_1, nil_1, W, X)))
= { by axiom 12 (eqNat_2) }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat_case1(false, zero, suc(Z), nil_1, insertNat(zero, Y, nil_1), nil_1, nil_1, W, X)))
= { by axiom 42 (unionNat_case1_2) }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat_case1_case1(ltNat(zero, suc(Z)), zero, suc(Z), nil_1, insertNat(zero, Y, nil_1), nil_1, nil_1, W, X)))
= { by lemma 48 }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, unionNat_case1_case1(true, zero, suc(Z), nil_1, insertNat(zero, Y, nil_1), nil_1, nil_1, W, X)))
= { by axiom 40 (unionNat_case1_case1_1) }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, branch(nil_1, zero, W, branch(unionNat(nil_1, insertNat(zero, Y, nil_1)), suc(Z), X, nil_1))))
= { by lemma 46 }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, branch(nil_1, zero, W, branch(insertNat(zero, Y, nil_1), suc(Z), X, nil_1))))
= { by axiom 35 (insertNat_case1_1) R->L }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, branch(nil_1, zero, W, insertNat_case1(true, zero, suc(Z), nil_1, nil_1, Y, X))))
= { by lemma 62 R->L }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, branch(nil_1, zero, W, insertNat(zero, Y, branch(nil_1, suc(Z), X, nil_1)))))
= { by axiom 34 (insertNat_case1_case1_1) R->L }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, insertNat_case1_case1(true, zero, zero, nil_1, branch(nil_1, suc(Z), X, nil_1), Y, W)))
= { by lemma 53 }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, insertNat_case1_case1(true, zero, zero, nil_1, insertNat(suc(Z), X, nil_1), Y, W)))
= { by axiom 34 (insertNat_case1_case1_1) }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), deleteNat(zero, branch(nil_1, zero, W, insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))))
= { by lemma 58 }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), join(nil_1, insertNat(zero, Y, insertNat(suc(Z), X, nil_1))))
= { by lemma 47 }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), insertNat(zero, Y, insertNat(suc(Z), X, nil_1)))
= { by lemma 63 R->L }
  opEqTildeEqNatNat(insertNat(suc(Z), X, nil_1), insertNat_case1(true, zero, suc(Z), nil_1, nil_1, Y, X))
= { by axiom 24 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), toList(insertNat_case1(true, zero, suc(Z), nil_1, nil_1, Y, X)))
= { by axiom 35 (insertNat_case1_1) }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), toList(branch(insertNat(zero, Y, nil_1), suc(Z), X, nil_1)))
= { by axiom 39 (toList_2) }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), opAppend(toList(insertNat(zero, Y, nil_1)), opAppend(cons(pair(suc(Z), X), nil), toList(nil_1))))
= { by lemma 51 }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), opAppend(toList(insertNat(zero, Y, nil_1)), cons(pair(suc(Z), X), toList(nil_1))))
= { by lemma 52 }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), opAppend(toList(insertNat(zero, Y, nil_1)), toList(branch(nil_1, suc(Z), X, nil_1))))
= { by lemma 53 }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), opAppend(toList(insertNat(zero, Y, nil_1)), toList(insertNat(suc(Z), X, nil_1))))
= { by lemma 60 }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), cons(pair(zero, Y), toList(insertNat(suc(Z), X, nil_1))))
= { by lemma 52 }
  eqListPairNatNat(toList(insertNat(suc(Z), X, nil_1)), toList(branch(nil_1, zero, Y, insertNat(suc(Z), X, nil_1))))
= { by lemma 54 R->L }
  eqListPairNatNat(cons(pair(suc(Z), X), nil), toList(branch(nil_1, zero, Y, insertNat(suc(Z), X, nil_1))))
= { by lemma 52 R->L }
  eqListPairNatNat(cons(pair(suc(Z), X), nil), cons(pair(zero, Y), toList(insertNat(suc(Z), X, nil_1))))
= { by axiom 30 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(suc(Z), X), pair(zero, Y)), eqListPairNatNat(nil, toList(insertNat(suc(Z), X, nil_1))))
= { by lemma 54 R->L }
  opAnd(eqPairNatNat(pair(suc(Z), X), pair(zero, Y)), eqListPairNatNat(nil, cons(pair(suc(Z), X), nil)))
= { by axiom 23 (eqListPairNatNat_2) }
  opAnd(eqPairNatNat(pair(suc(Z), X), pair(zero, Y)), false)
= { by axiom 29 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(suc(Z), zero), eqNat(X, Y)), false)
= { by axiom 13 (eqNat_3) }
  opAnd(opAnd(false, eqNat(X, Y)), false)
= { by axiom 6 (opAnd_1) }
  opAnd(false, false)
= { by axiom 6 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
