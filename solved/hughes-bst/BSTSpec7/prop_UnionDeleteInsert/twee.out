10789. opEqTildeEqNatNat(branch(nil_1, X, zero, Y), join(branch(nil_1, Z, suc(W), V), branch(U, T, S, X2))) -> opAnd(opAnd(eqNat(X, Z), false), opEqTildeEqNatNat(Y, branch(join(V, U), T, S, X2)))
10790. opEqTildeEqNatNat(branch(nil_1, X, zero, Y), join(branch(nil_1, Z, suc(W), V), insertNat(U, T, nil_1))) -> opAnd(opAnd(eqNat(X, Z), false), opEqTildeEqNatNat(Y, branch(join(V, nil_1), U, T, nil_1)))
10791. opEqTildeEqNatNat(join(branch(nil_1, X, suc(Y), Z), branch(W, V, U, T)), branch(nil_1, S, zero, X2)) -> opAnd(opAnd(eqNat(X, S), false), opEqTildeEqNatNat(branch(join(Z, W), V, U, T), X2))
10792. opEqTildeEqNatNat(join(branch(nil_1, X, suc(Y), Z), insertNat(W, V, nil_1)), branch(nil_1, U, zero, T)) -> opAnd(opAnd(eqNat(X, U), false), opEqTildeEqNatNat(branch(join(Z, nil_1), W, V, nil_1), T))
10793. opEqTildeEqNatNat(branch(nil_1, X, suc(Y), Z), join(branch(nil_1, W, zero, V), branch(U, T, S, X2))) -> opAnd(opAnd(eqNat(X, W), false), opEqTildeEqNatNat(Z, branch(join(V, U), T, S, X2)))
10794. opEqTildeEqNatNat(branch(nil_1, X, suc(Y), Z), join(branch(nil_1, W, zero, V), insertNat(U, T, nil_1))) -> opAnd(opAnd(eqNat(X, W), false), opEqTildeEqNatNat(Z, branch(join(V, nil_1), U, T, nil_1)))
10795. deleteNat_case1(true, zero, X, join(deleteNat_case1(true, Y, zero, Z, W, V), insertNat(U, T, nil_1)), S, X2) -> branch(join(deleteNat(Y, Z), branch(join(W, nil_1), U, T, nil_1)), X, X2, S)
10796. uncurry(insertNat(zero, X, Y), pair(app(insertNat_case1(true, zero, suc(Z), W, V, X, U), T), S)) -> app(foldr(insertNat_2(zero, X), T, cons(Y, cons(branch(W, suc(Z), U, V), nil))), S)
10797. join(branch(X, Y, Z, unionNat_case1_case1(true, W, V, U, T, S, X2, Y2, Z2)), insertNat(W2, V2, nil_1)) -> branch(X, Y, Z, branch(unionNat_case1_case1(true, W, V, U, T, S, X2, Y2, Z2), W2, V2, nil_1))
10798. insertNat(suc(suc(zero)), X, join(branch(Y, suc(suc(zero)), Z, W), deleteNat_case1_case1(true, V, U, T, S, X2))) -> join(branch(Y, suc(suc(zero)), X, W), deleteNat_case1_case1(true, V, U, T, S, X2))
10799. deleteNat_case1(false, suc(X), zero, Y, branch(branch(Z, W, V, U), fst(T), snd(T), nil_1), S) -> deleteNat(suc(X), join(branch(Y, zero, S, branch(Z, W, V, U)), tree(cons(T, nil))))
10800. deleteNat_case1(true, suc(X), Y, insertNat_case1(true, Z, zero, W, insertNat(zero, V, nil_1), U, T), S, X2) -> branch(insertNat_case1(true, Z, zero, W, insertNat(zero, V, nil_1), U, T), Y, X2, S)
10801. foldr(insertNat(X, Y, Z), foldr(uncurry_1(insertNat_2(X, Y)), W, toList(V)), cons(U, cons(T, nil))) = foldr(uncurry_1(insertNat_2(X, Y)), W, toList(insertNat_case1(true, Z, Z, nil_1, V, U, T)))
10802. opEqTildeEqNatNat(unionNat(deleteNat(X, insertNat(Y, Z, nil_1)), insertNat(X, W, tree(V))), insertNat(X, W, unionNat(insertNat(Y, Z, nil_1), tree(V)))) -> prop_UnionDeleteInsert(toList(insertNat(Y, Z, nil_1)), V, pair(X, W))
10803. opEqTildeEqNatNat(insertNat(zero, X, tree(Y)), insertNat(zero, X, unionNat(insertNat(zero, Z, nil_1), tree(Y)))) -> prop_UnionDeleteInsert(toList(insertNat(zero, Z, nil_1)), Y, pair(zero, X))
10804. opEqTildeEqNatNat(insertNat(suc(zero), X, tree(Y)), insertNat(suc(zero), X, unionNat(insertNat(suc(zero), Z, nil_1), tree(Y)))) -> prop_UnionDeleteInsert(toList(insertNat(suc(zero), Z, nil_1)), Y, pair(suc(zero), X))
10805. prop_UnionDeleteInsert(toList(insertNat(zero, ?, nil_1)), toList(insertNat(zero, ?, insertNat(suc(?), ?, nil_1))), pair(zero, X)) = opAnd(eqNat(X, X), false)
10806. prop_UnionDeleteInsert(toList(insertNat(zero, X, nil_1)), toList(insertNat(zero, Y, insertNat(suc(Z), W, nil_1))), pair(zero, V)) ~> prop_UnionDeleteInsert(toList(insertNat(zero, ?, nil_1)), toList(insertNat(zero, ?, insertNat(suc(?), ?, nil_1))), pair(zero, V))
10807. equals(opAnd(eqNat(X, X), false), false) -> false
10808. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_1): isLT(lt) = true.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (isGT_3): isGT(gt) = true.
Axiom 6 (toList_1): toList(leaf) = nil.
Axiom 7 (opAnd_2): opAnd(true, X) = X.
Axiom 8 (opAnd_1): opAnd(false, X) = false.
Axiom 9 (opAppend_1): opAppend(nil, X) = X.
Axiom 10 (join_1): join(leaf, X) = X.
Axiom 11 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 12 (compareNat_2): compareNat(zero, suc(X)) = lt.
Axiom 13 (compareNat_3): compareNat(suc(X), zero) = gt.
Axiom 14 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 15 (eqNat_1): eqNat(zero, zero) = true.
Axiom 16 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 17 (eqNat_3): eqNat(suc(X), zero) = false.
Axiom 18 (unionNat_1): unionNat(leaf, X) = X.
Axiom 19 (fst_1): fst(pair(X, Y)) = X.
Axiom 20 (snd_1): snd(pair(X, Y)) = Y.
Axiom 21 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 22 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 23 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 24 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 25 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 26 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 27 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 28 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 29 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 30 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 31 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 32 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 33 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 34 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 35 (insertNat_case1_case1_2): insertNat_case1_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, V, W).
Axiom 36 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 37 (insertNat_case1_case1_1): insertNat_case1_case1(true, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 38 (insertNat_case1_1): insertNat_case1(true, X, Y, Z, W, V, U) = branch(insertNat(X, V, Z), Y, U, W).
Axiom 39 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 40 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 41 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 42 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = insertNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V, U).
Axiom 43 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 44 (unionNat_case1_case1_1): unionNat_case1_case1(true, X, Y, Z, W, V, U, T, S) = branch(Z, X, T, branch(unionNat(V, W), Y, S, U)).
Axiom 45 (unionNat_3): unionNat(branch(X, Y, Z, W), branch(V, U, T, S)) = unionNat_case1(eqNat(Y, U), Y, U, X, V, W, S, Z, T).
Axiom 46 (unionNat_case1_2): unionNat_case1(false, X, Y, Z, W, V, U, T, S) = unionNat_case1_case1(ltNat(X, Y), X, Y, Z, W, V, U, T, S).
Axiom 47 (prop_UnionDeleteInsert_1): prop_UnionDeleteInsert(X, Y, pair(Z, W)) = opEqTildeEqNatNat(unionNat(deleteNat(Z, tree(X)), insertNat(Z, W, tree(Y))), insertNat(Z, W, unionNat(tree(X), tree(Y)))).

Lemma 48: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 26 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 23 (foldr_1) }
  nil_1

Lemma 49: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 6 (toList_1) }
  nil

Lemma 50: unionNat(nil_1, X) = X.
Proof:
  unionNat(nil_1, X)
= { by axiom 1 (nil_1_1) }
  unionNat(leaf, X)
= { by axiom 18 (unionNat_1) }
  X

Lemma 51: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 21 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 11 (compareNat_1) }
  isLT(eq)
= { by axiom 3 (isLT_2) }
  false

Lemma 52: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 22 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 11 (compareNat_1) }
  isGT(eq)
= { by axiom 4 (isGT_2) }
  false

Lemma 53: ltNat(zero, suc(X)) = true.
Proof:
  ltNat(zero, suc(X))
= { by axiom 21 (ltNat_1) }
  isLT(compareNat(zero, suc(X)))
= { by axiom 12 (compareNat_2) }
  isLT(lt)
= { by axiom 2 (isLT_1) }
  true

Lemma 54: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 34 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 14 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 25 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 19 (fst_1) }
  insertNat_2(X, snd(pair(X, Y)))
= { by axiom 20 (snd_1) }
  insertNat_2(X, Y)

Lemma 55: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 20 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 19 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 34 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 56: opAppend(cons(X, nil), Y) = cons(X, Y).
Proof:
  opAppend(cons(X, nil), Y)
= { by axiom 29 (opAppend_2) }
  cons(X, opAppend(nil, Y))
= { by axiom 9 (opAppend_1) }
  cons(X, Y)

Lemma 57: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by lemma 56 R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 9 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 49 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 43 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 58: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 30 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 59: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 49 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 57 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 58 }
  toList(insertNat(X, Y, nil_1))

Lemma 60: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 55 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 24 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 61: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 55 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 26 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 36 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 26 (tree_1) R->L }
  tree(cons(X, Y))

Lemma 62: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 59 R->L }
  tree(cons(pair(X, Y), nil))
= { by lemma 61 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 48 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 60 }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 54 }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 28 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 63: opAppend(toList(insertNat(X, Y, nil_1)), Z) = cons(pair(X, Y), Z).
Proof:
  opAppend(toList(insertNat(X, Y, nil_1)), Z)
= { by lemma 59 R->L }
  opAppend(cons(pair(X, Y), nil), Z)
= { by lemma 56 }
  cons(pair(X, Y), Z)

Lemma 64: tree(toList(branch(nil_1, X, Y, Z))) = insertNat(X, Y, tree(toList(Z))).
Proof:
  tree(toList(branch(nil_1, X, Y, Z)))
= { by lemma 57 R->L }
  tree(cons(pair(X, Y), toList(Z)))
= { by lemma 61 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(toList(Z))))
= { by lemma 60 }
  app(uncurry(insertNat_0, pair(X, Y)), tree(toList(Z)))
= { by lemma 54 }
  app(insertNat_2(X, Y), tree(toList(Z)))
= { by axiom 28 (app_insertNat_2_1) }
  insertNat(X, Y, tree(toList(Z)))

Lemma 65: insertNat(zero, X, branch(Y, zero, Z, W)) = branch(Y, zero, X, W).
Proof:
  insertNat(zero, X, branch(Y, zero, Z, W))
= { by axiom 41 (insertNat_2) }
  insertNat_case1(ltNat(zero, zero), zero, zero, Y, W, X, Z)
= { by lemma 51 }
  insertNat_case1(false, zero, zero, Y, W, X, Z)
= { by axiom 42 (insertNat_case1_2) }
  insertNat_case1_case1(gtNat(zero, zero), zero, zero, Y, W, X, Z)
= { by lemma 52 }
  insertNat_case1_case1(false, zero, zero, Y, W, X, Z)
= { by axiom 35 (insertNat_case1_case1_2) }
  branch(Y, zero, X, W)

Lemma 66: opAppend(toList(X), toList(branch(nil_1, Y, Z, W))) = toList(branch(X, Y, Z, W)).
Proof:
  opAppend(toList(X), toList(branch(nil_1, Y, Z, W)))
= { by lemma 57 R->L }
  opAppend(toList(X), cons(pair(Y, Z), toList(W)))
= { by lemma 56 R->L }
  opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W)))
= { by axiom 43 (toList_2) R->L }
  toList(branch(X, Y, Z, W))

Lemma 67: insertNat(zero, X, branch(Y, suc(Z), W, V)) = insertNat_case1(true, zero, suc(Z), Y, V, X, W).
Proof:
  insertNat(zero, X, branch(Y, suc(Z), W, V))
= { by axiom 41 (insertNat_2) }
  insertNat_case1(ltNat(zero, suc(Z)), zero, suc(Z), Y, V, X, W)
= { by lemma 53 }
  insertNat_case1(true, zero, suc(Z), Y, V, X, W)

Lemma 68: toList(insertNat_case1_case1(true, X, Y, nil_1, nil_1, Z, W)) = toList(insertNat_case1(true, Y, X, nil_1, nil_1, W, Z)).
Proof:
  toList(insertNat_case1_case1(true, X, Y, nil_1, nil_1, Z, W))
= { by axiom 37 (insertNat_case1_case1_1) }
  toList(branch(nil_1, Y, W, insertNat(X, Z, nil_1)))
= { by lemma 57 R->L }
  cons(pair(Y, W), toList(insertNat(X, Z, nil_1)))
= { by lemma 63 R->L }
  opAppend(toList(insertNat(Y, W, nil_1)), toList(insertNat(X, Z, nil_1)))
= { by lemma 58 R->L }
  opAppend(toList(insertNat(Y, W, nil_1)), toList(branch(nil_1, X, Z, nil_1)))
= { by lemma 66 }
  toList(branch(insertNat(Y, W, nil_1), X, Z, nil_1))
= { by axiom 38 (insertNat_case1_1) R->L }
  toList(insertNat_case1(true, Y, X, nil_1, nil_1, W, Z))

Lemma 69: insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z) = insertNat(zero, Y, insertNat(suc(X), Z, nil_1)).
Proof:
  insertNat_case1(true, zero, suc(X), nil_1, nil_1, Y, Z)
= { by lemma 67 R->L }
  insertNat(zero, Y, branch(nil_1, suc(X), Z, nil_1))
= { by lemma 58 }
  insertNat(zero, Y, insertNat(suc(X), Z, nil_1))

Lemma 70: insertNat_case1_case1(true, suc(X), zero, Y, Z, W, V) = insertNat_case1(false, suc(X), zero, Y, Z, W, V).
Proof:
  insertNat_case1_case1(true, suc(X), zero, Y, Z, W, V)
= { by axiom 5 (isGT_3) R->L }
  insertNat_case1_case1(isGT(gt), suc(X), zero, Y, Z, W, V)
= { by axiom 13 (compareNat_3) R->L }
  insertNat_case1_case1(isGT(compareNat(suc(X), zero)), suc(X), zero, Y, Z, W, V)
= { by axiom 22 (gtNat_1) R->L }
  insertNat_case1_case1(gtNat(suc(X), zero), suc(X), zero, Y, Z, W, V)
= { by axiom 42 (insertNat_case1_2) R->L }
  insertNat_case1(false, suc(X), zero, Y, Z, W, V)

Lemma 71: toList(branch(nil_1, X, Y, branch(nil_1, Z, W, V))) = toList(insertNat_case1(true, X, Z, nil_1, V, Y, W)).
Proof:
  toList(branch(nil_1, X, Y, branch(nil_1, Z, W, V)))
= { by lemma 57 R->L }
  cons(pair(X, Y), toList(branch(nil_1, Z, W, V)))
= { by lemma 57 R->L }
  cons(pair(X, Y), cons(pair(Z, W), toList(V)))
= { by lemma 56 R->L }
  cons(pair(X, Y), opAppend(cons(pair(Z, W), nil), toList(V)))
= { by lemma 63 R->L }
  opAppend(toList(insertNat(X, Y, nil_1)), opAppend(cons(pair(Z, W), nil), toList(V)))
= { by axiom 43 (toList_2) R->L }
  toList(branch(insertNat(X, Y, nil_1), Z, W, V))
= { by axiom 38 (insertNat_case1_1) R->L }
  toList(insertNat_case1(true, X, Z, nil_1, V, Y, W))

Lemma 72: tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1)))) = insertNat(zero, X, insertNat(suc(Y), Z, nil_1)).
Proof:
  tree(toList(insertNat(zero, X, insertNat(suc(Y), Z, nil_1))))
= { by lemma 69 R->L }
  tree(toList(insertNat_case1(true, zero, suc(Y), nil_1, nil_1, X, Z)))
= { by lemma 71 R->L }
  tree(toList(branch(nil_1, zero, X, branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 64 }
  insertNat(zero, X, tree(toList(branch(nil_1, suc(Y), Z, nil_1))))
= { by lemma 64 }
  insertNat(zero, X, insertNat(suc(Y), Z, tree(toList(nil_1))))
= { by lemma 49 }
  insertNat(zero, X, insertNat(suc(Y), Z, tree(nil)))
= { by lemma 48 }
