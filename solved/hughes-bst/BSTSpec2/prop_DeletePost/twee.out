1013. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (join_1): join(leaf, X) = X.
Axiom 5 (eqNat_1): eqNat(zero, zero) = true.
Axiom 6 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 7 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 8 (fst_1): fst(pair(X, Y)) = X.
Axiom 9 (snd_1): snd(pair(X, Y)) = Y.
Axiom 10 (prop_DeletePost_case1_case1_1): prop_DeletePost_case1_case1(true, X, Y) = nothing.
Axiom 11 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 12 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 13 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 14 (eqMaybeNat_3): eqMaybeNat(just(X), nothing) = false.
Axiom 15 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 16 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 17 (findNat_case1_case1_2): findNat_case1_case1(false, X, Y, Z) = just(Z).
Axiom 18 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 19 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 20 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 21 (prop_DeletePost_case1_1): prop_DeletePost_case1(X, Y, Z) = prop_DeletePost_case1_case1(eqNat(X, Y), Y, Z).
Axiom 22 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 23 (findNat_case1_2): findNat_case1(false, X, Y, Z, W, V) = findNat_case1_case1(gtNat(X, Y), X, W, V).
Axiom 24 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 25 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 26 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 27 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 28 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 29 (findNat_2): findNat(X, branch(Y, Z, W, V)) = findNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 30 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 31 (prop_DeletePost_1): prop_DeletePost(X, Y, Z) = eqMaybeNat(findNat(Z, deleteNat(X, tree(Y))), prop_DeletePost_case1(X, Z, Y)).

Lemma 32: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 11 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 6 (compareNat_1) }
  isLT(eq)
= { by axiom 2 (isLT_2) }
  false

Lemma 33: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 12 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 6 (compareNat_1) }
  isGT(eq)
= { by axiom 3 (isGT_2) }
  false

Lemma 34: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 24 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 7 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 16 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 8 (fst_1) }
  insertNat_2(X, snd(pair(X, Y)))
= { by axiom 9 (snd_1) }
  insertNat_2(X, Y)

Lemma 35: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 9 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 8 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 24 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 36: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 20 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 37: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 35 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 15 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 38: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 35 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 18 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 25 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 18 (tree_1) R->L }
  tree(cons(X, Y))

Goal 1 (prop_DeletePost): prop_DeletePost(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = cons(pair(zero, X), cons(pair(zero, Y), nil))
  Z = zero

Proof:
  prop_DeletePost(zero, cons(pair(zero, X), cons(pair(zero, Y), nil)), zero)
= { by axiom 31 (prop_DeletePost_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, tree(cons(pair(zero, X), cons(pair(zero, Y), nil))))), prop_DeletePost_case1(zero, zero, cons(pair(zero, X), cons(pair(zero, Y), nil))))
= { by axiom 21 (prop_DeletePost_case1_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, tree(cons(pair(zero, X), cons(pair(zero, Y), nil))))), prop_DeletePost_case1_case1(eqNat(zero, zero), zero, cons(pair(zero, X), cons(pair(zero, Y), nil))))
= { by axiom 5 (eqNat_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, tree(cons(pair(zero, X), cons(pair(zero, Y), nil))))), prop_DeletePost_case1_case1(true, zero, cons(pair(zero, X), cons(pair(zero, Y), nil))))
= { by axiom 10 (prop_DeletePost_case1_case1_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, tree(cons(pair(zero, X), cons(pair(zero, Y), nil))))), nothing)
= { by lemma 38 R->L }
  eqMaybeNat(findNat(zero, deleteNat(zero, uncurry(uncurry_1(insertNat_0), pair(pair(zero, X), tree(cons(pair(zero, Y), nil)))))), nothing)
= { by lemma 37 }
  eqMaybeNat(findNat(zero, deleteNat(zero, app(uncurry(insertNat_0, pair(zero, X)), tree(cons(pair(zero, Y), nil))))), nothing)
= { by lemma 34 }
  eqMaybeNat(findNat(zero, deleteNat(zero, app(insertNat_2(zero, X), tree(cons(pair(zero, Y), nil))))), nothing)
= { by axiom 19 (app_insertNat_2_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, tree(cons(pair(zero, Y), nil))))), nothing)
= { by lemma 38 R->L }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), tree(nil)))))), nothing)
= { by axiom 18 (tree_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))))), nothing)
= { by axiom 13 (foldr_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), nil_1))))), nothing)
= { by lemma 37 }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, app(uncurry(insertNat_0, pair(zero, Y)), nil_1)))), nothing)
= { by lemma 34 }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, app(insertNat_2(zero, Y), nil_1)))), nothing)
= { by axiom 19 (app_insertNat_2_1) }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, insertNat(zero, Y, nil_1)))), nothing)
= { by lemma 36 R->L }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat(zero, X, branch(nil_1, zero, Y, nil_1)))), nothing)
= { by axiom 30 (insertNat_2) }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X, Y))), nothing)
= { by lemma 32 }
  eqMaybeNat(findNat(zero, deleteNat(zero, insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y))), nothing)
= { by axiom 26 (insertNat_case1_2) }
  eqMaybeNat(findNat(zero, deleteNat(zero, branch(nil_1, zero, Y, insertNat(zero, X, nil_1)))), nothing)
= { by axiom 27 (deleteNat_2) }
  eqMaybeNat(findNat(zero, deleteNat_case1(ltNat(zero, zero), zero, zero, nil_1, insertNat(zero, X, nil_1), Y)), nothing)
= { by lemma 32 }
  eqMaybeNat(findNat(zero, deleteNat_case1(false, zero, zero, nil_1, insertNat(zero, X, nil_1), Y)), nothing)
= { by axiom 28 (deleteNat_case1_2) }
  eqMaybeNat(findNat(zero, deleteNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, insertNat(zero, X, nil_1), Y)), nothing)
= { by lemma 33 }
  eqMaybeNat(findNat(zero, deleteNat_case1_case1(false, zero, zero, nil_1, insertNat(zero, X, nil_1), Y)), nothing)
= { by axiom 22 (deleteNat_case1_case1_2) }
  eqMaybeNat(findNat(zero, join(nil_1, insertNat(zero, X, nil_1))), nothing)
= { by axiom 1 (nil_1_1) }
  eqMaybeNat(findNat(zero, join(leaf, insertNat(zero, X, nil_1))), nothing)
= { by axiom 4 (join_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, X, nil_1)), nothing)
= { by lemma 36 R->L }
  eqMaybeNat(findNat(zero, branch(nil_1, zero, X, nil_1)), nothing)
= { by axiom 29 (findNat_2) }
  eqMaybeNat(findNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X), nothing)
= { by lemma 32 }
  eqMaybeNat(findNat_case1(false, zero, zero, nil_1, nil_1, X), nothing)
= { by axiom 23 (findNat_case1_2) }
  eqMaybeNat(findNat_case1_case1(gtNat(zero, zero), zero, nil_1, X), nothing)
= { by lemma 33 }
  eqMaybeNat(findNat_case1_case1(false, zero, nil_1, X), nothing)
= { by axiom 17 (findNat_case1_case1_2) }
  eqMaybeNat(just(X), nothing)
= { by axiom 14 (eqMaybeNat_3) }
  false

RESULT: Theorem (the conjecture is true).
