186. app(uncurry(insertNat_1(X), Y), foldr(insertNat_2(X, fst(Y)), Z, W)) -> foldr(insertNat_2(X, fst(Y)), Z, cons(snd(Y), W))
187. app(foldr(X, Y, cons(Z, W)), foldr(app(X, Z), V, U)) -> foldr(app(X, Z), V, cons(foldr(X, Y, W), U))
188. uncurry(uncurry(X, Y), pair(Z, foldr(uncurry_1(uncurry_1(X)), W, V))) -> foldr(uncurry_1(uncurry_1(X)), W, cons(pair(Y, Z), V))
189. foldr(X, uncurry(X, pair(Y, Z)), cons(W, cons(V, nil))) -> foldr(X, Z, cons(W, cons(V, cons(Y, nil))))
190. insertNat_case1(false, zero, zero, nil_1, insertNat(zero, X, nil_1), Y, Z) -> insertNat(zero, Y, insertNat(zero, X, insertNat(zero, Z, nil_1)))
191. findNat(zero, insertNat(zero, X, insertNat(zero, Y, insertNat(zero, Z, nil_1)))) -> just(Z)
192. insertNat_case1(true, suc(zero), suc(suc(X)), nil_1, nil_1, Y, Z) -> insertNat(suc(zero), Y, insertNat(suc(suc(X)), Z, nil_1))
193. findNat(zero, insertNat(suc(zero), X, insertNat(suc(suc(Y)), Z, nil_1))) -> nothing
194. insertNat_case1(false, suc(suc(X)), suc(zero), nil_1, nil_1, Y, Z) -> insertNat(suc(suc(X)), Y, insertNat(suc(zero), Z, nil_1))
195. findNat(zero, insertNat(suc(suc(X)), Y, insertNat(suc(zero), Z, nil_1))) -> nothing
196. findNat(suc(zero), insertNat(suc(suc(X)), Y, insertNat(suc(zero), Z, nil_1))) -> just(Z)
197. eqMaybeNat(findNat(X, insertNat(X, Y, insertNat(Z, W, nil_1))), just(Y)) -> prop_FindPostPresent(X, Y, cons(pair(Z, W), nil))
198. prop_FindPostPresent(zero, X, cons(pair(zero, Y), nil)) -> eqNat(Y, X)
199. equals(eqNat(X, Y), false) -> false
200. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 5 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 6 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 7 (fst_1): fst(pair(X, Y)) = X.
Axiom 8 (snd_1): snd(pair(X, Y)) = Y.
Axiom 9 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 10 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 11 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 12 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 13 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 14 (findNat_case1_case1_2): findNat_case1_case1(false, X, Y, Z) = just(Z).
Axiom 15 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 16 (eqMaybeNat_4): eqMaybeNat(just(X), just(Y)) = eqNat(X, Y).
Axiom 17 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 18 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 19 (findNat_case1_2): findNat_case1(false, X, Y, Z, W, V) = findNat_case1_case1(gtNat(X, Y), X, W, V).
Axiom 20 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 21 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 22 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 23 (findNat_2): findNat(X, branch(Y, Z, W, V)) = findNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 24 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 25 (prop_FindPostPresent_1): prop_FindPostPresent(X, Y, Z) = eqMaybeNat(findNat(X, insertNat(X, Y, tree(Z))), just(Y)).

Lemma 26: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 9 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 5 (compareNat_1) }
  isLT(eq)
= { by axiom 2 (isLT_2) }
  false

Lemma 27: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 8 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 7 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 20 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Goal 1 (prop_FindPostPresent): prop_FindPostPresent(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = suc(X)
  Z = cons(pair(zero, zero), nil)

Proof:
  prop_FindPostPresent(zero, suc(X), cons(pair(zero, zero), nil))
= { by axiom 25 (prop_FindPostPresent_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), tree(cons(pair(zero, zero), nil)))), just(suc(X)))
= { by axiom 15 (tree_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), foldr(uncurry_1(insertNat_0), nil_1, cons(pair(zero, zero), nil)))), just(suc(X)))
= { by axiom 22 (foldr_2) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(app(uncurry_1(insertNat_0), pair(zero, zero)), foldr(uncurry_1(insertNat_0), nil_1, nil)))), just(suc(X)))
= { by axiom 15 (tree_1) R->L }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(app(uncurry_1(insertNat_0), pair(zero, zero)), tree(nil)))), just(suc(X)))
= { by lemma 27 }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), uncurry(uncurry_1(insertNat_0), pair(pair(zero, zero), tree(nil))))), just(suc(X)))
= { by axiom 15 (tree_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), uncurry(uncurry_1(insertNat_0), pair(pair(zero, zero), foldr(uncurry_1(insertNat_0), nil_1, nil))))), just(suc(X)))
= { by axiom 11 (foldr_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), uncurry(uncurry_1(insertNat_0), pair(pair(zero, zero), nil_1)))), just(suc(X)))
= { by lemma 27 R->L }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(app(uncurry_1(insertNat_0), pair(zero, zero)), nil_1))), just(suc(X)))
= { by axiom 12 (app_uncurry_1_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(uncurry(insertNat_0, pair(zero, zero)), nil_1))), just(suc(X)))
= { by axiom 20 (uncurry_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(app(app(insertNat_0, fst(pair(zero, zero))), snd(pair(zero, zero))), nil_1))), just(suc(X)))
= { by axiom 6 (app_insertNat_0_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(app(insertNat_1(fst(pair(zero, zero))), snd(pair(zero, zero))), nil_1))), just(suc(X)))
= { by axiom 13 (app_insertNat_1_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(insertNat_2(fst(pair(zero, zero)), snd(pair(zero, zero))), nil_1))), just(suc(X)))
= { by axiom 7 (fst_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(insertNat_2(zero, snd(pair(zero, zero))), nil_1))), just(suc(X)))
= { by axiom 8 (snd_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), app(insertNat_2(zero, zero), nil_1))), just(suc(X)))
= { by axiom 18 (app_insertNat_2_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), insertNat(zero, zero, nil_1))), just(suc(X)))
= { by axiom 1 (nil_1_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), insertNat(zero, zero, leaf))), just(suc(X)))
= { by axiom 17 (insertNat_1) }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), branch(leaf, zero, zero, leaf))), just(suc(X)))
= { by axiom 1 (nil_1_1) R->L }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), branch(leaf, zero, zero, nil_1))), just(suc(X)))
= { by axiom 1 (nil_1_1) R->L }
  eqMaybeNat(findNat(zero, insertNat(zero, suc(X), branch(nil_1, zero, zero, nil_1))), just(suc(X)))
= { by axiom 24 (insertNat_2) }
  eqMaybeNat(findNat(zero, insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, suc(X), zero)), just(suc(X)))
= { by lemma 26 }
  eqMaybeNat(findNat(zero, insertNat_case1(false, zero, zero, nil_1, nil_1, suc(X), zero)), just(suc(X)))
= { by axiom 21 (insertNat_case1_2) }
  eqMaybeNat(findNat(zero, branch(nil_1, zero, zero, insertNat(zero, suc(X), nil_1))), just(suc(X)))
= { by axiom 23 (findNat_2) }
  eqMaybeNat(findNat_case1(ltNat(zero, zero), zero, zero, nil_1, insertNat(zero, suc(X), nil_1), zero), just(suc(X)))
= { by lemma 26 }
  eqMaybeNat(findNat_case1(false, zero, zero, nil_1, insertNat(zero, suc(X), nil_1), zero), just(suc(X)))
= { by axiom 19 (findNat_case1_2) }
  eqMaybeNat(findNat_case1_case1(gtNat(zero, zero), zero, insertNat(zero, suc(X), nil_1), zero), just(suc(X)))
= { by axiom 10 (gtNat_1) }
  eqMaybeNat(findNat_case1_case1(isGT(compareNat(zero, zero)), zero, insertNat(zero, suc(X), nil_1), zero), just(suc(X)))
= { by axiom 5 (compareNat_1) }
  eqMaybeNat(findNat_case1_case1(isGT(eq), zero, insertNat(zero, suc(X), nil_1), zero), just(suc(X)))
= { by axiom 3 (isGT_2) }
  eqMaybeNat(findNat_case1_case1(false, zero, insertNat(zero, suc(X), nil_1), zero), just(suc(X)))
= { by axiom 14 (findNat_case1_case1_2) }
  eqMaybeNat(just(zero), just(suc(X)))
= { by axiom 16 (eqMaybeNat_4) }
  eqNat(zero, suc(X))
= { by axiom 4 (eqNat_2) }
  false

RESULT: Theorem (the conjecture is true).
