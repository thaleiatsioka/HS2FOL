5525. deleteNat(suc(suc(suc(zero))), unionNat(branch(X, suc(suc(suc(zero))), Y, Z), insertNat(zero, W, nil_1))) -> join(unionNat(X, insertNat(zero, W, nil_1)), unionNat(Z, nil_1))
5526. opEqTildeEqNatNat(nil_1, join(app(foldr(insertNat_0, X, opAppend(toList(tree(cons(Y, nil))), Z)), nil_1), nil_1)) -> false
5527. opEqTildeEqNatNat(join(app(foldr(insertNat_0, X, opAppend(toList(tree(cons(Y, nil))), Z)), nil_1), nil_1), nil_1) -> false
5528. opEqTildeEqNatNat(nil_1, unionNat(app(foldr(insertNat_0, X, opAppend(toList(tree(cons(Y, nil))), Z)), nil_1), nil_1)) -> false
5529. opEqTildeEqNatNat(unionNat(app(foldr(insertNat_0, X, opAppend(toList(tree(cons(Y, nil))), Z)), nil_1), nil_1), nil_1) -> false
5530. opEqTildeEqNatNat(nil_1, tree(toList(app(foldr(insertNat_0, X, opAppend(toList(tree(cons(Y, nil))), Z)), nil_1)))) -> false
5531. opEqTildeEqNatNat(tree(toList(app(foldr(insertNat_0, X, opAppend(toList(tree(cons(Y, nil))), Z)), nil_1))), nil_1) -> false
5532. unionNat(insertNat(suc(zero), X, insertNat(zero, Y, nil_1)), branch(nil_1, suc(zero), Z, W)) -> branch(nil_1, zero, Y, branch(nil_1, suc(zero), X, aboveNat(suc(zero), W)))
5533. belowNat(suc(zero), join(insertNat(suc(suc(zero)), X, insertNat(suc(suc(zero)), Y, nil_1)), tree(cons(Z, nil)))) -> nil_1
5534. belowNat(suc(suc(zero)), join(insertNat(suc(suc(zero)), X, insertNat(suc(suc(zero)), Y, nil_1)), tree(cons(Z, nil)))) -> nil_1
5535. uncurry(app(uncurry(X, Y), Z), pair(foldr(uncurry_1(app(X, fst(Y))), W, V), U)) -> app(foldr(uncurry_1(app(X, fst(Y))), W, cons(pair(snd(Y), Z), V)), U)
5536. app(insertNat(zero, X, Y), app(insertNat_case1(true, zero, suc(Z), W, V, X, U), T)) -> foldr(insertNat_2(zero, X), T, cons(Y, cons(branch(W, suc(Z), U, V), nil)))
5537. app(insertNat(suc(X), Y, Z), app(insertNat_case1(false, suc(X), zero, W, V, Y, U), T)) -> foldr(insertNat_2(suc(X), Y), T, cons(Z, cons(branch(W, zero, U, V), nil)))
5538. deleteNat(suc(zero), join(deleteNat_case1_case1(true, X, suc(zero), Y, Z, W), branch(V, U, T, S))) -> join(Y, branch(join(deleteNat(X, Z), V), U, T, S))
5539. deleteNat(suc(zero), join(belowNat_case1(false, X, suc(zero), Y, Z, W), branch(V, U, T, S))) -> join(Y, branch(join(belowNat(X, Z), V), U, T, S))
5540. deleteNat(suc(zero), join(branch(X, suc(zero), Y, Z), deleteNat_case1(true, W, V, U, T, S))) -> join(X, branch(join(Z, deleteNat(W, U)), V, S, T))
5541. deleteNat(suc(zero), join(branch(X, suc(zero), Y, Z), aboveNat_case1(false, W, V, U, T, S))) -> join(X, branch(join(Z, aboveNat(W, U)), V, S, T))
5542. opEqTildeEqNatNat(unionNat(deleteNat(X, insertNat(Y, Z, nil_1)), insertNat(X, W, nil_1)), insertNat(X, W, insertNat(Y, Z, nil_1))) -> prop_UnionDeleteInsert(toList(insertNat(Y, Z, nil_1)), nil, pair(X, W))
5543. prop_UnionDeleteInsert(toList(insertNat(zero, X, nil_1)), nil, pair(zero, Y)) -> opAnd(eqNat(Y, X), false)
5544. equals(opAnd(eqNat(X, Y), false), false) -> false
5545. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isLT_3): isLT(gt) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (isGT_3): isGT(gt) = true.
Axiom 6 (toList_1): toList(leaf) = nil.
Axiom 7 (opAnd_2): opAnd(true, X) = X.
Axiom 8 (opAppend_1): opAppend(nil, X) = X.
Axiom 9 (deleteNat_1): deleteNat(X, leaf) = leaf.
Axiom 10 (join_1): join(leaf, X) = X.
Axiom 11 (unionNat_1): unionNat(leaf, X) = X.
Axiom 12 (eqNat_1): eqNat(zero, zero) = true.
Axiom 13 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 14 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 15 (compareNat_3): compareNat(suc(X), zero) = gt.
Axiom 16 (fst_1): fst(pair(X, Y)) = X.
Axiom 17 (snd_1): snd(pair(X, Y)) = Y.
Axiom 18 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 19 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 20 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 21 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 22 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 23 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 24 (eqListPairNatNat_2): eqListPairNatNat(nil, cons(X, Y)) = false.
Axiom 25 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 26 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 27 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 28 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 29 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 30 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 31 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 32 (unionNat_2): unionNat(branch(X, Y, Z, W), leaf) = branch(X, Y, Z, W).
Axiom 33 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 34 (deleteNat_case1_case1_1): deleteNat_case1_case1(true, X, Y, Z, W, V) = branch(Z, Y, V, deleteNat(X, W)).
Axiom 35 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 36 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 37 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 38 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 39 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 40 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 41 (prop_UnionDeleteInsert_1): prop_UnionDeleteInsert(X, Y, pair(Z, W)) = opEqTildeEqNatNat(unionNat(deleteNat(Z, tree(X)), insertNat(Z, W, tree(Y))), insertNat(Z, W, unionNat(tree(X), tree(Y)))).

Lemma 42: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 23 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 18 (foldr_1) }
  nil_1

Lemma 43: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 6 (toList_1) }
  nil

Lemma 44: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 19 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 14 (compareNat_1) }
  isLT(eq)
= { by axiom 2 (isLT_2) }
  false

Lemma 45: eqListPairNatNat(nil, toList(X)) = opEqTildeEqNatNat(nil_1, X).
Proof:
  eqListPairNatNat(nil, toList(X))
= { by lemma 43 R->L }
  eqListPairNatNat(toList(nil_1), toList(X))
= { by axiom 25 (opEqTildeEqNatNat_1) R->L }
  opEqTildeEqNatNat(nil_1, X)

Lemma 46: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 17 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 16 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 33 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 47: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by axiom 8 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(Z)))
= { by axiom 27 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 8 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 43 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 40 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 48: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 28 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 49: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 43 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 47 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 48 }
  toList(insertNat(X, Y, nil_1))

Lemma 50: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 49 R->L }
  tree(cons(pair(X, Y), nil))
= { by axiom 23 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 35 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 23 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 46 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 42 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 46 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 21 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 33 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 13 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 22 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 16 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 17 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 26 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 51: deleteNat(suc(X), insertNat(zero, Y, nil_1)) = insertNat(zero, Y, nil_1).
Proof:
  deleteNat(suc(X), insertNat(zero, Y, nil_1))
= { by lemma 48 R->L }
  deleteNat(suc(X), branch(nil_1, zero, Y, nil_1))
= { by axiom 37 (deleteNat_2) }
  deleteNat_case1(ltNat(suc(X), zero), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 19 (ltNat_1) }
  deleteNat_case1(isLT(compareNat(suc(X), zero)), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 15 (compareNat_3) }
  deleteNat_case1(isLT(gt), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 3 (isLT_3) }
  deleteNat_case1(false, suc(X), zero, nil_1, nil_1, Y)
= { by axiom 38 (deleteNat_case1_2) }
  deleteNat_case1_case1(gtNat(suc(X), zero), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 20 (gtNat_1) }
  deleteNat_case1_case1(isGT(compareNat(suc(X), zero)), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 15 (compareNat_3) }
  deleteNat_case1_case1(isGT(gt), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 5 (isGT_3) }
  deleteNat_case1_case1(true, suc(X), zero, nil_1, nil_1, Y)
= { by axiom 34 (deleteNat_case1_case1_1) }
  branch(nil_1, zero, Y, deleteNat(suc(X), nil_1))
= { by axiom 1 (nil_1_1) }
  branch(nil_1, zero, Y, deleteNat(suc(X), leaf))
= { by axiom 9 (deleteNat_1) }
  branch(nil_1, zero, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  branch(nil_1, zero, Y, nil_1)
= { by lemma 48 }
  insertNat(zero, Y, nil_1)

Goal 1 (prop_UnionDeleteInsert): prop_UnionDeleteInsert(X, Y, Z) = false.
The goal is true when:
  X = toList(insertNat(zero, zero, nil_1))
  Y = nil
  Z = pair(zero, zero)

Proof:
  prop_UnionDeleteInsert(toList(insertNat(zero, zero, nil_1)), nil, pair(zero, zero))
= { by axiom 41 (prop_UnionDeleteInsert_1) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, zero, nil_1)))), insertNat(zero, zero, tree(nil))), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, zero, nil_1))), tree(nil))))
= { by lemma 42 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, zero, nil_1)))), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, zero, nil_1))), tree(nil))))
= { by lemma 42 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, zero, nil_1)))), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, zero, nil_1))), nil_1)))
= { by lemma 50 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, zero, nil_1))), nil_1)))
= { by lemma 50 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(insertNat(zero, zero, nil_1), nil_1)))
= { by lemma 48 R->L }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(branch(nil_1, zero, zero, nil_1), nil_1)))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(branch(nil_1, zero, zero, nil_1), leaf)))
= { by axiom 32 (unionNat_2) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, branch(nil_1, zero, zero, nil_1)))
= { by lemma 48 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, zero, nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by lemma 48 R->L }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, branch(nil_1, zero, zero, nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 37 (deleteNat_2) }
  opEqTildeEqNatNat(unionNat(deleteNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, zero), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by lemma 44 }
  opEqTildeEqNatNat(unionNat(deleteNat_case1(false, zero, zero, nil_1, nil_1, zero), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 38 (deleteNat_case1_2) }
  opEqTildeEqNatNat(unionNat(deleteNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, nil_1, zero), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 20 (gtNat_1) }
  opEqTildeEqNatNat(unionNat(deleteNat_case1_case1(isGT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, zero), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 14 (compareNat_1) }
  opEqTildeEqNatNat(unionNat(deleteNat_case1_case1(isGT(eq), zero, zero, nil_1, nil_1, zero), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 4 (isGT_2) }
  opEqTildeEqNatNat(unionNat(deleteNat_case1_case1(false, zero, zero, nil_1, nil_1, zero), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 29 (deleteNat_case1_case1_2) }
  opEqTildeEqNatNat(unionNat(join(nil_1, nil_1), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(unionNat(join(leaf, nil_1), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 10 (join_1) }
  opEqTildeEqNatNat(unionNat(nil_1, insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(unionNat(leaf, insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 11 (unionNat_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat(zero, zero, insertNat(zero, zero, nil_1)))
= { by axiom 25 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(insertNat(zero, zero, insertNat(zero, zero, nil_1))))
= { by lemma 48 R->L }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(insertNat(zero, zero, branch(nil_1, zero, zero, nil_1))))
= { by axiom 39 (insertNat_2) }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, zero, zero)))
= { by lemma 44 }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(insertNat_case1(false, zero, zero, nil_1, nil_1, zero, zero)))
= { by axiom 25 (opEqTildeEqNatNat_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat_case1(false, zero, zero, nil_1, nil_1, zero, zero))
= { by axiom 36 (insertNat_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(nil_1, zero, zero, insertNat(zero, zero, nil_1)))
= { by lemma 51 R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(nil_1, zero, zero, deleteNat(suc(X), insertNat(zero, zero, nil_1))))
= { by axiom 25 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(branch(nil_1, zero, zero, deleteNat(suc(X), insertNat(zero, zero, nil_1)))))
= { by lemma 49 R->L }
  eqListPairNatNat(cons(pair(zero, zero), nil), toList(branch(nil_1, zero, zero, deleteNat(suc(X), insertNat(zero, zero, nil_1)))))
= { by lemma 47 R->L }
  eqListPairNatNat(cons(pair(zero, zero), nil), cons(pair(zero, zero), toList(deleteNat(suc(X), insertNat(zero, zero, nil_1)))))
= { by axiom 31 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, zero)), eqListPairNatNat(nil, toList(deleteNat(suc(X), insertNat(zero, zero, nil_1)))))
= { by lemma 45 }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, zero)), opEqTildeEqNatNat(nil_1, deleteNat(suc(X), insertNat(zero, zero, nil_1))))
= { by axiom 30 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(zero, zero), eqNat(zero, zero)), opEqTildeEqNatNat(nil_1, deleteNat(suc(X), insertNat(zero, zero, nil_1))))
= { by axiom 12 (eqNat_1) }
  opAnd(opAnd(true, eqNat(zero, zero)), opEqTildeEqNatNat(nil_1, deleteNat(suc(X), insertNat(zero, zero, nil_1))))
= { by axiom 7 (opAnd_2) }
  opAnd(eqNat(zero, zero), opEqTildeEqNatNat(nil_1, deleteNat(suc(X), insertNat(zero, zero, nil_1))))
= { by lemma 51 }
  opAnd(eqNat(zero, zero), opEqTildeEqNatNat(nil_1, insertNat(zero, zero, nil_1)))
= { by lemma 45 R->L }
  opAnd(eqNat(zero, zero), eqListPairNatNat(nil, toList(insertNat(zero, zero, nil_1))))
= { by lemma 49 R->L }
  opAnd(eqNat(zero, zero), eqListPairNatNat(nil, cons(pair(zero, zero), nil)))
= { by axiom 24 (eqListPairNatNat_2) }
  opAnd(eqNat(zero, zero), false)
= { by axiom 12 (eqNat_1) }
  opAnd(true, false)
= { by axiom 7 (opAnd_2) }
  false

RESULT: Theorem (the conjecture is true).
