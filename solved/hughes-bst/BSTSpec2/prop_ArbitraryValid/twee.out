403. opAnd(foldr(lam4(zero), X, cons(zero, Y)), true) -> all(false, cons(foldr(lam4(zero), X, Y), nil))
404. cons(foldr(lam4(zero), X, cons(zero, Y)), nil) -> map(false, cons(foldr(lam4(zero), X, Y), nil))
405. opAnd(foldr(lam5(zero), X, cons(zero, Y)), true) -> all(false, cons(foldr(lam5(zero), X, Y), nil))
406. cons(foldr(lam5(zero), X, cons(zero, Y)), nil) -> map(false, cons(foldr(lam5(zero), X, Y), nil))
407. app(ltNat(X, Y), foldr(lam4(suc(Y)), Z, W)) -> foldr(lam4(suc(Y)), Z, cons(suc(X), W))
408. foldr(lam4(suc(zero)), X, cons(suc(zero), Y)) -> app(false, foldr(lam4(suc(zero)), X, Y))
409. app(gtNat(X, Y), foldr(lam5(suc(Y)), Z, W)) -> foldr(lam5(suc(Y)), Z, cons(suc(X), W))
410. foldr(lam5(suc(zero)), X, cons(suc(zero), Y)) -> foldr(lam5(suc(zero)), X, cons(zero, Y))
411. map(lam5(zero), cons(X, cons(suc(Y), nil))) -> cons(gtNat(X, zero), cons(true, nil))
412. all(insertNat_0, map(X, map(Y, cons(Z, nil)))) -> opAnd(insertNat_1(app(X, app(Y, Z))), true)
413. opAnd(insertNat_1(app(X, pair(Y, Z))), true) -> all(insertNat_0, map(X, toList(insertNat(Y, Z, nil_1))))
414. all(fst_0, map(X, map(Y, cons(Z, nil)))) -> opAnd(fst(app(X, app(Y, Z))), true)
415. opAnd(fst(app(X, pair(Y, Z))), true) -> all(fst_0, map(X, toList(insertNat(Y, Z, nil_1))))
416. map(insertNat_0, map(X, map(Y, cons(Z, nil)))) -> cons(insertNat_1(app(X, app(Y, Z))), nil)
417. cons(insertNat_1(app(X, pair(Y, Z))), nil) -> map(insertNat_0, map(X, toList(insertNat(Y, Z, nil_1))))
418. map(fst_0, map(X, map(Y, cons(Z, nil)))) -> cons(fst(app(X, app(Y, Z))), nil)
419. cons(fst(app(X, pair(Y, Z))), nil) -> map(fst_0, map(X, toList(insertNat(Y, Z, nil_1))))
420. foldr(uncurry_1(insertNat_0), tree(X), cons(Y, cons(Z, nil))) -> tree(cons(Y, cons(Z, X)))
421. cons(app(X, Y), cons(app(X, Z), W)) -> opAppend(map(X, cons(Y, cons(Z, nil))), W)
422. app(uncurry(fst_0, X), foldr(fst(fst(X)), Y, Z)) -> foldr(fst(fst(X)), Y, cons(snd(X), Z))
423. foldr(insertNat_0, X, map(Y, map(Z, cons(W, nil)))) -> insertNat_2(app(Y, app(Z, W)), X)
424. foldr(insertNat_0, X, map(Y, toList(insertNat(Z, W, nil_1)))) -> insertNat_2(app(Y, pair(Z, W)), X)
425. toList(insertNat_case1(true, X, Y, nil_1, nil_1, Z, W)) -> cons(pair(X, Z), toList(insertNat(Y, W, nil_1)))
426. keys(insertNat_case1(true, X, Y, nil_1, nil_1, Z, W)) -> cons(X, cons(Y, nil))
427. foldr(X, snd(Y), cons(Z, cons(fst(Y), nil))) = uncurry(X, pair(Z, uncurry(X, Y)))
428. all(fst_0, toList(tree(map(X, cons(Y, nil))))) -> opAnd(fst(app(X, Y)), true)
429. cons(pair(zero, X), toList(insertNat(zero, Y, nil_1))) -> toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))
430. validNat(branch(nil_1, X, ?, tree(cons(Y, nil)))) -> opAnd(gtNat(fst(Y), X), true)
431. map(lam4(suc(X)), cons(Y, cons(zero, nil))) -> cons(ltNat(Y, suc(X)), cons(true, nil))
432. map(lam5(suc(X)), cons(Y, cons(zero, nil))) -> cons(gtNat(Y, suc(X)), cons(false, nil))
433. foldr(fst_0, X, opAppend(cons(pair(Y, Z), W), V)) -> app(Y, foldr(fst_0, X, opAppend(W, V)))
434. all(lam4(zero), opAppend(opAppend(cons(suc(X), Y), Z), W)) -> false
435. all(lam5(suc(X)), opAppend(opAppend(cons(zero, Y), Z), W)) -> false
436. cons(app(X, pair(fst(Y), snd(Y))), Z) -> opAppend(map(X, toList(tree(cons(Y, nil)))), Z)
437. insertNat_case1(false, fst(X), Y, Z, W, snd(X), V) -> branch(Z, Y, V, app(uncurry(insertNat_0, X), W))
438. insertNat_case1(true, fst(X), Y, Z, W, snd(X), V) -> branch(app(uncurry(insertNat_0, X), Z), Y, V, W)
439. validNat(branch(tree(cons(X, nil)), Y, ?, nil_1)) -> opAnd(opAnd(ltNat(fst(X), Y), true), true)
440. foldr(insertNat_0, X, map(insertNat_0, cons(Y, cons(Z, nil)))) -> insertNat_2(insertNat_1(Y), insertNat_2(insertNat_1(Z), X))
441. foldr(insertNat_0, X, map(fst_0, cons(Y, cons(Z, nil)))) -> insertNat_2(fst(Y), insertNat_2(fst(Z), X))
442. opAppend(map(X, cons(Y, cons(Z, nil))), nil) -> map(X, cons(Y, cons(Z, nil)))
443. opAnd(uncurry(X, pair(Y, Z)), all(app(X, Y), W)) -> all(app(X, Y), cons(Z, W))
444. cons(uncurry(X, pair(Y, Z)), map(app(X, Y), W)) -> map(app(X, Y), cons(Z, W))
445. foldr(lam4(zero), X, cons(Y, cons(suc(Z), nil))) -> app(ltNat(Y, zero), app(false, X))
446. foldr(lam5(zero), X, cons(Y, cons(suc(Z), nil))) -> app(gtNat(Y, zero), app(true, X))
447. all(lam4(zero), opAppend(cons(X, cons(zero, Y)), Z)) -> opAnd(ltNat(X, zero), false)
448. all(lam5(zero), opAppend(cons(X, cons(zero, Y)), Z)) -> opAnd(gtNat(X, zero), false)
449. app(uncurry(insertNat_0, X), insertNat(Y, Z, tree(W))) -> tree(cons(X, cons(pair(Y, Z), W)))
450. all(uncurry_1(insertNat_2(X, Y)), toList(insertNat(Z, W, nil_1))) -> all(insertNat(X, Y, Z), cons(W, nil))
451. map(uncurry_1(insertNat_2(X, Y)), toList(insertNat(Z, W, nil_1))) -> map(insertNat(X, Y, Z), cons(W, nil))
452. all(lam4(suc(zero)), opAppend(cons(suc(suc(X)), Y), Z)) -> false
453. insertNat_case1(false, X, Y, insertNat(Z, W, V), U, T, S) -> insertNat_case1(true, Z, Y, V, insertNat(X, T, U), W, S)
454. all(lam5(suc(suc(X))), opAppend(cons(suc(zero), Y), Z)) -> false
455. validNat(insertNat(zero, X, insertNat(suc(Y), Z, nil_1))) -> true
456. foldr(X, Y, map(Z, map(W, cons(V, nil)))) -> uncurry(X, pair(app(Z, app(W, V)), Y))
457. foldr(X, Y, map(Z, toList(insertNat(W, V, nil_1)))) -> uncurry(X, pair(app(Z, pair(W, V)), Y))
458. map(fst_0, cons(X, toList(tree(cons(Y, nil))))) -> map(fst_0, cons(X, cons(Y, nil)))
459. keys(tree(map(insertNat_0, toList(insertNat(X, Y, nil_1))))) -> cons(fst(insertNat_1(pair(X, Y))), nil)
460. all(fst_0, cons(X, toList(tree(cons(Y, nil))))) -> all(fst_0, cons(X, cons(Y, nil)))
461. map(lam4(suc(zero)), opAppend(cons(suc(zero), X), Y)) -> cons(false, map(lam4(suc(zero)), opAppend(X, Y)))
462. map(lam5(suc(zero)), opAppend(cons(suc(zero), X), Y)) -> map(lam5(suc(zero)), opAppend(cons(zero, X), Y))
463. map(lam5(suc(zero)), cons(X, cons(suc(zero), Y))) -> map(lam5(suc(zero)), cons(X, cons(zero, Y)))
464. tree(toList(insertNat(zero, X, insertNat(zero, Y, nil_1)))) -> insertNat(zero, Y, insertNat(zero, X, nil_1))
465. prop_ArbitraryValid(toList(insertNat(zero, X, insertNat(zero, Y, nil_1)))) -> false
466. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (toList_1): toList(leaf) = nil.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (validNat_1): validNat(leaf) = true.
Axiom 6 (map_1): map(X, nil) = nil.
Axiom 7 (keys_1): keys(X) = map(fst_0, toList(X)).
Axiom 8 (opAppend_1): opAppend(nil, X) = X.
Axiom 9 (all_1): all(X, nil) = true.
Axiom 10 (prop_ArbitraryValid_1): prop_ArbitraryValid(X) = validNat(tree(X)).
Axiom 11 (opAnd_2): opAnd(true, X) = X.
Axiom 12 (opAnd_1): opAnd(false, X) = false.
Axiom 13 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 14 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 15 (app_fst_0_1): app(fst_0, X) = fst(X).
Axiom 16 (snd_1): snd(pair(X, Y)) = Y.
Axiom 17 (fst_1): fst(pair(X, Y)) = X.
Axiom 18 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 19 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 20 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 21 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 22 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 23 (app_lam5_1): app(lam5(X), Y) = gtNat(Y, X).
Axiom 24 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 25 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 26 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 27 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 28 (all_2): all(X, cons(Y, Z)) = opAnd(app(X, Y), all(X, Z)).
Axiom 29 (map_2): map(X, cons(Y, Z)) = cons(app(X, Y), map(X, Z)).
Axiom 30 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 31 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 32 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 33 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 34 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 35 (validNat_2): validNat(branch(X, Y, Z, W)) = opAnd(validNat(X), opAnd(validNat(W), opAnd(all(lam4(Y), keys(X)), all(lam5(Y), keys(W))))).

Lemma 36: validNat(nil_1) = true.
Proof:
  validNat(nil_1)
= { by axiom 1 (nil_1_1) }
  validNat(leaf)
= { by axiom 5 (validNat_1) }
  true

Lemma 37: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 2 (toList_1) }
  nil

Lemma 38: keys(nil_1) = nil.
Proof:
  keys(nil_1)
= { by axiom 7 (keys_1) }
  map(fst_0, toList(nil_1))
= { by lemma 37 }
  map(fst_0, nil)
= { by axiom 6 (map_1) }
  nil

Lemma 39: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 30 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 14 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 22 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 16 (snd_1) }
  insertNat_2(fst(pair(X, Y)), Y)
= { by axiom 17 (fst_1) }
  insertNat_2(X, Y)

Lemma 40: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 17 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), Z)
= { by axiom 16 (snd_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 30 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 41: toList(branch(nil_1, X, Y, Z)) = cons(pair(X, Y), toList(Z)).
Proof:
  toList(branch(nil_1, X, Y, Z))
= { by axiom 33 (toList_2) }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 37 }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 8 (opAppend_1) }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 26 (opAppend_2) }
  cons(pair(X, Y), opAppend(nil, toList(Z)))
= { by axiom 8 (opAppend_1) }
  cons(pair(X, Y), toList(Z))

Lemma 42: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 25 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 43: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 37 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 41 R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 42 }
  toList(insertNat(X, Y, nil_1))

Lemma 44: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 40 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 21 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 45: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 40 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 24 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 32 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 24 (tree_1) R->L }
  tree(cons(X, Y))

Lemma 46: tree(cons(pair(X, Y), nil)) = insertNat(X, Y, nil_1).
Proof:
  tree(cons(pair(X, Y), nil))
= { by lemma 45 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 24 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 20 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 44 }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 39 }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 27 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 47: opAnd(validNat(X), all(lam5(Y), keys(X))) = validNat(branch(nil_1, Y, Z, X)).
Proof:
  opAnd(validNat(X), all(lam5(Y), keys(X)))
= { by axiom 11 (opAnd_2) R->L }
  opAnd(validNat(X), opAnd(true, all(lam5(Y), keys(X))))
= { by axiom 9 (all_1) R->L }
  opAnd(validNat(X), opAnd(all(lam4(Y), nil), all(lam5(Y), keys(X))))
= { by axiom 11 (opAnd_2) R->L }
  opAnd(true, opAnd(validNat(X), opAnd(all(lam4(Y), nil), all(lam5(Y), keys(X)))))
= { by lemma 36 R->L }
  opAnd(validNat(nil_1), opAnd(validNat(X), opAnd(all(lam4(Y), nil), all(lam5(Y), keys(X)))))
= { by lemma 38 R->L }
  opAnd(validNat(nil_1), opAnd(validNat(X), opAnd(all(lam4(Y), keys(nil_1)), all(lam5(Y), keys(X)))))
= { by axiom 35 (validNat_2) R->L }
  validNat(branch(nil_1, Y, Z, X))

Lemma 48: insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y) = insertNat(zero, X, insertNat(zero, Y, nil_1)).
Proof:
  insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y)
= { by axiom 3 (isLT_2) R->L }
  insertNat_case1(isLT(eq), zero, zero, nil_1, nil_1, X, Y)
= { by axiom 13 (compareNat_1) R->L }
  insertNat_case1(isLT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, X, Y)
= { by axiom 18 (ltNat_1) R->L }
  insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X, Y)
= { by axiom 34 (insertNat_2) R->L }
  insertNat(zero, X, branch(nil_1, zero, Y, nil_1))
= { by lemma 42 }
  insertNat(zero, X, insertNat(zero, Y, nil_1))

Goal 1 (prop_ArbitraryValid): prop_ArbitraryValid(X) = false.
The goal is true when:
  X = toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))

Proof:
  prop_ArbitraryValid(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))
= { by axiom 10 (prop_ArbitraryValid_1) }
  validNat(tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))
= { by lemma 48 R->L }
  validNat(tree(toList(insertNat_case1(false, zero, zero, nil_1, nil_1, Y, X))))
= { by axiom 31 (insertNat_case1_2) }
  validNat(tree(toList(branch(nil_1, zero, X, insertNat(zero, Y, nil_1)))))
= { by lemma 41 }
  validNat(tree(cons(pair(zero, X), toList(insertNat(zero, Y, nil_1)))))
= { by lemma 45 R->L }
  validNat(uncurry(uncurry_1(insertNat_0), pair(pair(zero, X), tree(toList(insertNat(zero, Y, nil_1))))))
= { by lemma 44 }
  validNat(app(uncurry(insertNat_0, pair(zero, X)), tree(toList(insertNat(zero, Y, nil_1)))))
= { by lemma 39 }
  validNat(app(insertNat_2(zero, X), tree(toList(insertNat(zero, Y, nil_1)))))
= { by axiom 27 (app_insertNat_2_1) }
  validNat(insertNat(zero, X, tree(toList(insertNat(zero, Y, nil_1)))))
= { by lemma 43 R->L }
  validNat(insertNat(zero, X, tree(cons(pair(zero, Y), nil))))
= { by lemma 46 }
  validNat(insertNat(zero, X, insertNat(zero, Y, nil_1)))
= { by lemma 48 R->L }
  validNat(insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y))
= { by axiom 31 (insertNat_case1_2) }
  validNat(branch(nil_1, zero, Y, insertNat(zero, X, nil_1)))
= { by lemma 46 R->L }
  validNat(branch(nil_1, zero, Y, tree(cons(pair(zero, X), nil))))
= { by lemma 47 R->L }
  opAnd(validNat(tree(cons(pair(zero, X), nil))), all(lam5(zero), keys(tree(cons(pair(zero, X), nil)))))
= { by axiom 10 (prop_ArbitraryValid_1) R->L }
  opAnd(prop_ArbitraryValid(cons(pair(zero, X), nil)), all(lam5(zero), keys(tree(cons(pair(zero, X), nil)))))
= { by lemma 46 }
  opAnd(prop_ArbitraryValid(cons(pair(zero, X), nil)), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by axiom 10 (prop_ArbitraryValid_1) }
  opAnd(validNat(tree(cons(pair(zero, X), nil))), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 46 }
  opAnd(validNat(insertNat(zero, X, nil_1)), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 42 R->L }
  opAnd(validNat(branch(nil_1, zero, X, nil_1)), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 47 R->L }
  opAnd(opAnd(validNat(nil_1), all(lam5(zero), keys(nil_1))), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 36 }
  opAnd(opAnd(true, all(lam5(zero), keys(nil_1))), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by axiom 11 (opAnd_2) }
  opAnd(all(lam5(zero), keys(nil_1)), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 38 }
  opAnd(all(lam5(zero), nil), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by axiom 9 (all_1) }
  opAnd(true, all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by axiom 11 (opAnd_2) }
  all(lam5(zero), keys(insertNat(zero, X, nil_1)))
= { by axiom 7 (keys_1) }
  all(lam5(zero), map(fst_0, toList(insertNat(zero, X, nil_1))))
= { by lemma 43 R->L }
  all(lam5(zero), map(fst_0, cons(pair(zero, X), nil)))
= { by axiom 29 (map_2) }
  all(lam5(zero), cons(app(fst_0, pair(zero, X)), map(fst_0, nil)))
= { by axiom 6 (map_1) }
  all(lam5(zero), cons(app(fst_0, pair(zero, X)), nil))
= { by axiom 15 (app_fst_0_1) }
  all(lam5(zero), cons(fst(pair(zero, X)), nil))
= { by axiom 17 (fst_1) }
  all(lam5(zero), cons(zero, nil))
= { by axiom 28 (all_2) }
  opAnd(app(lam5(zero), zero), all(lam5(zero), nil))
= { by axiom 9 (all_1) }
  opAnd(app(lam5(zero), zero), true)
= { by axiom 23 (app_lam5_1) }
  opAnd(gtNat(zero, zero), true)
= { by axiom 19 (gtNat_1) }
  opAnd(isGT(compareNat(zero, zero)), true)
= { by axiom 13 (compareNat_1) }
  opAnd(isGT(eq), true)
= { by axiom 4 (isGT_2) }
  opAnd(false, true)
= { by axiom 12 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
