7768. eqListPairNatNat(cons(pair(zero, X), Y), toList(join(branch(nil_1, suc(Z), W, V), tree(cons(U, nil))))) -> false
7769. eqListPairNatNat(cons(pair(suc(X), Y), Z), toList(join(branch(nil_1, zero, W, V), tree(cons(U, nil))))) -> false
7770. join(insertNat_case1(false, X, Y, Z, nil_1, W, V), insertNat(zero, U, insertNat(zero, T, nil_1))) -> insertNat_case1(false, zero, Y, Z, insertNat_case1(true, X, zero, nil_1, nil_1, W, T), U, V)
7771. opEqTildeEqNatNat(deleteNat(X, unionNat(insertNat(Y, Z, nil_1), tree(W))), unionNat(deleteNat(X, insertNat(Y, Z, nil_1)), deleteNat(X, tree(W)))) -> prop_DeleteUnion(X, toList(insertNat(Y, Z, nil_1)), W)
7772. opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, X, nil_1), tree(Y))), deleteNat(zero, tree(Y))) -> prop_DeleteUnion(zero, toList(insertNat(zero, X, nil_1)), Y)
7773. prop_DeleteUnion(zero, toList(insertNat(zero, X, nil_1)), cons(Y, nil)) ~> prop_DeleteUnion(zero, toList(insertNat(zero, ?, nil_1)), cons(Y, nil))
7774. prop_DeleteUnion(zero, toList(insertNat(zero, X, nil_1)), toList(insertNat(Y, Z, nil_1))) ~> prop_DeleteUnion(zero, toList(insertNat(zero, ?, nil_1)), toList(insertNat(Y, Z, nil_1)))
7775. prop_DeleteUnion(zero, toList(insertNat(zero, X, nil_1)), toList(insertNat(zero, Y, insertNat(zero, Z, nil_1)))) -> false
7776. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (not_2): not(true) = false.
Axiom 3 (not_1): not(false) = true.
Axiom 4 (isLT_2): isLT(eq) = false.
Axiom 5 (isGT_2): isGT(eq) = false.
Axiom 6 (isGT_3): isGT(gt) = true.
Axiom 7 (toList_1): toList(leaf) = nil.
Axiom 8 (opAppend_1): opAppend(nil, X) = X.
Axiom 9 (join_1): join(leaf, X) = X.
Axiom 10 (belowNat_1): belowNat(X, leaf) = leaf.
Axiom 11 (aboveNat_1): aboveNat(X, leaf) = leaf.
Axiom 12 (unionNat_1): unionNat(leaf, X) = X.
Axiom 13 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 14 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 15 (compareNat_3): compareNat(suc(X), zero) = gt.
Axiom 16 (fst_1): fst(pair(X, Y)) = X.
Axiom 17 (snd_1): snd(pair(X, Y)) = Y.
Axiom 18 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 19 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 20 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 21 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 22 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 23 (geNat_1): geNat(X, Y) = not(isLT(compareNat(X, Y))).
Axiom 24 (leNat_1): leNat(X, Y) = not(isGT(compareNat(X, Y))).
Axiom 25 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 26 (eqListPairNatNat_2): eqListPairNatNat(nil, cons(X, Y)) = false.
Axiom 27 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 28 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 29 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 30 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 31 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 32 (belowNat_case1_1): belowNat_case1(true, X, Y, Z, W, V) = belowNat(X, Z).
Axiom 33 (aboveNat_case1_1): aboveNat_case1(true, X, Y, Z, W, V) = aboveNat(X, W).
Axiom 34 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 35 (belowNat_case1_2): belowNat_case1(false, X, Y, Z, W, V) = branch(Z, Y, V, belowNat(X, W)).
Axiom 36 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 37 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 38 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 39 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 40 (belowNat_2): belowNat(X, branch(Y, Z, W, V)) = belowNat_case1(leNat(X, Z), X, Z, Y, V, W).
Axiom 41 (aboveNat_2): aboveNat(X, branch(Y, Z, W, V)) = aboveNat_case1(geNat(X, Z), X, Z, Y, V, W).
Axiom 42 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 43 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 44 (prop_DeleteUnion_1): prop_DeleteUnion(X, Y, Z) = opEqTildeEqNatNat(deleteNat(X, unionNat(tree(Y), tree(Z))), unionNat(deleteNat(X, tree(Y)), deleteNat(X, tree(Z)))).
Axiom 45 (unionNat_3): unionNat(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(unionNat(X, belowNat(Y, branch(V, U, T, S))), Y, Z, unionNat(W, aboveNat(Y, branch(V, U, T, S)))).

Lemma 46: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 7 (toList_1) }
  nil

Lemma 47: unionNat(nil_1, X) = X.
Proof:
  unionNat(nil_1, X)
= { by axiom 1 (nil_1_1) }
  unionNat(leaf, X)
= { by axiom 12 (unionNat_1) }
  X

Lemma 48: join(nil_1, X) = X.
Proof:
  join(nil_1, X)
= { by axiom 1 (nil_1_1) }
  join(leaf, X)
= { by axiom 9 (join_1) }
  X

Lemma 49: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 19 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 14 (compareNat_1) }
  isLT(eq)
= { by axiom 4 (isLT_2) }
  false

Lemma 50: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 20 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 14 (compareNat_1) }
  isGT(eq)
= { by axiom 5 (isGT_2) }
  false

Lemma 51: belowNat(X, nil_1) = nil_1.
Proof:
  belowNat(X, nil_1)
= { by axiom 1 (nil_1_1) }
  belowNat(X, leaf)
= { by axiom 10 (belowNat_1) }
  leaf
= { by axiom 1 (nil_1_1) R->L }
  nil_1

Lemma 52: not(gtNat(X, Y)) = leNat(X, Y).
Proof:
  not(gtNat(X, Y))
= { by axiom 20 (gtNat_1) }
  not(isGT(compareNat(X, Y)))
= { by axiom 24 (leNat_1) R->L }
  leNat(X, Y)

Lemma 53: uncurry(insertNat_0, pair(X, Y)) = insertNat_2(X, Y).
Proof:
  uncurry(insertNat_0, pair(X, Y))
= { by axiom 34 (uncurry_1) }
  app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 13 (app_insertNat_0_1) }
  app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y)))
= { by axiom 22 (app_insertNat_1_1) }
  insertNat_2(fst(pair(X, Y)), snd(pair(X, Y)))
= { by axiom 16 (fst_1) }
  insertNat_2(X, snd(pair(X, Y)))
= { by axiom 17 (snd_1) }
  insertNat_2(X, Y)

Lemma 54: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 17 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 16 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 34 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 55: cons(pair(X, Y), toList(Z)) = toList(branch(nil_1, X, Y, Z)).
Proof:
  cons(pair(X, Y), toList(Z))
= { by axiom 8 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(Z)))
= { by axiom 29 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(Z))
= { by axiom 8 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by lemma 46 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(Z)))
= { by axiom 43 (toList_2) R->L }
  toList(branch(nil_1, X, Y, Z))

Lemma 56: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 30 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 57: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 46 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by lemma 55 }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 56 }
  toList(insertNat(X, Y, nil_1))

Lemma 58: uncurry(uncurry_1(X), pair(Y, Z)) = app(uncurry(X, Y), Z).
Proof:
  uncurry(uncurry_1(X), pair(Y, Z))
= { by lemma 54 R->L }
  app(app(uncurry_1(X), Y), Z)
= { by axiom 21 (app_uncurry_1_1) }
  app(uncurry(X, Y), Z)

Lemma 59: uncurry(uncurry_1(insertNat_0), pair(X, tree(Y))) = tree(cons(X, Y)).
Proof:
  uncurry(uncurry_1(insertNat_0), pair(X, tree(Y)))
= { by lemma 54 R->L }
  app(app(uncurry_1(insertNat_0), X), tree(Y))
= { by axiom 25 (tree_1) }
  app(app(uncurry_1(insertNat_0), X), foldr(uncurry_1(insertNat_0), nil_1, Y))
= { by axiom 36 (foldr_2) R->L }
  foldr(uncurry_1(insertNat_0), nil_1, cons(X, Y))
= { by axiom 25 (tree_1) R->L }
  tree(cons(X, Y))

Lemma 60: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 57 R->L }
  tree(cons(pair(X, Y), nil))
= { by lemma 59 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 25 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 18 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 58 }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by lemma 53 }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 28 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 61: deleteNat(zero, branch(X, zero, Y, Z)) = join(X, Z).
Proof:
  deleteNat(zero, branch(X, zero, Y, Z))
= { by axiom 38 (deleteNat_2) }
  deleteNat_case1(ltNat(zero, zero), zero, zero, X, Z, Y)
= { by lemma 49 }
  deleteNat_case1(false, zero, zero, X, Z, Y)
= { by axiom 39 (deleteNat_case1_2) }
  deleteNat_case1_case1(gtNat(zero, zero), zero, zero, X, Z, Y)
= { by lemma 50 }
  deleteNat_case1_case1(false, zero, zero, X, Z, Y)
= { by axiom 31 (deleteNat_case1_case1_2) }
  join(X, Z)

Lemma 62: deleteNat(zero, insertNat(zero, X, nil_1)) = nil_1.
Proof:
  deleteNat(zero, insertNat(zero, X, nil_1))
= { by lemma 56 R->L }
  deleteNat(zero, branch(nil_1, zero, X, nil_1))
= { by lemma 61 }
  join(nil_1, nil_1)
= { by lemma 48 }
  nil_1

Lemma 63: belowNat(suc(X), insertNat(zero, Y, nil_1)) = insertNat(zero, Y, nil_1).
Proof:
  belowNat(suc(X), insertNat(zero, Y, nil_1))
= { by lemma 56 R->L }
  belowNat(suc(X), branch(nil_1, zero, Y, nil_1))
= { by axiom 40 (belowNat_2) }
  belowNat_case1(leNat(suc(X), zero), suc(X), zero, nil_1, nil_1, Y)
= { by lemma 52 R->L }
  belowNat_case1(not(gtNat(suc(X), zero)), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 20 (gtNat_1) }
  belowNat_case1(not(isGT(compareNat(suc(X), zero))), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 15 (compareNat_3) }
  belowNat_case1(not(isGT(gt)), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 6 (isGT_3) }
  belowNat_case1(not(true), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 2 (not_2) }
  belowNat_case1(false, suc(X), zero, nil_1, nil_1, Y)
= { by axiom 35 (belowNat_case1_2) }
  branch(nil_1, zero, Y, belowNat(suc(X), nil_1))
= { by lemma 51 }
  branch(nil_1, zero, Y, nil_1)
= { by lemma 56 }
  insertNat(zero, Y, nil_1)

Lemma 64: aboveNat(zero, branch(X, zero, Y, Z)) = aboveNat(zero, Z).
Proof:
  aboveNat(zero, branch(X, zero, Y, Z))
= { by axiom 41 (aboveNat_2) }
  aboveNat_case1(geNat(zero, zero), zero, zero, X, Z, Y)
= { by axiom 23 (geNat_1) }
  aboveNat_case1(not(isLT(compareNat(zero, zero))), zero, zero, X, Z, Y)
= { by axiom 19 (ltNat_1) R->L }
  aboveNat_case1(not(ltNat(zero, zero)), zero, zero, X, Z, Y)
= { by lemma 49 }
  aboveNat_case1(not(false), zero, zero, X, Z, Y)
= { by axiom 3 (not_1) }
  aboveNat_case1(true, zero, zero, X, Z, Y)
= { by axiom 33 (aboveNat_case1_1) }
  aboveNat(zero, Z)

Lemma 65: insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y) = insertNat(zero, X, insertNat(zero, Y, nil_1)).
Proof:
  insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y)
= { by lemma 49 R->L }
  insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X, Y)
= { by axiom 42 (insertNat_2) R->L }
  insertNat(zero, X, branch(nil_1, zero, Y, nil_1))
= { by lemma 56 }
  insertNat(zero, X, insertNat(zero, Y, nil_1))

Lemma 66: tree(toList(insertNat(zero, X, insertNat(zero, Y, nil_1)))) = insertNat(zero, Y, insertNat(zero, X, nil_1)).
Proof:
  tree(toList(insertNat(zero, X, insertNat(zero, Y, nil_1))))
= { by lemma 65 R->L }
  tree(toList(insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y)))
= { by axiom 37 (insertNat_case1_2) }
  tree(toList(branch(nil_1, zero, Y, insertNat(zero, X, nil_1))))
= { by lemma 55 R->L }
  tree(cons(pair(zero, Y), toList(insertNat(zero, X, nil_1))))
= { by lemma 59 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 58 }
  app(uncurry(insertNat_0, pair(zero, Y)), tree(toList(insertNat(zero, X, nil_1))))
= { by lemma 53 }
  app(insertNat_2(zero, Y), tree(toList(insertNat(zero, X, nil_1))))
= { by axiom 28 (app_insertNat_2_1) }
  insertNat(zero, Y, tree(toList(insertNat(zero, X, nil_1))))
= { by lemma 60 }
  insertNat(zero, Y, insertNat(zero, X, nil_1))

Goal 1 (prop_DeleteUnion): prop_DeleteUnion(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = toList(insertNat(zero, Z, nil_1))
  Z = toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))

Proof:
  prop_DeleteUnion(zero, toList(insertNat(zero, Z, nil_1)), toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))
= { by axiom 44 (prop_DeleteUnion_1) }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(tree(toList(insertNat(zero, Z, nil_1))), tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))), unionNat(deleteNat(zero, tree(toList(insertNat(zero, Z, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))))
= { by lemma 60 }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))), unionNat(deleteNat(zero, tree(toList(insertNat(zero, Z, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))))
= { by lemma 60 }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))), unionNat(deleteNat(zero, insertNat(zero, Z, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))))
= { by lemma 62 }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))), unionNat(nil_1, deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))))
= { by lemma 47 }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 66 }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), insertNat(zero, X, insertNat(zero, Y, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 65 R->L }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 37 (insertNat_case1_2) }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), branch(nil_1, zero, Y, insertNat(zero, X, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 63 R->L }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(insertNat(zero, Z, nil_1), branch(nil_1, zero, Y, belowNat(suc(W), insertNat(zero, X, nil_1))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 56 R->L }
  opEqTildeEqNatNat(deleteNat(zero, unionNat(branch(nil_1, zero, Z, nil_1), branch(nil_1, zero, Y, belowNat(suc(W), insertNat(zero, X, nil_1))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 45 (unionNat_3) }
  opEqTildeEqNatNat(deleteNat(zero, branch(unionNat(nil_1, belowNat(zero, branch(nil_1, zero, Y, belowNat(suc(W), insertNat(zero, X, nil_1))))), zero, Z, unionNat(nil_1, aboveNat(zero, branch(nil_1, zero, Y, belowNat(suc(W), insertNat(zero, X, nil_1))))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 47 }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, branch(nil_1, zero, Y, belowNat(suc(W), insertNat(zero, X, nil_1)))), zero, Z, unionNat(nil_1, aboveNat(zero, branch(nil_1, zero, Y, belowNat(suc(W), insertNat(zero, X, nil_1))))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 64 }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, branch(nil_1, zero, Y, belowNat(suc(W), insertNat(zero, X, nil_1)))), zero, Z, unionNat(nil_1, aboveNat(zero, belowNat(suc(W), insertNat(zero, X, nil_1)))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 40 (belowNat_2) }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat_case1(leNat(zero, zero), zero, zero, nil_1, belowNat(suc(W), insertNat(zero, X, nil_1)), Y), zero, Z, unionNat(nil_1, aboveNat(zero, belowNat(suc(W), insertNat(zero, X, nil_1)))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 52 R->L }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat_case1(not(gtNat(zero, zero)), zero, zero, nil_1, belowNat(suc(W), insertNat(zero, X, nil_1)), Y), zero, Z, unionNat(nil_1, aboveNat(zero, belowNat(suc(W), insertNat(zero, X, nil_1)))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 50 }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat_case1(not(false), zero, zero, nil_1, belowNat(suc(W), insertNat(zero, X, nil_1)), Y), zero, Z, unionNat(nil_1, aboveNat(zero, belowNat(suc(W), insertNat(zero, X, nil_1)))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 3 (not_1) }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat_case1(true, zero, zero, nil_1, belowNat(suc(W), insertNat(zero, X, nil_1)), Y), zero, Z, unionNat(nil_1, aboveNat(zero, belowNat(suc(W), insertNat(zero, X, nil_1)))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 32 (belowNat_case1_1) }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, unionNat(nil_1, aboveNat(zero, belowNat(suc(W), insertNat(zero, X, nil_1)))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 47 }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, aboveNat(zero, belowNat(suc(W), insertNat(zero, X, nil_1))))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 63 }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, aboveNat(zero, insertNat(zero, X, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 56 R->L }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, aboveNat(zero, branch(nil_1, zero, X, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 64 }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, aboveNat(zero, nil_1))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, aboveNat(zero, leaf))), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 11 (aboveNat_1) }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, leaf)), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(deleteNat(zero, branch(belowNat(zero, nil_1), zero, Z, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 51 }
  opEqTildeEqNatNat(deleteNat(zero, branch(nil_1, zero, Z, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 56 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, Z, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 62 }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, tree(toList(insertNat(zero, Y, insertNat(zero, X, nil_1))))))
= { by lemma 66 }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, insertNat(zero, X, insertNat(zero, Y, nil_1))))
= { by lemma 65 R->L }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y)))
= { by axiom 37 (insertNat_case1_2) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, branch(nil_1, zero, Y, insertNat(zero, X, nil_1))))
= { by lemma 61 }
  opEqTildeEqNatNat(nil_1, join(nil_1, insertNat(zero, X, nil_1)))
= { by lemma 48 }
  opEqTildeEqNatNat(nil_1, insertNat(zero, X, nil_1))
= { by axiom 27 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(nil_1), toList(insertNat(zero, X, nil_1)))
= { by lemma 46 }
  eqListPairNatNat(nil, toList(insertNat(zero, X, nil_1)))
= { by lemma 57 R->L }
  eqListPairNatNat(nil, cons(pair(zero, X), nil))
= { by axiom 26 (eqListPairNatNat_2) }
  false

RESULT: Theorem (the conjecture is true).
