402. app(gtNat(X, Y), foldr(lam5(suc(Y)), Z, W)) -> foldr(lam5(suc(Y)), Z, cons(suc(X), W))
403. foldr(lam5(suc(zero)), X, cons(suc(zero), Y)) -> foldr(lam5(suc(zero)), X, cons(zero, Y))
404. map(lam5(zero), cons(X, cons(suc(Y), nil))) -> cons(gtNat(X, zero), cons(true, nil))
405. all(insertNat_0, map(X, map(Y, cons(Z, nil)))) -> opAnd(insertNat_1(app(X, app(Y, Z))), true)
406. opAnd(insertNat_1(app(X, pair(Y, Z))), true) -> all(insertNat_0, map(X, toList(insertNat(Y, Z, nil_1))))
407. all(fst_0, map(X, map(Y, cons(Z, nil)))) -> opAnd(fst(app(X, app(Y, Z))), true)
408. opAnd(fst(app(X, pair(Y, Z))), true) -> all(fst_0, map(X, toList(insertNat(Y, Z, nil_1))))
409. map(insertNat_0, map(X, map(Y, cons(Z, nil)))) -> cons(insertNat_1(app(X, app(Y, Z))), nil)
410. cons(insertNat_1(app(X, pair(Y, Z))), nil) -> map(insertNat_0, map(X, toList(insertNat(Y, Z, nil_1))))
411. map(fst_0, map(X, map(Y, cons(Z, nil)))) -> cons(fst(app(X, app(Y, Z))), nil)
412. cons(fst(app(X, pair(Y, Z))), nil) -> map(fst_0, map(X, toList(insertNat(Y, Z, nil_1))))
413. foldr(uncurry_1(insertNat_0), tree(X), cons(Y, cons(Z, nil))) -> tree(cons(Y, cons(Z, X)))
414. cons(app(X, Y), cons(app(X, Z), W)) -> opAppend(map(X, cons(Y, cons(Z, nil))), W)
415. app(uncurry(fst_0, X), foldr(fst(fst(X)), Y, Z)) -> foldr(fst(fst(X)), Y, cons(snd(X), Z))
416. foldr(insertNat_0, X, map(Y, map(Z, cons(W, nil)))) -> insertNat_2(app(Y, app(Z, W)), X)
417. foldr(insertNat_0, X, map(Y, toList(insertNat(Z, W, nil_1)))) -> insertNat_2(app(Y, pair(Z, W)), X)
418. toList(insertNat_case1(true, X, Y, nil_1, nil_1, Z, W)) -> cons(pair(X, Z), toList(insertNat(Y, W, nil_1)))
419. keys(insertNat_case1(true, X, Y, nil_1, nil_1, Z, W)) -> cons(X, cons(Y, nil))
420. foldr(X, snd(Y), cons(Z, cons(fst(Y), nil))) = uncurry(X, pair(Z, uncurry(X, Y)))
421. validNat(insertNat(X, Y, insertNat(Z, W, tree(V)))) -> prop_InsertValid(X, Y, cons(pair(Z, W), V))
422. all(fst_0, toList(tree(map(X, cons(Y, nil))))) -> opAnd(fst(app(X, Y)), true)
423. cons(pair(zero, X), toList(insertNat(zero, Y, nil_1))) -> toList(insertNat(zero, Y, insertNat(zero, X, nil_1)))
424. map(lam4(suc(X)), cons(Y, cons(zero, nil))) -> cons(ltNat(Y, suc(X)), cons(true, nil))
425. map(lam5(suc(X)), cons(Y, cons(zero, nil))) -> cons(gtNat(Y, suc(X)), cons(false, nil))
426. validNat(branch(tree(cons(X, nil)), Y, ?, nil_1)) -> opAnd(opAnd(ltNat(fst(X), Y), true), true)
427. foldr(fst_0, X, opAppend(cons(pair(Y, Z), W), V)) -> app(Y, foldr(fst_0, X, opAppend(W, V)))
428. all(lam4(zero), opAppend(opAppend(cons(suc(X), Y), Z), W)) -> false
429. all(lam5(suc(X)), opAppend(opAppend(cons(zero, Y), Z), W)) -> false
430. cons(app(X, pair(fst(Y), snd(Y))), Z) -> opAppend(map(X, toList(tree(cons(Y, nil)))), Z)
431. insertNat_case1(false, fst(X), Y, Z, W, snd(X), V) -> branch(Z, Y, V, app(uncurry(insertNat_0, X), W))
432. insertNat_case1(true, fst(X), Y, Z, W, snd(X), V) -> branch(app(uncurry(insertNat_0, X), Z), Y, V, W)
433. foldr(insertNat_0, X, map(insertNat_0, cons(Y, cons(Z, nil)))) -> insertNat_2(insertNat_1(Y), insertNat_2(insertNat_1(Z), X))
434. foldr(insertNat_0, X, map(fst_0, cons(Y, cons(Z, nil)))) -> insertNat_2(fst(Y), insertNat_2(fst(Z), X))
435. opAppend(map(X, cons(Y, cons(Z, nil))), nil) -> map(X, cons(Y, cons(Z, nil)))
436. opAnd(uncurry(X, pair(Y, Z)), all(app(X, Y), W)) -> all(app(X, Y), cons(Z, W))
437. cons(uncurry(X, pair(Y, Z)), map(app(X, Y), W)) -> map(app(X, Y), cons(Z, W))
438. foldr(lam4(zero), X, cons(Y, cons(suc(Z), nil))) -> app(ltNat(Y, zero), app(false, X))
439. foldr(lam5(zero), X, cons(Y, cons(suc(Z), nil))) -> app(gtNat(Y, zero), app(true, X))
440. all(lam4(zero), opAppend(cons(X, cons(zero, Y)), Z)) -> opAnd(ltNat(X, zero), false)
441. all(lam5(zero), opAppend(cons(X, cons(zero, Y)), Z)) -> opAnd(gtNat(X, zero), false)
442. app(uncurry(insertNat_0, X), insertNat(Y, Z, tree(W))) -> tree(cons(X, cons(pair(Y, Z), W)))
443. all(uncurry_1(insertNat_2(X, Y)), toList(insertNat(Z, W, nil_1))) -> all(insertNat(X, Y, Z), cons(W, nil))
444. map(uncurry_1(insertNat_2(X, Y)), toList(insertNat(Z, W, nil_1))) -> map(insertNat(X, Y, Z), cons(W, nil))
445. all(lam4(suc(zero)), opAppend(cons(suc(suc(X)), Y), Z)) -> false
446. insertNat_case1(false, X, Y, insertNat(Z, W, V), U, T, S) -> insertNat_case1(true, Z, Y, V, insertNat(X, T, U), W, S)
447. all(lam5(suc(suc(X))), opAppend(cons(suc(zero), Y), Z)) -> false
448. prop_InsertValid(zero, X, toList(insertNat(suc(Y), Z, nil_1))) -> true
449. prop_InsertValid(suc(X), Y, toList(insertNat(zero, Z, nil_1))) ~> prop_InsertValid(suc(X), Y, toList(insertNat(zero, ?, nil_1)))
450. foldr(X, Y, map(Z, map(W, cons(V, nil)))) -> uncurry(X, pair(app(Z, app(W, V)), Y))
451. foldr(X, Y, map(Z, toList(insertNat(W, V, nil_1)))) -> uncurry(X, pair(app(Z, pair(W, V)), Y))
452. map(fst_0, cons(X, toList(tree(cons(Y, nil))))) -> map(fst_0, cons(X, cons(Y, nil)))
453. keys(tree(map(insertNat_0, toList(insertNat(X, Y, nil_1))))) -> cons(fst(insertNat_1(pair(X, Y))), nil)
454. all(fst_0, cons(X, toList(tree(cons(Y, nil))))) -> all(fst_0, cons(X, cons(Y, nil)))
455. map(lam4(suc(zero)), opAppend(cons(suc(zero), X), Y)) -> cons(false, map(lam4(suc(zero)), opAppend(X, Y)))
456. map(lam5(suc(zero)), opAppend(cons(suc(zero), X), Y)) -> map(lam5(suc(zero)), opAppend(cons(zero, X), Y))
457. map(lam5(suc(zero)), cons(X, cons(suc(zero), Y))) -> map(lam5(suc(zero)), cons(X, cons(zero, Y)))
458. tree(toList(insertNat(zero, X, insertNat(zero, Y, nil_1)))) -> insertNat(zero, Y, insertNat(zero, X, nil_1))
459. opAppend(map(X, toList(tree(cons(Y, nil)))), nil) -> map(X, toList(tree(cons(Y, nil))))
460. opAnd(insertNat(X, Y, Z), all(uncurry_1(insertNat_1(X)), W)) -> all(uncurry_1(insertNat_1(X)), cons(pair(Y, Z), W))
461. cons(insertNat(X, Y, Z), map(uncurry_1(insertNat_1(X)), W)) -> map(uncurry_1(insertNat_1(X)), cons(pair(Y, Z), W))
462. foldr(fst_0, X, cons(Y, cons(pair(Z, W), V))) -> app(fst(Y), app(Z, foldr(fst_0, X, V)))
463. all(fst(fst(X)), cons(snd(X), cons(snd(X), nil))) -> all(uncurry_1(fst_0), cons(X, cons(X, nil)))
464. map(fst(fst(X)), cons(snd(X), cons(snd(X), nil))) -> map(uncurry_1(fst_0), cons(X, cons(X, nil)))
465. insertNat(X, pair(fst(Y), snd(Y)), Z) -> foldr(insertNat_1(X), Z, toList(tree(cons(Y, nil))))
466. app(uncurry(X, Y), foldr(app(X, fst(Y)), Z, W)) -> foldr(app(X, fst(Y)), Z, cons(snd(Y), W))
467. app(uncurry(insertNat_0, X), foldr(insertNat_1(fst(X)), Y, Z)) -> foldr(insertNat_1(fst(X)), Y, cons(snd(X), Z))
468. opAnd(tree(cons(X, Y)), all(uncurry_1(uncurry_1(insertNat_0)), Z)) -> all(uncurry_1(uncurry_1(insertNat_0)), cons(pair(X, tree(Y)), Z))
469. cons(tree(cons(X, Y)), map(uncurry_1(uncurry_1(insertNat_0)), Z)) -> map(uncurry_1(uncurry_1(insertNat_0)), cons(pair(X, tree(Y)), Z))
470. foldr(lam4(suc(X)), Y, cons(zero, cons(Z, nil))) -> app(true, app(ltNat(Z, suc(X)), Y))
471. foldr(lam5(suc(X)), Y, cons(zero, cons(Z, nil))) -> app(false, app(gtNat(Z, suc(X)), Y))
472. foldr(lam4(suc(X)), Y, cons(Z, cons(zero, nil))) -> app(ltNat(Z, suc(X)), app(true, Y))
473. foldr(lam5(suc(X)), Y, cons(Z, cons(zero, nil))) -> app(gtNat(Z, suc(X)), app(false, Y))
474. validNat(foldr(insertNat_1(X), nil_1, toList(tree(cons(Y, nil))))) -> true
475. foldr(insertNat_0, X, map(Y, cons(Z, cons(W, nil)))) = insertNat_2(app(Y, Z), insertNat_2(app(Y, W), X))
476. keys(branch(tree(cons(X, nil)), Y, Z, nil_1)) -> cons(fst(X), cons(Y, nil))
477. foldr(lam4(suc(zero)), X, cons(suc(suc(Y)), Z)) -> app(false, foldr(lam4(suc(zero)), X, Z))
478. foldr(lam5(suc(zero)), X, cons(suc(suc(Y)), Z)) -> app(true, foldr(lam5(suc(zero)), X, Z))
479. uncurry(fst(X), pair(Y, foldr(uncurry_1(fst_0), Z, W))) -> foldr(uncurry_1(fst_0), Z, cons(pair(X, Y), W))
480. keys(insertNat(zero, X, insertNat(suc(Y), Z, nil_1))) -> cons(zero, cons(suc(Y), nil))
481. foldr(fst_0, X, cons(Y, map(Z, cons(W, nil)))) -> app(fst(Y), app(fst(app(Z, W)), X))
482. foldr(lam4(zero), X, opAppend(cons(suc(Y), Z), W)) -> foldr(lam4(zero), X, opAppend(cons(zero, Z), W))
483. foldr(lam4(zero), X, cons(Y, cons(suc(Z), W))) -> foldr(lam4(zero), X, cons(Y, cons(zero, W)))
484. foldr(lam5(zero), X, opAppend(cons(suc(Y), Z), W)) -> app(true, foldr(lam5(zero), X, opAppend(Z, W)))
485. map(lam4(suc(zero)), cons(zero, cons(suc(zero), X))) -> cons(true, cons(false, map(lam4(suc(zero)), X)))
486. keys(branch(tree(cons(X, nil)), Y, Z, W)) -> cons(fst(X), cons(Y, keys(W)))
487. foldr(insertNat_0, X, opAppend(opAppend(cons(Y, Z), W), V)) -> insertNat_2(Y, foldr(insertNat_0, X, opAppend(opAppend(Z, W), V)))
488. cons(insertNat_1(pair(fst(X), snd(X))), Y) -> opAppend(map(insertNat_0, toList(tree(cons(X, nil)))), Y)
489. app(ltNat(pair(fst(X), snd(X)), Y), Z) -> foldr(lam4(Y), Z, toList(tree(cons(X, nil))))
490. app(gtNat(pair(fst(X), snd(X)), Y), Z) -> foldr(lam5(Y), Z, toList(tree(cons(X, nil))))
491. keys(insertNat_case1(true, X, Y, nil_1, Z, W, V)) -> cons(X, cons(Y, keys(Z)))
492. validNat(insertNat_case1(false, X, Y, nil_1, nil_1, Z, ?)) -> opAnd(gtNat(X, Y), true)
493. prop_InsertValid(zero, X, toList(insertNat(zero, ?, nil_1))) -> false
494. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (toList_1): toList(leaf) = nil.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (validNat_1): validNat(leaf) = true.
Axiom 6 (map_1): map(X, nil) = nil.
Axiom 7 (keys_1): keys(X) = map(fst_0, toList(X)).
Axiom 8 (opAppend_1): opAppend(nil, X) = X.
Axiom 9 (all_1): all(X, nil) = true.
Axiom 10 (opAnd_2): opAnd(true, X) = X.
Axiom 11 (opAnd_1): opAnd(false, X) = false.
Axiom 12 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 13 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 14 (app_fst_0_1): app(fst_0, X) = fst(X).
Axiom 15 (snd_1): snd(pair(X, Y)) = Y.
Axiom 16 (fst_1): fst(pair(X, Y)) = X.
Axiom 17 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 18 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 19 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 20 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 21 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 22 (app_lam5_1): app(lam5(X), Y) = gtNat(Y, X).
Axiom 23 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 24 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 25 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 26 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 27 (prop_InsertValid_1): prop_InsertValid(X, Y, Z) = validNat(insertNat(X, Y, tree(Z))).
Axiom 28 (all_2): all(X, cons(Y, Z)) = opAnd(app(X, Y), all(X, Z)).
Axiom 29 (map_2): map(X, cons(Y, Z)) = cons(app(X, Y), map(X, Z)).
Axiom 30 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 31 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 32 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 33 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 34 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 35 (validNat_2): validNat(branch(X, Y, Z, W)) = opAnd(validNat(X), opAnd(validNat(W), opAnd(all(lam4(Y), keys(X)), all(lam5(Y), keys(W))))).

Lemma 36: validNat(nil_1) = true.
Proof:
  validNat(nil_1)
= { by axiom 1 (nil_1_1) }
  validNat(leaf)
= { by axiom 5 (validNat_1) }
  true

Lemma 37: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 2 (toList_1) }
  nil

Lemma 38: keys(nil_1) = nil.
Proof:
  keys(nil_1)
= { by axiom 7 (keys_1) }
  map(fst_0, toList(nil_1))
= { by lemma 37 }
  map(fst_0, nil)
= { by axiom 6 (map_1) }
  nil

Lemma 39: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 16 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), Z)
= { by axiom 15 (snd_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 30 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 40: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 24 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 41: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 37 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by axiom 8 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(nil_1)))
= { by axiom 25 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(nil_1))
= { by axiom 8 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by lemma 37 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by axiom 33 (toList_2) R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 40 }
  toList(insertNat(X, Y, nil_1))

Lemma 42: opAnd(validNat(X), all(lam5(Y), keys(X))) = validNat(branch(nil_1, Y, Z, X)).
Proof:
  opAnd(validNat(X), all(lam5(Y), keys(X)))
= { by axiom 10 (opAnd_2) R->L }
  opAnd(validNat(X), opAnd(true, all(lam5(Y), keys(X))))
= { by axiom 9 (all_1) R->L }
  opAnd(validNat(X), opAnd(all(lam4(Y), nil), all(lam5(Y), keys(X))))
= { by axiom 10 (opAnd_2) R->L }
  opAnd(true, opAnd(validNat(X), opAnd(all(lam4(Y), nil), all(lam5(Y), keys(X)))))
= { by lemma 36 R->L }
  opAnd(validNat(nil_1), opAnd(validNat(X), opAnd(all(lam4(Y), nil), all(lam5(Y), keys(X)))))
= { by lemma 38 R->L }
  opAnd(validNat(nil_1), opAnd(validNat(X), opAnd(all(lam4(Y), keys(nil_1)), all(lam5(Y), keys(X)))))
= { by axiom 35 (validNat_2) R->L }
  validNat(branch(nil_1, Y, Z, X))

Goal 1 (prop_InsertValid): prop_InsertValid(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = X
  Z = toList(insertNat(zero, Y, nil_1))

Proof:
  prop_InsertValid(zero, X, toList(insertNat(zero, Y, nil_1)))
= { by lemma 41 R->L }
  prop_InsertValid(zero, X, cons(pair(zero, Y), nil))
= { by axiom 27 (prop_InsertValid_1) }
  validNat(insertNat(zero, X, tree(cons(pair(zero, Y), nil))))
= { by axiom 23 (tree_1) }
  validNat(insertNat(zero, X, foldr(uncurry_1(insertNat_0), nil_1, cons(pair(zero, Y), nil))))
= { by axiom 32 (foldr_2) }
  validNat(insertNat(zero, X, app(app(uncurry_1(insertNat_0), pair(zero, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))))
= { by axiom 23 (tree_1) R->L }
  validNat(insertNat(zero, X, app(app(uncurry_1(insertNat_0), pair(zero, Y)), tree(nil))))
= { by lemma 39 }
  validNat(insertNat(zero, X, uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), tree(nil)))))
= { by axiom 23 (tree_1) }
  validNat(insertNat(zero, X, uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))))
= { by axiom 19 (foldr_1) }
  validNat(insertNat(zero, X, uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), nil_1))))
= { by lemma 39 R->L }
  validNat(insertNat(zero, X, app(app(uncurry_1(insertNat_0), pair(zero, Y)), nil_1)))
= { by axiom 20 (app_uncurry_1_1) }
  validNat(insertNat(zero, X, app(uncurry(insertNat_0, pair(zero, Y)), nil_1)))
= { by axiom 30 (uncurry_1) }
  validNat(insertNat(zero, X, app(app(app(insertNat_0, fst(pair(zero, Y))), snd(pair(zero, Y))), nil_1)))
= { by axiom 13 (app_insertNat_0_1) }
  validNat(insertNat(zero, X, app(app(insertNat_1(fst(pair(zero, Y))), snd(pair(zero, Y))), nil_1)))
= { by axiom 21 (app_insertNat_1_1) }
  validNat(insertNat(zero, X, app(insertNat_2(fst(pair(zero, Y)), snd(pair(zero, Y))), nil_1)))
= { by axiom 15 (snd_1) }
  validNat(insertNat(zero, X, app(insertNat_2(fst(pair(zero, Y)), Y), nil_1)))
= { by axiom 16 (fst_1) }
  validNat(insertNat(zero, X, app(insertNat_2(zero, Y), nil_1)))
= { by axiom 26 (app_insertNat_2_1) }
  validNat(insertNat(zero, X, insertNat(zero, Y, nil_1)))
= { by lemma 40 R->L }
  validNat(insertNat(zero, X, branch(nil_1, zero, Y, nil_1)))
= { by axiom 34 (insertNat_2) }
  validNat(insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X, Y))
= { by axiom 17 (ltNat_1) }
  validNat(insertNat_case1(isLT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, X, Y))
= { by axiom 12 (compareNat_1) }
  validNat(insertNat_case1(isLT(eq), zero, zero, nil_1, nil_1, X, Y))
= { by axiom 3 (isLT_2) }
  validNat(insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y))
= { by axiom 31 (insertNat_case1_2) }
  validNat(branch(nil_1, zero, Y, insertNat(zero, X, nil_1)))
= { by lemma 42 R->L }
  opAnd(validNat(insertNat(zero, X, nil_1)), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 40 R->L }
  opAnd(validNat(branch(nil_1, zero, X, nil_1)), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 42 R->L }
  opAnd(opAnd(validNat(nil_1), all(lam5(zero), keys(nil_1))), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 36 }
  opAnd(opAnd(true, all(lam5(zero), keys(nil_1))), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by axiom 10 (opAnd_2) }
  opAnd(all(lam5(zero), keys(nil_1)), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by lemma 38 }
  opAnd(all(lam5(zero), nil), all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by axiom 9 (all_1) }
  opAnd(true, all(lam5(zero), keys(insertNat(zero, X, nil_1))))
= { by axiom 10 (opAnd_2) }
  all(lam5(zero), keys(insertNat(zero, X, nil_1)))
= { by axiom 7 (keys_1) }
  all(lam5(zero), map(fst_0, toList(insertNat(zero, X, nil_1))))
= { by lemma 41 R->L }
  all(lam5(zero), map(fst_0, cons(pair(zero, X), nil)))
= { by axiom 29 (map_2) }
  all(lam5(zero), cons(app(fst_0, pair(zero, X)), map(fst_0, nil)))
= { by axiom 6 (map_1) }
  all(lam5(zero), cons(app(fst_0, pair(zero, X)), nil))
= { by axiom 14 (app_fst_0_1) }
  all(lam5(zero), cons(fst(pair(zero, X)), nil))
= { by axiom 16 (fst_1) }
  all(lam5(zero), cons(zero, nil))
= { by axiom 28 (all_2) }
  opAnd(app(lam5(zero), zero), all(lam5(zero), nil))
= { by axiom 9 (all_1) }
  opAnd(app(lam5(zero), zero), true)
= { by axiom 22 (app_lam5_1) }
  opAnd(gtNat(zero, zero), true)
= { by axiom 18 (gtNat_1) }
  opAnd(isGT(compareNat(zero, zero)), true)
= { by axiom 12 (compareNat_1) }
  opAnd(isGT(eq), true)
= { by axiom 4 (isGT_2) }
  opAnd(false, true)
= { by axiom 11 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
