1052. prop_DeleteInsert(zero, pair(zero, X), toList(insertNat(zero, Y, nil_1))) -> false
1053. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (toList_1): toList(leaf) = nil.
Axiom 5 (opAppend_1): opAppend(nil, X) = X.
Axiom 6 (join_1): join(leaf, X) = X.
Axiom 7 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 8 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 9 (eqNat_1): eqNat(zero, zero) = true.
Axiom 10 (fst_1): fst(pair(X, Y)) = X.
Axiom 11 (snd_1): snd(pair(X, Y)) = Y.
Axiom 12 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 13 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 14 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 15 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 16 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 17 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 18 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 19 (eqListPairNatNat_3): eqListPairNatNat(cons(X, Y), nil) = false.
Axiom 20 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 21 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 22 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 23 (prop_DeleteInsert_case1_case1_1): prop_DeleteInsert_case1_case1(true, X, Y, Z, W) = deleteNat(X, tree(Z)).
Axiom 24 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 25 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 26 (prop_DeleteInsert_case1_1): prop_DeleteInsert_case1(X, Y, Z, W) = prop_DeleteInsert_case1_case1(eqNat(X, Y), X, Y, Z, W).
Axiom 27 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 28 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, insertNat(X, V, W)).
Axiom 29 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 30 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 31 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 32 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 33 (prop_DeleteInsert_1): prop_DeleteInsert(X, pair(Y, Z), W) = opEqTildeEqNatNat(deleteNat(X, insertNat(Y, Z, tree(W))), prop_DeleteInsert_case1(X, Y, W, Z)).

Lemma 34: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 4 (toList_1) }
  nil

Lemma 35: join(nil_1, X) = X.
Proof:
  join(nil_1, X)
= { by axiom 1 (nil_1_1) }
  join(leaf, X)
= { by axiom 6 (join_1) }
  X

Lemma 36: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 12 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 7 (compareNat_1) }
  isLT(eq)
= { by axiom 2 (isLT_2) }
  false

Lemma 37: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 11 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 10 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 25 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 38: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 22 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 39: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 34 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by axiom 5 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(nil_1)))
= { by axiom 21 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(nil_1))
= { by axiom 5 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by lemma 34 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by axiom 32 (toList_2) R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 38 }
  toList(insertNat(X, Y, nil_1))

Lemma 40: tree(cons(pair(X, Y), nil)) = insertNat(X, Y, nil_1).
Proof:
  tree(cons(pair(X, Y), nil))
= { by axiom 17 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 27 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 17 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 37 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 17 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 14 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 37 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 15 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 25 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 8 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 16 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 10 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 11 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 20 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Lemma 41: deleteNat(zero, branch(X, zero, Y, Z)) = join(X, Z).
Proof:
  deleteNat(zero, branch(X, zero, Y, Z))
= { by axiom 29 (deleteNat_2) }
  deleteNat_case1(ltNat(zero, zero), zero, zero, X, Z, Y)
= { by lemma 36 }
  deleteNat_case1(false, zero, zero, X, Z, Y)
= { by axiom 30 (deleteNat_case1_2) }
  deleteNat_case1_case1(gtNat(zero, zero), zero, zero, X, Z, Y)
= { by axiom 13 (gtNat_1) }
  deleteNat_case1_case1(isGT(compareNat(zero, zero)), zero, zero, X, Z, Y)
= { by axiom 7 (compareNat_1) }
  deleteNat_case1_case1(isGT(eq), zero, zero, X, Z, Y)
= { by axiom 3 (isGT_2) }
  deleteNat_case1_case1(false, zero, zero, X, Z, Y)
= { by axiom 24 (deleteNat_case1_case1_2) }
  join(X, Z)

Goal 1 (prop_DeleteInsert): prop_DeleteInsert(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = pair(zero, X)
  Z = toList(insertNat(zero, Y, nil_1))

Proof:
  prop_DeleteInsert(zero, pair(zero, X), toList(insertNat(zero, Y, nil_1)))
= { by lemma 39 R->L }
  prop_DeleteInsert(zero, pair(zero, X), cons(pair(zero, Y), nil))
= { by axiom 33 (prop_DeleteInsert_1) }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, tree(cons(pair(zero, Y), nil)))), prop_DeleteInsert_case1(zero, zero, cons(pair(zero, Y), nil), X))
= { by axiom 26 (prop_DeleteInsert_case1_1) }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, tree(cons(pair(zero, Y), nil)))), prop_DeleteInsert_case1_case1(eqNat(zero, zero), zero, zero, cons(pair(zero, Y), nil), X))
= { by axiom 9 (eqNat_1) }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, tree(cons(pair(zero, Y), nil)))), prop_DeleteInsert_case1_case1(true, zero, zero, cons(pair(zero, Y), nil), X))
= { by axiom 23 (prop_DeleteInsert_case1_case1_1) }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, tree(cons(pair(zero, Y), nil)))), deleteNat(zero, tree(cons(pair(zero, Y), nil))))
= { by lemma 40 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, insertNat(zero, Y, nil_1))), deleteNat(zero, tree(cons(pair(zero, Y), nil))))
= { by lemma 40 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, insertNat(zero, Y, nil_1))), deleteNat(zero, insertNat(zero, Y, nil_1)))
= { by lemma 38 R->L }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, insertNat(zero, Y, nil_1))), deleteNat(zero, branch(nil_1, zero, Y, nil_1)))
= { by lemma 41 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, insertNat(zero, Y, nil_1))), join(nil_1, nil_1))
= { by lemma 35 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, insertNat(zero, Y, nil_1))), nil_1)
= { by lemma 38 R->L }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, branch(nil_1, zero, Y, nil_1))), nil_1)
= { by axiom 31 (insertNat_2) }
  opEqTildeEqNatNat(deleteNat(zero, insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, X, Y)), nil_1)
= { by lemma 36 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y)), nil_1)
= { by axiom 28 (insertNat_case1_2) }
  opEqTildeEqNatNat(deleteNat(zero, branch(nil_1, zero, Y, insertNat(zero, X, nil_1))), nil_1)
= { by lemma 41 }
  opEqTildeEqNatNat(join(nil_1, insertNat(zero, X, nil_1)), nil_1)
= { by lemma 35 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), nil_1)
= { by axiom 18 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, X, nil_1)), toList(nil_1))
= { by lemma 34 }
  eqListPairNatNat(toList(insertNat(zero, X, nil_1)), nil)
= { by lemma 39 R->L }
  eqListPairNatNat(cons(pair(zero, X), nil), nil)
= { by axiom 19 (eqListPairNatNat_3) }
  false

RESULT: Theorem (the conjecture is true).
