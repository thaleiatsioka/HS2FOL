  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, nil_1), zero, Y, aboveNat(zero, leaf))))
= { by axiom 11 (aboveNat_1) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, nil_1), zero, Y, leaf)))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, nil_1), zero, Y, nil_1)))
= { by lemma 51 }
