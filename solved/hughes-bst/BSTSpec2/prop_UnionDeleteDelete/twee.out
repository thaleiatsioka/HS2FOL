= { by axiom 42 (insertNat_2) R->L }
  insertNat(zero, X, branch(nil_1, zero, Y, nil_1))
= { by lemma 56 }
  insertNat(zero, X, insertNat(zero, Y, nil_1))

Lemma 66: tree(toList(insertNat(zero, X, insertNat(zero, Y, nil_1)))) = insertNat(zero, Y, insertNat(zero, X, nil_1)).
Proof:
  tree(toList(insertNat(zero, X, insertNat(zero, Y, nil_1))))
= { by lemma 65 R->L }
  tree(toList(insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y)))
= { by axiom 37 (insertNat_case1_2) }
  tree(toList(branch(nil_1, zero, Y, insertNat(zero, X, nil_1))))
= { by lemma 55 R->L }
  tree(cons(pair(zero, Y), toList(insertNat(zero, X, nil_1))))
= { by lemma 59 R->L }
  uncurry(uncurry_1(insertNat_0), pair(pair(zero, Y), tree(toList(insertNat(zero, X, nil_1)))))
= { by lemma 58 }
  app(uncurry(insertNat_0, pair(zero, Y)), tree(toList(insertNat(zero, X, nil_1))))
= { by lemma 53 }
  app(insertNat_2(zero, Y), tree(toList(insertNat(zero, X, nil_1))))
= { by axiom 28 (app_insertNat_2_1) }
  insertNat(zero, Y, tree(toList(insertNat(zero, X, nil_1))))
= { by lemma 60 }
  insertNat(zero, Y, insertNat(zero, X, nil_1))

Goal 1 (prop_UnionDeleteDelete): prop_UnionDeleteDelete(X, Y, Z) = false.
The goal is true when:
  X = toList(insertNat(zero, Y, nil_1))
  Y = toList(insertNat(zero, W, insertNat(zero, X, nil_1)))
  Z = zero

Proof:
  prop_UnionDeleteDelete(toList(insertNat(zero, Y, nil_1)), toList(insertNat(zero, W, insertNat(zero, X, nil_1))), zero)
= { by axiom 44 (prop_UnionDeleteDelete_1) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, Y, nil_1)))), deleteNat(zero, tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))), deleteNat(zero, unionNat(tree(toList(insertNat(zero, Y, nil_1))), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 60 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, Y, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))), deleteNat(zero, unionNat(tree(toList(insertNat(zero, Y, nil_1))), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 60 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, Y, nil_1)), deleteNat(zero, tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 62 }
  opEqTildeEqNatNat(unionNat(nil_1, deleteNat(zero, tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 47 }
  opEqTildeEqNatNat(deleteNat(zero, tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1))))), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 66 }
  opEqTildeEqNatNat(deleteNat(zero, insertNat(zero, X, insertNat(zero, W, nil_1))), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 65 R->L }
  opEqTildeEqNatNat(deleteNat(zero, insertNat_case1(false, zero, zero, nil_1, nil_1, X, W)), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by axiom 37 (insertNat_case1_2) }
  opEqTildeEqNatNat(deleteNat(zero, branch(nil_1, zero, W, insertNat(zero, X, nil_1))), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 61 }
  opEqTildeEqNatNat(join(nil_1, insertNat(zero, X, nil_1)), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 48 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), tree(toList(insertNat(zero, W, insertNat(zero, X, nil_1)))))))
= { by lemma 66 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), insertNat(zero, X, insertNat(zero, W, nil_1)))))
= { by lemma 65 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), insertNat_case1(false, zero, zero, nil_1, nil_1, X, W))))
= { by axiom 37 (insertNat_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), branch(nil_1, zero, W, insertNat(zero, X, nil_1)))))
= { by lemma 63 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, unionNat(insertNat(zero, Y, nil_1), branch(nil_1, zero, W, belowNat(suc(Z), insertNat(zero, X, nil_1))))))
= { by lemma 56 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, unionNat(branch(nil_1, zero, Y, nil_1), branch(nil_1, zero, W, belowNat(suc(Z), insertNat(zero, X, nil_1))))))
= { by axiom 45 (unionNat_3) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(unionNat(nil_1, belowNat(zero, branch(nil_1, zero, W, belowNat(suc(Z), insertNat(zero, X, nil_1))))), zero, Y, unionNat(nil_1, aboveNat(zero, branch(nil_1, zero, W, belowNat(suc(Z), insertNat(zero, X, nil_1))))))))
= { by lemma 47 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, branch(nil_1, zero, W, belowNat(suc(Z), insertNat(zero, X, nil_1)))), zero, Y, unionNat(nil_1, aboveNat(zero, branch(nil_1, zero, W, belowNat(suc(Z), insertNat(zero, X, nil_1))))))))
= { by lemma 64 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, branch(nil_1, zero, W, belowNat(suc(Z), insertNat(zero, X, nil_1)))), zero, Y, unionNat(nil_1, aboveNat(zero, belowNat(suc(Z), insertNat(zero, X, nil_1)))))))
= { by axiom 40 (belowNat_2) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat_case1(leNat(zero, zero), zero, zero, nil_1, belowNat(suc(Z), insertNat(zero, X, nil_1)), W), zero, Y, unionNat(nil_1, aboveNat(zero, belowNat(suc(Z), insertNat(zero, X, nil_1)))))))
= { by lemma 52 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat_case1(not(gtNat(zero, zero)), zero, zero, nil_1, belowNat(suc(Z), insertNat(zero, X, nil_1)), W), zero, Y, unionNat(nil_1, aboveNat(zero, belowNat(suc(Z), insertNat(zero, X, nil_1)))))))
= { by lemma 50 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat_case1(not(false), zero, zero, nil_1, belowNat(suc(Z), insertNat(zero, X, nil_1)), W), zero, Y, unionNat(nil_1, aboveNat(zero, belowNat(suc(Z), insertNat(zero, X, nil_1)))))))
= { by axiom 3 (not_1) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat_case1(true, zero, zero, nil_1, belowNat(suc(Z), insertNat(zero, X, nil_1)), W), zero, Y, unionNat(nil_1, aboveNat(zero, belowNat(suc(Z), insertNat(zero, X, nil_1)))))))
= { by axiom 32 (belowNat_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, nil_1), zero, Y, unionNat(nil_1, aboveNat(zero, belowNat(suc(Z), insertNat(zero, X, nil_1)))))))
= { by lemma 47 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, nil_1), zero, Y, aboveNat(zero, belowNat(suc(Z), insertNat(zero, X, nil_1))))))
= { by lemma 63 }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, nil_1), zero, Y, aboveNat(zero, insertNat(zero, X, nil_1)))))
= { by lemma 56 R->L }
  opEqTildeEqNatNat(insertNat(zero, X, nil_1), deleteNat(zero, branch(belowNat(zero, nil_1), zero, Y, aboveNat(zero, branch(nil_1, zero, X, nil_1)))))
