Lemma 63: belowNat(suc(X), insertNat(zero, Y, nil_1)) = insertNat(zero, Y, nil_1).
Proof:
  belowNat(suc(X), insertNat(zero, Y, nil_1))
= { by lemma 56 R->L }
  belowNat(suc(X), branch(nil_1, zero, Y, nil_1))
= { by axiom 40 (belowNat_2) }
  belowNat_case1(leNat(suc(X), zero), suc(X), zero, nil_1, nil_1, Y)
= { by lemma 52 R->L }
  belowNat_case1(not(gtNat(suc(X), zero)), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 20 (gtNat_1) }
  belowNat_case1(not(isGT(compareNat(suc(X), zero))), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 15 (compareNat_3) }
  belowNat_case1(not(isGT(gt)), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 6 (isGT_3) }
  belowNat_case1(not(true), suc(X), zero, nil_1, nil_1, Y)
= { by axiom 2 (not_2) }
  belowNat_case1(false, suc(X), zero, nil_1, nil_1, Y)
= { by axiom 35 (belowNat_case1_2) }
  branch(nil_1, zero, Y, belowNat(suc(X), nil_1))
= { by lemma 51 }
  branch(nil_1, zero, Y, nil_1)
= { by lemma 56 }
  insertNat(zero, Y, nil_1)

Lemma 64: aboveNat(zero, branch(X, zero, Y, Z)) = aboveNat(zero, Z).
Proof:
  aboveNat(zero, branch(X, zero, Y, Z))
= { by axiom 41 (aboveNat_2) }
  aboveNat_case1(geNat(zero, zero), zero, zero, X, Z, Y)
= { by axiom 23 (geNat_1) }
  aboveNat_case1(not(isLT(compareNat(zero, zero))), zero, zero, X, Z, Y)
= { by axiom 19 (ltNat_1) R->L }
  aboveNat_case1(not(ltNat(zero, zero)), zero, zero, X, Z, Y)
= { by lemma 49 }
  aboveNat_case1(not(false), zero, zero, X, Z, Y)
= { by axiom 3 (not_1) }
  aboveNat_case1(true, zero, zero, X, Z, Y)
= { by axiom 33 (aboveNat_case1_1) }
  aboveNat(zero, Z)

Lemma 65: insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y) = insertNat(zero, X, insertNat(zero, Y, nil_1)).
Proof:
  insertNat_case1(false, zero, zero, nil_1, nil_1, X, Y)
= { by lemma 49 R->L }
