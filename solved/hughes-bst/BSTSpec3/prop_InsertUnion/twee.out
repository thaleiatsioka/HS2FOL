The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (not_1): not(false) = true.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (toList_1): toList(leaf) = nil.
Axiom 6 (opAnd_2): opAnd(true, X) = X.
Axiom 7 (opAnd_1): opAnd(false, X) = false.
Axiom 8 (opAppend_1): opAppend(nil, X) = X.
Axiom 9 (belowNat_1): belowNat(X, leaf) = leaf.
Axiom 10 (aboveNat_1): aboveNat(X, leaf) = leaf.
Axiom 11 (eqListPairNatNat_1): eqListPairNatNat(nil, nil) = true.
Axiom 12 (unionNat_1): unionNat(leaf, X) = X.
Axiom 13 (eqNat_1): eqNat(zero, zero) = true.
Axiom 14 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 15 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 16 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 17 (fst_1): fst(pair(X, Y)) = X.
Axiom 18 (snd_1): snd(pair(X, Y)) = Y.
Axiom 19 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 20 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 21 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 22 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 23 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 24 (geNat_1): geNat(X, Y) = not(isLT(compareNat(X, Y))).
Axiom 25 (leNat_1): leNat(X, Y) = not(isGT(compareNat(X, Y))).
Axiom 26 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 27 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 28 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 29 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 30 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 31 (belowNat_case1_1): belowNat_case1(true, X, Y, Z, W, V) = belowNat(X, Z).
Axiom 32 (aboveNat_case1_1): aboveNat_case1(true, X, Y, Z, W, V) = aboveNat(X, W).
Axiom 33 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 34 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 35 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 36 (insertNat_case1_case1_2): insertNat_case1_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, W).
Axiom 37 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 38 (belowNat_2): belowNat(X, branch(Y, Z, W, V)) = belowNat_case1(leNat(X, Z), X, Z, Y, V, W).
Axiom 39 (aboveNat_2): aboveNat(X, branch(Y, Z, W, V)) = aboveNat_case1(geNat(X, Z), X, Z, Y, V, W).
Axiom 40 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 41 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = insertNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V, U).
Axiom 42 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 43 (prop_InsertUnion_1): prop_InsertUnion(pair(X, Y), Z, W) = opEqTildeEqNatNat(insertNat(X, Y, unionNat(tree(Z), tree(W))), unionNat(insertNat(X, Y, tree(Z)), tree(W))).
Axiom 44 (unionNat_3): unionNat(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(unionNat(X, belowNat(Y, branch(V, U, T, S))), Y, Z, unionNat(W, aboveNat(Y, branch(V, U, T, S)))).

Lemma 45: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 26 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 19 (foldr_1) }
  nil_1

Lemma 46: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 5 (toList_1) }
  nil

Lemma 47: unionNat(nil_1, X) = X.
Proof:
  unionNat(nil_1, X)
= { by axiom 1 (nil_1_1) }
  unionNat(leaf, X)
= { by axiom 12 (unionNat_1) }
  X

Lemma 48: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 20 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 16 (compareNat_1) }
  isLT(eq)
= { by axiom 3 (isLT_2) }
  false

Lemma 49: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 21 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 16 (compareNat_1) }
  isGT(eq)
= { by axiom 4 (isGT_2) }
  false

Lemma 50: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 18 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 17 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 35 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 51: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 30 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 52: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 46 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by axiom 8 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(nil_1)))
= { by axiom 29 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(nil_1))
= { by axiom 8 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by lemma 46 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by axiom 42 (toList_2) R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 51 }
  toList(insertNat(X, Y, nil_1))

Lemma 53: tree(cons(pair(X, Y), nil)) = insertNat(X, Y, nil_1).
Proof:
  tree(cons(pair(X, Y), nil))
= { by axiom 26 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 37 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 26 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 50 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 45 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 50 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 22 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 35 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 15 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 23 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 17 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 18 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 28 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Goal 1 (prop_InsertUnion): prop_InsertUnion(X, Y, Z) = false.
The goal is true when:
  X = pair(zero, suc(X))
  Y = nil
  Z = toList(insertNat(zero, zero, nil_1))

Proof:
  prop_InsertUnion(pair(zero, suc(X)), nil, toList(insertNat(zero, zero, nil_1)))
= { by lemma 52 R->L }
  prop_InsertUnion(pair(zero, suc(X)), nil, cons(pair(zero, zero), nil))
= { by axiom 43 (prop_InsertUnion_1) }
  opEqTildeEqNatNat(insertNat(zero, suc(X), unionNat(tree(nil), tree(cons(pair(zero, zero), nil)))), unionNat(insertNat(zero, suc(X), tree(nil)), tree(cons(pair(zero, zero), nil))))
= { by lemma 45 }
  opEqTildeEqNatNat(insertNat(zero, suc(X), unionNat(nil_1, tree(cons(pair(zero, zero), nil)))), unionNat(insertNat(zero, suc(X), tree(nil)), tree(cons(pair(zero, zero), nil))))
= { by lemma 47 }
  opEqTildeEqNatNat(insertNat(zero, suc(X), tree(cons(pair(zero, zero), nil))), unionNat(insertNat(zero, suc(X), tree(nil)), tree(cons(pair(zero, zero), nil))))
= { by lemma 45 }
  opEqTildeEqNatNat(insertNat(zero, suc(X), tree(cons(pair(zero, zero), nil))), unionNat(insertNat(zero, suc(X), nil_1), tree(cons(pair(zero, zero), nil))))
= { by lemma 53 }
  opEqTildeEqNatNat(insertNat(zero, suc(X), insertNat(zero, zero, nil_1)), unionNat(insertNat(zero, suc(X), nil_1), tree(cons(pair(zero, zero), nil))))
= { by lemma 53 }
  opEqTildeEqNatNat(insertNat(zero, suc(X), insertNat(zero, zero, nil_1)), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by lemma 51 R->L }
  opEqTildeEqNatNat(insertNat(zero, suc(X), branch(nil_1, zero, zero, nil_1)), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by axiom 40 (insertNat_2) }
  opEqTildeEqNatNat(insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, suc(X), zero), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by lemma 48 }
  opEqTildeEqNatNat(insertNat_case1(false, zero, zero, nil_1, nil_1, suc(X), zero), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by axiom 41 (insertNat_case1_2) }
  opEqTildeEqNatNat(insertNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, nil_1, suc(X), zero), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by lemma 49 }
  opEqTildeEqNatNat(insertNat_case1_case1(false, zero, zero, nil_1, nil_1, suc(X), zero), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by axiom 36 (insertNat_case1_case1_2) }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, nil_1), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by lemma 51 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), unionNat(insertNat(zero, suc(X), nil_1), insertNat(zero, zero, nil_1)))
= { by lemma 51 R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), unionNat(insertNat(zero, suc(X), nil_1), branch(nil_1, zero, zero, nil_1)))
= { by lemma 51 R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), unionNat(branch(nil_1, zero, suc(X), nil_1), branch(nil_1, zero, zero, nil_1)))
= { by axiom 44 (unionNat_3) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(unionNat(nil_1, belowNat(zero, branch(nil_1, zero, zero, nil_1))), zero, suc(X), unionNat(nil_1, aboveNat(zero, branch(nil_1, zero, zero, nil_1)))))
= { by lemma 47 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, branch(nil_1, zero, zero, nil_1)), zero, suc(X), unionNat(nil_1, aboveNat(zero, branch(nil_1, zero, zero, nil_1)))))
= { by axiom 39 (aboveNat_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, branch(nil_1, zero, zero, nil_1)), zero, suc(X), unionNat(nil_1, aboveNat_case1(geNat(zero, zero), zero, zero, nil_1, nil_1, zero))))
= { by axiom 24 (geNat_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, branch(nil_1, zero, zero, nil_1)), zero, suc(X), unionNat(nil_1, aboveNat_case1(not(isLT(compareNat(zero, zero))), zero, zero, nil_1, nil_1, zero))))
= { by axiom 20 (ltNat_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, branch(nil_1, zero, zero, nil_1)), zero, suc(X), unionNat(nil_1, aboveNat_case1(not(ltNat(zero, zero)), zero, zero, nil_1, nil_1, zero))))
= { by lemma 48 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, branch(nil_1, zero, zero, nil_1)), zero, suc(X), unionNat(nil_1, aboveNat_case1(not(false), zero, zero, nil_1, nil_1, zero))))
= { by axiom 2 (not_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, branch(nil_1, zero, zero, nil_1)), zero, suc(X), unionNat(nil_1, aboveNat_case1(true, zero, zero, nil_1, nil_1, zero))))
= { by axiom 32 (aboveNat_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, branch(nil_1, zero, zero, nil_1)), zero, suc(X), unionNat(nil_1, aboveNat(zero, nil_1))))
= { by axiom 38 (belowNat_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat_case1(leNat(zero, zero), zero, zero, nil_1, nil_1, zero), zero, suc(X), unionNat(nil_1, aboveNat(zero, nil_1))))
= { by axiom 25 (leNat_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat_case1(not(isGT(compareNat(zero, zero))), zero, zero, nil_1, nil_1, zero), zero, suc(X), unionNat(nil_1, aboveNat(zero, nil_1))))
= { by axiom 21 (gtNat_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat_case1(not(gtNat(zero, zero)), zero, zero, nil_1, nil_1, zero), zero, suc(X), unionNat(nil_1, aboveNat(zero, nil_1))))
= { by lemma 49 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat_case1(not(false), zero, zero, nil_1, nil_1, zero), zero, suc(X), unionNat(nil_1, aboveNat(zero, nil_1))))
= { by axiom 2 (not_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat_case1(true, zero, zero, nil_1, nil_1, zero), zero, suc(X), unionNat(nil_1, aboveNat(zero, nil_1))))
= { by axiom 31 (belowNat_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, nil_1), zero, suc(X), unionNat(nil_1, aboveNat(zero, nil_1))))
= { by lemma 47 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, nil_1), zero, suc(X), aboveNat(zero, nil_1)))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(belowNat(zero, leaf), zero, suc(X), aboveNat(zero, nil_1)))
= { by axiom 9 (belowNat_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(leaf, zero, suc(X), aboveNat(zero, nil_1)))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(nil_1, zero, suc(X), aboveNat(zero, nil_1)))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(nil_1, zero, suc(X), aboveNat(zero, leaf)))
= { by axiom 10 (aboveNat_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(nil_1, zero, suc(X), leaf))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(nil_1, zero, suc(X), nil_1))
= { by lemma 51 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat(zero, suc(X), nil_1))
= { by axiom 27 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(insertNat(zero, suc(X), nil_1)))
= { by lemma 52 R->L }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), cons(pair(zero, suc(X)), nil))
= { by lemma 52 R->L }
  eqListPairNatNat(cons(pair(zero, zero), nil), cons(pair(zero, suc(X)), nil))
= { by axiom 34 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, suc(X))), eqListPairNatNat(nil, nil))
= { by axiom 11 (eqListPairNatNat_1) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, suc(X))), true)
= { by axiom 33 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(zero, zero), eqNat(zero, suc(X))), true)
= { by axiom 13 (eqNat_1) }
  opAnd(opAnd(true, eqNat(zero, suc(X))), true)
= { by axiom 6 (opAnd_2) }
  opAnd(eqNat(zero, suc(X)), true)
= { by axiom 14 (eqNat_2) }
  opAnd(false, true)
= { by axiom 7 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
