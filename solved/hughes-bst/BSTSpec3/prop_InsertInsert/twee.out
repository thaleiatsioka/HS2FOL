185. prop_InsertInsert_case1_case1(false, suc(suc(X)), suc(zero), Y, Z, W) -> prop_InsertInsert_case1(suc(suc(X)), suc(zero), Y, Z, W)
186. toList(insertNat_case1_case1(true, X, Y, nil_1, nil_1, Z, W)) -> toList(insertNat_case1(true, Y, X, nil_1, nil_1, W, Z))
187. toList(prop_InsertInsert_case1(suc(X), zero, nil, Y, Z)) -> toList(prop_InsertInsert_case1(zero, suc(X), nil, Z, Y))
188. opEqTildeEqNatNat(nil_1, prop_InsertInsert_case1(zero, suc(X), nil, Y, Z)) -> false
189. opEqTildeEqNatNat(prop_InsertInsert_case1(zero, suc(X), nil, Y, Z), nil_1) -> false
190. foldr(X, snd(Y), cons(Z, cons(fst(Y), nil))) = uncurry(X, pair(Z, uncurry(X, Y)))
191. opAnd(eqPairNatNat(pair(X, Y), pair(Z, W)), true) -> opEqTildeEqNatNat(insertNat(X, Y, nil_1), insertNat(Z, W, nil_1))
192. opEqTildeEqNatNat(insertNat(zero, X, nil_1), insertNat(suc(Y), Z, nil_1)) -> false
193. opEqTildeEqNatNat(insertNat(suc(X), Y, nil_1), insertNat(zero, Z, nil_1)) -> false
194. opEqTildeEqNatNat(insertNat(zero, X, nil_1), insertNat(zero, Y, nil_1)) -> opAnd(eqNat(X, Y), true)
195. eqListPairNatNat(toList(branch(nil_1, X, Y, Z)), cons(W, V)) -> opAnd(eqPairNatNat(pair(X, Y), W), eqListPairNatNat(toList(Z), V))
196. eqListPairNatNat(cons(X, Y), toList(branch(nil_1, Z, W, V))) -> opAnd(eqPairNatNat(X, pair(Z, W)), eqListPairNatNat(Y, toList(V)))
197. prop_InsertInsert(pair(zero, X), pair(zero, Y), nil) -> opAnd(eqNat(Y, X), true)
198. equals(opAnd(eqNat(X, Y), true), false) -> false
199. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (toList_1): toList(leaf) = nil.
Axiom 5 (opAnd_2): opAnd(true, X) = X.
Axiom 6 (opAnd_1): opAnd(false, X) = false.
Axiom 7 (opAppend_1): opAppend(nil, X) = X.
Axiom 8 (eqListPairNatNat_1): eqListPairNatNat(nil, nil) = true.
Axiom 9 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 10 (eqNat_1): eqNat(zero, zero) = true.
Axiom 11 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 12 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 13 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 14 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 15 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 16 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 17 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 18 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 19 (prop_InsertInsert_case1_case1_1): prop_InsertInsert_case1_case1(true, X, Y, Z, W, V) = insertNat(X, W, tree(Z)).
Axiom 20 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 21 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 22 (insertNat_case1_case1_2): insertNat_case1_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, W).
Axiom 23 (prop_InsertInsert_case1_1): prop_InsertInsert_case1(X, Y, Z, W, V) = prop_InsertInsert_case1_case1(eqNat(X, Y), X, Y, Z, W, V).
Axiom 24 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 25 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = insertNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V, U).
Axiom 26 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 27 (prop_InsertInsert_1): prop_InsertInsert(pair(X, Y), pair(Z, W), V) = opEqTildeEqNatNat(insertNat(X, Y, insertNat(Z, W, tree(V))), prop_InsertInsert_case1(X, Z, V, Y, W)).

Lemma 28: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 15 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 14 (foldr_1) }
  nil_1

Lemma 29: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 4 (toList_1) }
  nil

Lemma 30: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 16 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 31: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 29 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by axiom 7 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(nil_1)))
= { by axiom 18 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(nil_1))
= { by axiom 7 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by lemma 29 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by axiom 26 (toList_2) R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 30 }
  toList(insertNat(X, Y, nil_1))

Goal 1 (prop_InsertInsert): prop_InsertInsert(X, Y, Z) = false.
The goal is true when:
  X = pair(zero, suc(X))
  Y = pair(zero, zero)
  Z = nil

Proof:
  prop_InsertInsert(pair(zero, suc(X)), pair(zero, zero), nil)
= { by axiom 27 (prop_InsertInsert_1) }
  opEqTildeEqNatNat(insertNat(zero, suc(X), insertNat(zero, zero, tree(nil))), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by lemma 28 }
  opEqTildeEqNatNat(insertNat(zero, suc(X), insertNat(zero, zero, nil_1)), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by lemma 30 R->L }
  opEqTildeEqNatNat(insertNat(zero, suc(X), branch(nil_1, zero, zero, nil_1)), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 24 (insertNat_2) }
  opEqTildeEqNatNat(insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 12 (ltNat_1) }
  opEqTildeEqNatNat(insertNat_case1(isLT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 9 (compareNat_1) }
  opEqTildeEqNatNat(insertNat_case1(isLT(eq), zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 2 (isLT_2) }
  opEqTildeEqNatNat(insertNat_case1(false, zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 25 (insertNat_case1_2) }
  opEqTildeEqNatNat(insertNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 13 (gtNat_1) }
  opEqTildeEqNatNat(insertNat_case1_case1(isGT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 9 (compareNat_1) }
  opEqTildeEqNatNat(insertNat_case1_case1(isGT(eq), zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 3 (isGT_2) }
  opEqTildeEqNatNat(insertNat_case1_case1(false, zero, zero, nil_1, nil_1, suc(X), zero), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 22 (insertNat_case1_case1_2) }
  opEqTildeEqNatNat(branch(nil_1, zero, zero, nil_1), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by lemma 30 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), prop_InsertInsert_case1(zero, zero, nil, suc(X), zero))
= { by axiom 23 (prop_InsertInsert_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), prop_InsertInsert_case1_case1(eqNat(zero, zero), zero, zero, nil, suc(X), zero))
= { by axiom 10 (eqNat_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), prop_InsertInsert_case1_case1(true, zero, zero, nil, suc(X), zero))
= { by axiom 19 (prop_InsertInsert_case1_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat(zero, suc(X), tree(nil)))
= { by lemma 28 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat(zero, suc(X), nil_1))
= { by axiom 17 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(insertNat(zero, suc(X), nil_1)))
= { by lemma 31 R->L }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), cons(pair(zero, suc(X)), nil))
= { by lemma 31 R->L }
  eqListPairNatNat(cons(pair(zero, zero), nil), cons(pair(zero, suc(X)), nil))
= { by axiom 21 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, suc(X))), eqListPairNatNat(nil, nil))
= { by axiom 8 (eqListPairNatNat_1) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, suc(X))), true)
= { by axiom 20 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(zero, zero), eqNat(zero, suc(X))), true)
= { by axiom 10 (eqNat_1) }
  opAnd(opAnd(true, eqNat(zero, suc(X))), true)
= { by axiom 5 (opAnd_2) }
  opAnd(eqNat(zero, suc(X)), true)
= { by axiom 11 (eqNat_2) }
  opAnd(false, true)
= { by axiom 6 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
