5009. insertNat(zero, X, join(deleteNat_case1(false, suc(Y), zero, Z, W, V), insertNat(U, T, nil_1))) -> join(deleteNat_case1(false, suc(Y), zero, Z, W, V), insertNat(U, T, nil_1))
5010. deleteNat_case1(false, suc(zero), zero, X, branch(Y, zero, Z, branch(W, suc(zero), V, U)), T) -> branch(X, zero, T, branch(Y, zero, Z, join(W, U)))
5011. deleteNat_case1(false, suc(X), zero, Y, branch(Z, zero, W, branch(V, zero, U, nil_1)), T) -> branch(Y, zero, T, branch(Z, zero, W, branch(V, zero, U, nil_1)))
5012. opEqTildeEqNatNat(insertNat(zero, X, prop_InsertDelete_case1_case1(false, Y, zero, nil, Z)), insertNat(zero, X, insertNat(Y, Z, nil_1))) -> prop_InsertDelete(pair(zero, X), zero, toList(insertNat(Y, Z, nil_1)))
5013. prop_InsertDelete(pair(zero, X), zero, toList(insertNat(zero, Y, nil_1))) -> opAnd(eqNat(X, Y), true)
5014. equals(opAnd(eqNat(X, Y), true), false) -> false
5015. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (toList_1): toList(leaf) = nil.
Axiom 5 (opAnd_2): opAnd(true, X) = X.
Axiom 6 (opAnd_1): opAnd(false, X) = false.
Axiom 7 (opAppend_1): opAppend(nil, X) = X.
Axiom 8 (join_1): join(leaf, X) = X.
Axiom 9 (eqListPairNatNat_1): eqListPairNatNat(nil, nil) = true.
Axiom 10 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 11 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 12 (eqNat_1): eqNat(zero, zero) = true.
Axiom 13 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 14 (fst_1): fst(pair(X, Y)) = X.
Axiom 15 (snd_1): snd(pair(X, Y)) = Y.
Axiom 16 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 17 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 18 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 19 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 20 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 21 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 22 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 23 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 24 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 25 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 26 (prop_InsertDelete_case1_case1_1): prop_InsertDelete_case1_case1(true, X, Y, Z, W) = insertNat(X, W, tree(Z)).
Axiom 27 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 28 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 29 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 30 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 31 (prop_InsertDelete_case1_1): prop_InsertDelete_case1(X, Y, Z, W) = prop_InsertDelete_case1_case1(eqNat(X, Y), X, Y, Z, W).
Axiom 32 (insertNat_case1_case1_2): insertNat_case1_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, W).
Axiom 33 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 34 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 35 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 36 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 37 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = insertNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V, U).
Axiom 38 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 39 (prop_InsertDelete_1): prop_InsertDelete(pair(X, Y), Z, W) = opEqTildeEqNatNat(insertNat(X, Y, deleteNat(Z, tree(W))), prop_InsertDelete_case1(X, Z, W, Y)).

Lemma 40: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 4 (toList_1) }
  nil

Lemma 41: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 16 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 10 (compareNat_1) }
  isLT(eq)
= { by axiom 2 (isLT_2) }
  false

Lemma 42: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 17 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 10 (compareNat_1) }
  isGT(eq)
= { by axiom 3 (isGT_2) }
  false

Lemma 43: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 15 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 14 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 30 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 44: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 25 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 45: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 40 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by axiom 7 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(nil_1)))
= { by axiom 24 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(nil_1))
= { by axiom 7 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by lemma 40 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by axiom 38 (toList_2) R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 44 }
  toList(insertNat(X, Y, nil_1))

Lemma 46: tree(cons(pair(X, Y), nil)) = insertNat(X, Y, nil_1).
Proof:
  tree(cons(pair(X, Y), nil))
= { by axiom 21 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 33 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 21 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 43 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by axiom 21 (tree_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), foldr(uncurry_1(insertNat_0), nil_1, nil)))
= { by axiom 18 (foldr_1) }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 43 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 19 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 30 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 11 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 20 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 14 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 15 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 23 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Goal 1 (prop_InsertDelete): prop_InsertDelete(X, Y, Z) = false.
The goal is true when:
  X = pair(zero, zero)
  Y = zero
  Z = toList(insertNat(zero, suc(X), nil_1))

Proof:
  prop_InsertDelete(pair(zero, zero), zero, toList(insertNat(zero, suc(X), nil_1)))
= { by axiom 39 (prop_InsertDelete_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1))))), prop_InsertDelete_case1(zero, zero, toList(insertNat(zero, suc(X), nil_1)), zero))
= { by lemma 45 R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1))))), prop_InsertDelete_case1(zero, zero, cons(pair(zero, suc(X)), nil), zero))
= { by axiom 31 (prop_InsertDelete_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1))))), prop_InsertDelete_case1_case1(eqNat(zero, zero), zero, zero, cons(pair(zero, suc(X)), nil), zero))
= { by axiom 12 (eqNat_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1))))), prop_InsertDelete_case1_case1(true, zero, zero, cons(pair(zero, suc(X)), nil), zero))
= { by axiom 26 (prop_InsertDelete_case1_case1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1))))), insertNat(zero, zero, tree(cons(pair(zero, suc(X)), nil))))
= { by lemma 46 }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1))))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 45 R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, tree(cons(pair(zero, suc(X)), nil)))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 46 }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, insertNat(zero, suc(X), nil_1))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 44 R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat(zero, branch(nil_1, zero, suc(X), nil_1))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by axiom 34 (deleteNat_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, suc(X))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 41 }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat_case1(false, zero, zero, nil_1, nil_1, suc(X))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by axiom 35 (deleteNat_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, nil_1, suc(X))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 42 }
  opEqTildeEqNatNat(insertNat(zero, zero, deleteNat_case1_case1(false, zero, zero, nil_1, nil_1, suc(X))), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by axiom 27 (deleteNat_case1_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, join(nil_1, nil_1)), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, join(leaf, nil_1)), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by axiom 8 (join_1) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 44 R->L }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat(zero, zero, branch(nil_1, zero, suc(X), nil_1)))
= { by axiom 36 (insertNat_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, zero, suc(X)))
= { by lemma 41 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat_case1(false, zero, zero, nil_1, nil_1, zero, suc(X)))
= { by axiom 37 (insertNat_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, nil_1, zero, suc(X)))
= { by lemma 42 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat_case1_case1(false, zero, zero, nil_1, nil_1, zero, suc(X)))
= { by axiom 32 (insertNat_case1_case1_2) }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), branch(nil_1, zero, suc(X), nil_1))
= { by lemma 44 }
  opEqTildeEqNatNat(insertNat(zero, zero, nil_1), insertNat(zero, suc(X), nil_1))
= { by axiom 22 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), toList(insertNat(zero, suc(X), nil_1)))
= { by lemma 45 R->L }
  eqListPairNatNat(toList(insertNat(zero, zero, nil_1)), cons(pair(zero, suc(X)), nil))
= { by lemma 45 R->L }
  eqListPairNatNat(cons(pair(zero, zero), nil), cons(pair(zero, suc(X)), nil))
= { by axiom 29 (eqListPairNatNat_4) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, suc(X))), eqListPairNatNat(nil, nil))
= { by axiom 9 (eqListPairNatNat_1) }
  opAnd(eqPairNatNat(pair(zero, zero), pair(zero, suc(X))), true)
= { by axiom 28 (eqPairNatNat_1) }
  opAnd(opAnd(eqNat(zero, zero), eqNat(zero, suc(X))), true)
= { by axiom 12 (eqNat_1) }
  opAnd(opAnd(true, eqNat(zero, suc(X))), true)
= { by axiom 5 (opAnd_2) }
  opAnd(eqNat(zero, suc(X)), true)
= { by axiom 13 (eqNat_2) }
  opAnd(false, true)
= { by axiom 6 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
