5029. opEqTildeEqNatNat(unionNat(deleteNat(X, insertNat(Y, Z, nil_1)), insertNat(X, W, nil_1)), insertNat(X, W, insertNat(Y, Z, nil_1))) -> prop_UnionDeleteInsert(toList(insertNat(Y, Z, nil_1)), nil, pair(X, W))
5030. prop_UnionDeleteInsert(toList(insertNat(zero, X, nil_1)), nil, pair(zero, Y)) -> opAnd(eqNat(Y, X), true)
5031. equals(opAnd(eqNat(X, Y), true), false) -> false
5032. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_2): isLT(eq) = false.
Axiom 3 (isGT_2): isGT(eq) = false.
Axiom 4 (toList_1): toList(leaf) = nil.
Axiom 5 (opAnd_2): opAnd(true, X) = X.
Axiom 6 (opAnd_1): opAnd(false, X) = false.
Axiom 7 (opAppend_1): opAppend(nil, X) = X.
Axiom 8 (join_1): join(leaf, X) = X.
Axiom 9 (eqListPairNatNat_1): eqListPairNatNat(nil, nil) = true.
Axiom 10 (unionNat_1): unionNat(leaf, X) = X.
Axiom 11 (eqNat_1): eqNat(zero, zero) = true.
Axiom 12 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 13 (app_insertNat_0_1): app(insertNat_0, X) = insertNat_1(X).
Axiom 14 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 15 (fst_1): fst(pair(X, Y)) = X.
Axiom 16 (snd_1): snd(pair(X, Y)) = Y.
Axiom 17 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 18 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 19 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 20 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 21 (app_insertNat_1_1): app(insertNat_1(X), Y) = insertNat_2(X, Y).
Axiom 22 (tree_1): tree(X) = foldr(uncurry_1(insertNat_0), nil_1, X).
Axiom 23 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 24 (app_insertNat_2_1): app(insertNat_2(X, Y), Z) = insertNat(X, Y, Z).
Axiom 25 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 26 (insertNat_1): insertNat(X, Y, leaf) = branch(leaf, X, Y, leaf).
Axiom 27 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 28 (eqPairNatNat_1): eqPairNatNat(pair(X, Y), pair(Z, W)) = opAnd(eqNat(X, Z), eqNat(Y, W)).
Axiom 29 (eqListPairNatNat_4): eqListPairNatNat(cons(X, Y), cons(Z, W)) = opAnd(eqPairNatNat(X, Z), eqListPairNatNat(Y, W)).
Axiom 30 (unionNat_2): unionNat(branch(X, Y, Z, W), leaf) = branch(X, Y, Z, W).
Axiom 31 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 32 (insertNat_case1_case1_2): insertNat_case1_case1(false, X, Y, Z, W, V, U) = branch(Z, Y, U, W).
Axiom 33 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 34 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 35 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 36 (insertNat_2): insertNat(X, Y, branch(Z, W, V, U)) = insertNat_case1(ltNat(X, W), X, W, Z, U, Y, V).
Axiom 37 (insertNat_case1_2): insertNat_case1(false, X, Y, Z, W, V, U) = insertNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V, U).
Axiom 38 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 39 (prop_UnionDeleteInsert_1): prop_UnionDeleteInsert(X, Y, pair(Z, W)) = opEqTildeEqNatNat(unionNat(deleteNat(Z, tree(X)), insertNat(Z, W, tree(Y))), insertNat(Z, W, unionNat(tree(X), tree(Y)))).

Lemma 40: tree(nil) = nil_1.
Proof:
  tree(nil)
= { by axiom 22 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, nil)
= { by axiom 17 (foldr_1) }
  nil_1

Lemma 41: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 4 (toList_1) }
  nil

Lemma 42: ltNat(zero, zero) = false.
Proof:
  ltNat(zero, zero)
= { by axiom 18 (ltNat_1) }
  isLT(compareNat(zero, zero))
= { by axiom 14 (compareNat_1) }
  isLT(eq)
= { by axiom 2 (isLT_2) }
  false

Lemma 43: gtNat(zero, zero) = false.
Proof:
  gtNat(zero, zero)
= { by axiom 19 (gtNat_1) }
  isGT(compareNat(zero, zero))
= { by axiom 14 (compareNat_1) }
  isGT(eq)
= { by axiom 3 (isGT_2) }
  false

Lemma 44: app(app(X, Y), Z) = uncurry(X, pair(Y, Z)).
Proof:
  app(app(X, Y), Z)
= { by axiom 16 (snd_1) R->L }
  app(app(X, Y), snd(pair(Y, Z)))
= { by axiom 15 (fst_1) R->L }
  app(app(X, fst(pair(Y, Z))), snd(pair(Y, Z)))
= { by axiom 31 (uncurry_1) R->L }
  uncurry(X, pair(Y, Z))

Lemma 45: branch(nil_1, X, Y, nil_1) = insertNat(X, Y, nil_1).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 26 (insertNat_1) R->L }
  insertNat(X, Y, leaf)
= { by axiom 1 (nil_1_1) R->L }
  insertNat(X, Y, nil_1)

Lemma 46: cons(pair(X, Y), nil) = toList(insertNat(X, Y, nil_1)).
Proof:
  cons(pair(X, Y), nil)
= { by lemma 41 R->L }
  cons(pair(X, Y), toList(nil_1))
= { by axiom 7 (opAppend_1) R->L }
  cons(pair(X, Y), opAppend(nil, toList(nil_1)))
= { by axiom 25 (opAppend_2) R->L }
  opAppend(cons(pair(X, Y), nil), toList(nil_1))
= { by axiom 7 (opAppend_1) R->L }
  opAppend(nil, opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by lemma 41 R->L }
  opAppend(toList(nil_1), opAppend(cons(pair(X, Y), nil), toList(nil_1)))
= { by axiom 38 (toList_2) R->L }
  toList(branch(nil_1, X, Y, nil_1))
= { by lemma 45 }
  toList(insertNat(X, Y, nil_1))

Lemma 47: tree(toList(insertNat(X, Y, nil_1))) = insertNat(X, Y, nil_1).
Proof:
  tree(toList(insertNat(X, Y, nil_1)))
= { by lemma 46 R->L }
  tree(cons(pair(X, Y), nil))
= { by axiom 22 (tree_1) }
  foldr(uncurry_1(insertNat_0), nil_1, cons(pair(X, Y), nil))
= { by axiom 33 (foldr_2) }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), foldr(uncurry_1(insertNat_0), nil_1, nil))
= { by axiom 22 (tree_1) R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), tree(nil))
= { by lemma 44 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), tree(nil)))
= { by lemma 40 }
  uncurry(uncurry_1(insertNat_0), pair(pair(X, Y), nil_1))
= { by lemma 44 R->L }
  app(app(uncurry_1(insertNat_0), pair(X, Y)), nil_1)
= { by axiom 20 (app_uncurry_1_1) }
  app(uncurry(insertNat_0, pair(X, Y)), nil_1)
= { by axiom 31 (uncurry_1) }
  app(app(app(insertNat_0, fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 13 (app_insertNat_0_1) }
  app(app(insertNat_1(fst(pair(X, Y))), snd(pair(X, Y))), nil_1)
= { by axiom 21 (app_insertNat_1_1) }
  app(insertNat_2(fst(pair(X, Y)), snd(pair(X, Y))), nil_1)
= { by axiom 15 (fst_1) }
  app(insertNat_2(X, snd(pair(X, Y))), nil_1)
= { by axiom 16 (snd_1) }
  app(insertNat_2(X, Y), nil_1)
= { by axiom 24 (app_insertNat_2_1) }
  insertNat(X, Y, nil_1)

Goal 1 (prop_UnionDeleteInsert): prop_UnionDeleteInsert(X, Y, Z) = false.
The goal is true when:
  X = toList(insertNat(zero, suc(X), nil_1))
  Y = nil
  Z = pair(zero, zero)

Proof:
  prop_UnionDeleteInsert(toList(insertNat(zero, suc(X), nil_1)), nil, pair(zero, zero))
= { by axiom 39 (prop_UnionDeleteInsert_1) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1)))), insertNat(zero, zero, tree(nil))), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, suc(X), nil_1))), tree(nil))))
= { by lemma 40 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1)))), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, suc(X), nil_1))), tree(nil))))
= { by lemma 40 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, tree(toList(insertNat(zero, suc(X), nil_1)))), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, suc(X), nil_1))), nil_1)))
= { by lemma 47 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, suc(X), nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(tree(toList(insertNat(zero, suc(X), nil_1))), nil_1)))
= { by lemma 47 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, suc(X), nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(insertNat(zero, suc(X), nil_1), nil_1)))
= { by lemma 45 R->L }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, suc(X), nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(branch(nil_1, zero, suc(X), nil_1), nil_1)))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, suc(X), nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, unionNat(branch(nil_1, zero, suc(X), nil_1), leaf)))
= { by axiom 30 (unionNat_2) }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, suc(X), nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, branch(nil_1, zero, suc(X), nil_1)))
= { by lemma 45 }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, insertNat(zero, suc(X), nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 45 R->L }
  opEqTildeEqNatNat(unionNat(deleteNat(zero, branch(nil_1, zero, suc(X), nil_1)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by axiom 34 (deleteNat_2) }
  opEqTildeEqNatNat(unionNat(deleteNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, suc(X)), insertNat(zero, zero, nil_1)), insertNat(zero, zero, insertNat(zero, suc(X), nil_1)))
= { by lemma 42 }
