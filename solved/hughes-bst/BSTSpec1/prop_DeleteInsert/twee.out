454. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_1): isLT(lt) = true.
Axiom 3 (isLT_2): isLT(eq) = false.
Axiom 4 (isGT_2): isGT(eq) = false.
Axiom 5 (toList_1): toList(leaf) = nil.
Axiom 6 (opAppend_1): opAppend(nil, X) = X.
Axiom 7 (join_1): join(leaf, X) = X.
Axiom 8 (deleteNat_1): deleteNat(X, leaf) = leaf.
Axiom 9 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 10 (compareNat_2): compareNat(zero, suc(X)) = lt.
Axiom 11 (app_insert_0_1): app(insert_0, X) = insert_1(X).
Axiom 12 (eqNat_1): eqNat(zero, zero) = true.
Axiom 13 (fst_1): fst(pair(X, Y)) = X.
Axiom 14 (snd_1): snd(pair(X, Y)) = Y.
Axiom 15 (ltNat_1): ltNat(X, Y) = isLT(compareNat(X, Y)).
Axiom 16 (gtNat_1): gtNat(X, Y) = isGT(compareNat(X, Y)).
Axiom 17 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 18 (app_insert_1_1): app(insert_1(X), Y) = insert_2(X, Y).
Axiom 19 (tree_1): tree(X) = foldr(uncurry_1(insert_0), nil_1, X).
Axiom 20 (eqListPairNatNat_2): eqListPairNatNat(nil, cons(X, Y)) = false.
Axiom 21 (opEqTildeEqNatNat_1): opEqTildeEqNatNat(X, Y) = eqListPairNatNat(toList(X), toList(Y)).
Axiom 22 (app_insert_2_1): app(insert_2(X, Y), Z) = insert(X, Y, Z).
Axiom 23 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 24 (insert_1): insert(X, Y, Z) = branch(leaf, X, Y, leaf).
Axiom 25 (prop_DeleteInsert_case1_case1_1): prop_DeleteInsert_case1_case1(true, X, Y, Z, W) = deleteNat(X, tree(Z)).
Axiom 26 (deleteNat_case1_case1_2): deleteNat_case1_case1(false, X, Y, Z, W, V) = join(Z, W).
Axiom 27 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 28 (deleteNat_case1_1): deleteNat_case1(true, X, Y, Z, W, V) = branch(deleteNat(X, Z), Y, V, W).
Axiom 29 (prop_DeleteInsert_case1_1): prop_DeleteInsert_case1(X, Y, Z, W) = prop_DeleteInsert_case1_case1(eqNat(X, Y), X, Y, Z, W).
Axiom 30 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 31 (deleteNat_2): deleteNat(X, branch(Y, Z, W, V)) = deleteNat_case1(ltNat(X, Z), X, Z, Y, V, W).
Axiom 32 (deleteNat_case1_2): deleteNat_case1(false, X, Y, Z, W, V) = deleteNat_case1_case1(gtNat(X, Y), X, Y, Z, W, V).
Axiom 33 (toList_2): toList(branch(X, Y, Z, W)) = opAppend(toList(X), opAppend(cons(pair(Y, Z), nil), toList(W))).
Axiom 34 (prop_DeleteInsert_1): prop_DeleteInsert(X, pair(Y, Z), W) = opEqTildeEqNatNat(deleteNat(X, insert(Y, Z, tree(W))), prop_DeleteInsert_case1(X, Y, W, Z)).

Lemma 35: toList(nil_1) = nil.
Proof:
  toList(nil_1)
= { by axiom 1 (nil_1_1) }
  toList(leaf)
= { by axiom 5 (toList_1) }
  nil

Lemma 36: branch(nil_1, X, Y, nil_1) = insert(X, Y, Z).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 24 (insert_1) R->L }
  insert(X, Y, Z)

Goal 1 (prop_DeleteInsert): prop_DeleteInsert(X, Y, Z) = false.
The goal is true when:
  X = zero
  Y = pair(zero, V)
  Z = cons(pair(suc(X), Y), W)

Proof:
  prop_DeleteInsert(zero, pair(zero, V), cons(pair(suc(X), Y), W))
= { by axiom 34 (prop_DeleteInsert_1) }
  opEqTildeEqNatNat(deleteNat(zero, insert(zero, V, tree(cons(pair(suc(X), Y), W)))), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by lemma 36 R->L }
  opEqTildeEqNatNat(deleteNat(zero, branch(nil_1, zero, V, nil_1)), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 31 (deleteNat_2) }
  opEqTildeEqNatNat(deleteNat_case1(ltNat(zero, zero), zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 15 (ltNat_1) }
  opEqTildeEqNatNat(deleteNat_case1(isLT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 9 (compareNat_1) }
  opEqTildeEqNatNat(deleteNat_case1(isLT(eq), zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 3 (isLT_2) }
  opEqTildeEqNatNat(deleteNat_case1(false, zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 32 (deleteNat_case1_2) }
  opEqTildeEqNatNat(deleteNat_case1_case1(gtNat(zero, zero), zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 16 (gtNat_1) }
  opEqTildeEqNatNat(deleteNat_case1_case1(isGT(compareNat(zero, zero)), zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 9 (compareNat_1) }
  opEqTildeEqNatNat(deleteNat_case1_case1(isGT(eq), zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 4 (isGT_2) }
  opEqTildeEqNatNat(deleteNat_case1_case1(false, zero, zero, nil_1, nil_1, V), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 26 (deleteNat_case1_case1_2) }
  opEqTildeEqNatNat(join(nil_1, nil_1), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(join(leaf, nil_1), prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 7 (join_1) }
  opEqTildeEqNatNat(nil_1, prop_DeleteInsert_case1(zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 29 (prop_DeleteInsert_case1_1) }
  opEqTildeEqNatNat(nil_1, prop_DeleteInsert_case1_case1(eqNat(zero, zero), zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 12 (eqNat_1) }
  opEqTildeEqNatNat(nil_1, prop_DeleteInsert_case1_case1(true, zero, zero, cons(pair(suc(X), Y), W), V))
= { by axiom 25 (prop_DeleteInsert_case1_case1_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, tree(cons(pair(suc(X), Y), W))))
= { by axiom 19 (tree_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, foldr(uncurry_1(insert_0), nil_1, cons(pair(suc(X), Y), W))))
= { by axiom 30 (foldr_2) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(app(uncurry_1(insert_0), pair(suc(X), Y)), foldr(uncurry_1(insert_0), nil_1, W))))
= { by axiom 19 (tree_1) R->L }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(app(uncurry_1(insert_0), pair(suc(X), Y)), tree(W))))
= { by axiom 17 (app_uncurry_1_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(uncurry(insert_0, pair(suc(X), Y)), tree(W))))
= { by axiom 27 (uncurry_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(app(app(insert_0, fst(pair(suc(X), Y))), snd(pair(suc(X), Y))), tree(W))))
= { by axiom 11 (app_insert_0_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(app(insert_1(fst(pair(suc(X), Y))), snd(pair(suc(X), Y))), tree(W))))
= { by axiom 18 (app_insert_1_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(insert_2(fst(pair(suc(X), Y)), snd(pair(suc(X), Y))), tree(W))))
= { by axiom 13 (fst_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(insert_2(suc(X), snd(pair(suc(X), Y))), tree(W))))
= { by axiom 14 (snd_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, app(insert_2(suc(X), Y), tree(W))))
= { by axiom 22 (app_insert_2_1) }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, insert(suc(X), Y, tree(W))))
= { by lemma 36 R->L }
  opEqTildeEqNatNat(nil_1, deleteNat(zero, branch(nil_1, suc(X), Y, nil_1)))
= { by axiom 31 (deleteNat_2) }
  opEqTildeEqNatNat(nil_1, deleteNat_case1(ltNat(zero, suc(X)), zero, suc(X), nil_1, nil_1, Y))
= { by axiom 15 (ltNat_1) }
  opEqTildeEqNatNat(nil_1, deleteNat_case1(isLT(compareNat(zero, suc(X))), zero, suc(X), nil_1, nil_1, Y))
= { by axiom 10 (compareNat_2) }
  opEqTildeEqNatNat(nil_1, deleteNat_case1(isLT(lt), zero, suc(X), nil_1, nil_1, Y))
= { by axiom 2 (isLT_1) }
  opEqTildeEqNatNat(nil_1, deleteNat_case1(true, zero, suc(X), nil_1, nil_1, Y))
= { by axiom 28 (deleteNat_case1_1) }
  opEqTildeEqNatNat(nil_1, branch(deleteNat(zero, nil_1), suc(X), Y, nil_1))
= { by axiom 1 (nil_1_1) }
  opEqTildeEqNatNat(nil_1, branch(deleteNat(zero, leaf), suc(X), Y, nil_1))
= { by axiom 8 (deleteNat_1) }
  opEqTildeEqNatNat(nil_1, branch(leaf, suc(X), Y, nil_1))
= { by axiom 1 (nil_1_1) R->L }
  opEqTildeEqNatNat(nil_1, branch(nil_1, suc(X), Y, nil_1))
= { by lemma 36 }
  opEqTildeEqNatNat(nil_1, insert(suc(X), Y, Z))
= { by axiom 21 (opEqTildeEqNatNat_1) }
  eqListPairNatNat(toList(nil_1), toList(insert(suc(X), Y, Z)))
= { by lemma 35 }
  eqListPairNatNat(nil, toList(insert(suc(X), Y, Z)))
= { by lemma 36 R->L }
  eqListPairNatNat(nil, toList(branch(nil_1, suc(X), Y, nil_1)))
= { by axiom 33 (toList_2) }
  eqListPairNatNat(nil, opAppend(toList(nil_1), opAppend(cons(pair(suc(X), Y), nil), toList(nil_1))))
= { by lemma 35 }
  eqListPairNatNat(nil, opAppend(nil, opAppend(cons(pair(suc(X), Y), nil), toList(nil_1))))
= { by axiom 6 (opAppend_1) }
  eqListPairNatNat(nil, opAppend(cons(pair(suc(X), Y), nil), toList(nil_1)))
= { by axiom 23 (opAppend_2) }
  eqListPairNatNat(nil, cons(pair(suc(X), Y), opAppend(nil, toList(nil_1))))
= { by axiom 6 (opAppend_1) }
  eqListPairNatNat(nil, cons(pair(suc(X), Y), toList(nil_1)))
= { by lemma 35 }
  eqListPairNatNat(nil, cons(pair(suc(X), Y), nil))
= { by axiom 20 (eqListPairNatNat_2) }
  false

RESULT: Theorem (the conjecture is true).
