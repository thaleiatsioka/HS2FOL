5663. foldr(flip_2(flip_0, X), insert_1(Y), cons(flip_2(flip_0, Z), cons(flip_2(flip_0, Z), nil))) = flip(insert(Y, X, ?), Z, X)
5664. opApply(foldl(insert_1(fst(X)), Y, cons(?, cons(?, nil))), Z) = flip(insert_2(fst(X), uncurry(flip_2(insert_0, Y), X)), Z, ?)
5665. uncurry(uncurry(insert_0, foldr(flip_2(flip_0, snd(X)), Y, Z)), X) = foldr(flip_2(flip_0, snd(X)), Y, cons(flip_2(uncurry_1(insert_0), ?), Z))
