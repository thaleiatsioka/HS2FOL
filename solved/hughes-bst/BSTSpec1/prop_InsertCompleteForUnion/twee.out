5682. branch(belowNat(X, branch(Y, Z, W, V)), X, U, aboveNat(X, branch(Y, Z, W, V))) -> unionNat(insert(X, U, ?), branch(Y, Z, W, V))
5683. branch(belowNat(X, insert(Y, Z, ?)), X, W, aboveNat(X, insert(Y, Z, ?))) -> unionNat(insert(X, W, ?), insert(Y, Z, ?))
5684. unionNat(insert(suc(zero), X, ?), insert(suc(zero), Y, ?)) -> insert(suc(zero), X, ?)
5685. unionNat(insert(zero, X, ?), insert(suc(Y), Z, ?)) -> branch(nil_1, zero, X, insert(suc(Y), Z, ?))
5686. unionNat(insert(suc(X), Y, ?), insert(zero, Z, ?)) -> branch(insert(zero, Z, ?), suc(X), Y, nil_1)
5687. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (nil_1_1): nil_1 = leaf.
Axiom 2 (isLT_3): isLT(gt) = false.
Axiom 3 (isGT_3): isGT(gt) = true.
Axiom 4 (not_2): not(true) = false.
Axiom 5 (not_1): not(false) = true.
Axiom 6 (insertions_1): insertions(leaf) = nil.
Axiom 7 (opAppend_1): opAppend(nil, X) = X.
Axiom 8 (opAnd_1): opAnd(false, X) = false.
Axiom 9 (belowNat_1): belowNat(X, leaf) = leaf.
Axiom 10 (aboveNat_1): aboveNat(X, leaf) = leaf.
Axiom 11 (unionNat_1): unionNat(leaf, X) = X.
Axiom 12 (compareNat_3): compareNat(suc(X), zero) = gt.
Axiom 13 (opApply_1): opApply(X, Y) = app(X, Y).
Axiom 14 (app_flip_0_1): app(flip_0, X) = flip_1(X).
Axiom 15 (app_insert_0_1): app(insert_0, X) = insert_1(X).
Axiom 16 (fst_1): fst(pair(X, Y)) = X.
Axiom 17 (snd_1): snd(pair(X, Y)) = Y.
Axiom 18 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 19 (foldl_1): foldl(X, Y, nil) = Y.
Axiom 20 (app_flip_1_1): app(flip_1(X), Y) = flip_2(X, Y).
Axiom 21 (app_insert_1_1): app(insert_1(X), Y) = insert_2(X, Y).
Axiom 22 (app_uncurry_1_1): app(uncurry_1(X), Y) = uncurry(X, Y).
Axiom 23 (geNat_1): geNat(X, Y) = not(isLT(compareNat(X, Y))).
Axiom 24 (leNat_1): leNat(X, Y) = not(isGT(compareNat(X, Y))).
Axiom 25 (tree_1): tree(X) = foldr(uncurry_1(insert_0), nil_1, X).
Axiom 26 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
Axiom 27 (app_flip_2_1): app(flip_2(X, Y), Z) = flip(X, Y, Z).
Axiom 28 (app_insert_2_1): app(insert_2(X, Y), Z) = insert(X, Y, Z).
Axiom 29 (flip_1): flip(X, Y, Z) = app(app(X, Z), Y).
Axiom 30 (insert_1): insert(X, Y, Z) = branch(leaf, X, Y, leaf).
Axiom 31 (prop_InsertCompleteForUnion_1): prop_InsertCompleteForUnion(X, Y) = insertComplete(unionNat(tree(X), tree(Y))).
Axiom 32 (aboveNat_case1_1): aboveNat_case1(true, X, Y, Z, W, V) = aboveNat(X, W).
Axiom 33 (eqBSTNatNat_3): eqBSTNatNat(branch(X, Y, Z, W), leaf) = false.
Axiom 34 (uncurry_1): uncurry(X, Y) = app(app(X, fst(Y)), snd(Y)).
Axiom 35 (belowNat_case1_2): belowNat_case1(false, X, Y, Z, W, V) = branch(Z, Y, V, belowNat(X, W)).
Axiom 36 (foldl_2): foldl(X, Y, cons(Z, W)) = foldl(X, app(app(X, Y), Z), W).
Axiom 37 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).
Axiom 38 (belowNat_2): belowNat(X, branch(Y, Z, W, V)) = belowNat_case1(leNat(X, Z), X, Z, Y, V, W).
Axiom 39 (aboveNat_2): aboveNat(X, branch(Y, Z, W, V)) = aboveNat_case1(geNat(X, Z), X, Z, Y, V, W).
Axiom 40 (insertions_2): insertions(branch(X, Y, Z, W)) = cons(pair(Y, Z), opAppend(insertions(X), insertions(W))).
Axiom 41 (insertComplete_1): insertComplete(X) = eqBSTNatNat(X, foldl(opApply(flip_0, uncurry_1(insert_0)), nil_1, insertions(X))).
Axiom 42 (eqBSTNatNat_4): eqBSTNatNat(branch(X, Y, Z, W), branch(V, U, T, S)) = opAnd(eqBSTNatNat(X, V), opAnd(eqNat(Y, U), opAnd(eqNat(Z, T), eqBSTNatNat(W, S)))).
Axiom 43 (unionNat_3): unionNat(branch(X, Y, Z, W), branch(V, U, T, S)) = branch(unionNat(X, belowNat(Y, branch(V, U, T, S))), Y, Z, unionNat(W, aboveNat(Y, branch(V, U, T, S)))).

Lemma 44: insertions(nil_1) = nil.
Proof:
  insertions(nil_1)
= { by axiom 1 (nil_1_1) }
  insertions(leaf)
= { by axiom 6 (insertions_1) }
  nil

Lemma 45: opApply(insert_0, X) = insert_1(X).
Proof:
  opApply(insert_0, X)
= { by axiom 13 (opApply_1) }
  app(insert_0, X)
= { by axiom 15 (app_insert_0_1) }
  insert_1(X)

Lemma 46: unionNat(nil_1, X) = X.
Proof:
  unionNat(nil_1, X)
= { by axiom 1 (nil_1_1) }
  unionNat(leaf, X)
= { by axiom 11 (unionNat_1) }
  X

Lemma 47: opApply(insert_1(X), Y) = insert_2(X, Y).
Proof:
  opApply(insert_1(X), Y)
= { by axiom 13 (opApply_1) }
  app(insert_1(X), Y)
= { by axiom 21 (app_insert_1_1) }
  insert_2(X, Y)

Lemma 48: insert(X, Y, W) = insert(X, Y, Z).
Proof:
  insert(X, Y, W)
= { by axiom 30 (insert_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 30 (insert_1) R->L }
  insert(X, Y, Z)

Lemma 49: opApply(opApply(X, Y), Z) = flip(X, Z, Y).
Proof:
  opApply(opApply(X, Y), Z)
= { by axiom 13 (opApply_1) }
  opApply(app(X, Y), Z)
= { by axiom 13 (opApply_1) }
  app(app(X, Y), Z)
= { by axiom 29 (flip_1) R->L }
  flip(X, Z, Y)

Lemma 50: opApply(uncurry(X, Y), Z) = flip(uncurry_1(X), Z, Y).
Proof:
  opApply(uncurry(X, Y), Z)
= { by axiom 22 (app_uncurry_1_1) R->L }
  opApply(app(uncurry_1(X), Y), Z)
= { by axiom 13 (opApply_1) R->L }
  opApply(opApply(uncurry_1(X), Y), Z)
= { by lemma 49 }
  flip(uncurry_1(X), Z, Y)

Lemma 51: flip(X, snd(Y), fst(Y)) = uncurry(X, Y).
Proof:
  flip(X, snd(Y), fst(Y))
= { by lemma 49 R->L }
  opApply(opApply(X, fst(Y)), snd(Y))
= { by axiom 13 (opApply_1) }
  opApply(app(X, fst(Y)), snd(Y))
= { by axiom 13 (opApply_1) }
  app(app(X, fst(Y)), snd(Y))
= { by axiom 34 (uncurry_1) R->L }
  uncurry(X, Y)

Lemma 52: insert_2(fst(X), snd(X)) = uncurry(insert_0, X).
Proof:
  insert_2(fst(X), snd(X))
= { by lemma 47 R->L }
  opApply(insert_1(fst(X)), snd(X))
= { by lemma 45 R->L }
  opApply(opApply(insert_0, fst(X)), snd(X))
= { by lemma 49 }
  flip(insert_0, snd(X), fst(X))
= { by lemma 51 }
  uncurry(insert_0, X)

Lemma 53: opApply(insert_2(X, Y), Z) = insert(X, Y, Z).
Proof:
  opApply(insert_2(X, Y), Z)
= { by axiom 13 (opApply_1) }
  app(insert_2(X, Y), Z)
= { by axiom 28 (app_insert_2_1) }
  insert(X, Y, Z)

Lemma 54: flip(uncurry_1(insert_0), Z, Y) = flip(uncurry_1(insert_0), X, Y).
Proof:
  flip(uncurry_1(insert_0), Z, Y)
= { by lemma 50 R->L }
  opApply(uncurry(insert_0, Y), Z)
= { by lemma 52 R->L }
  opApply(insert_2(fst(Y), snd(Y)), Z)
= { by lemma 53 }
  insert(fst(Y), snd(Y), Z)
= { by lemma 48 }
  insert(fst(Y), snd(Y), X)
= { by lemma 53 R->L }
  opApply(insert_2(fst(Y), snd(Y)), X)
= { by lemma 52 }
  opApply(uncurry(insert_0, Y), X)
= { by lemma 50 }
  flip(uncurry_1(insert_0), X, Y)

Lemma 55: flip(X, foldr(X, Y, Z), W) = foldr(X, Y, cons(W, Z)).
Proof:
  flip(X, foldr(X, Y, Z), W)
= { by lemma 49 R->L }
  opApply(opApply(X, W), foldr(X, Y, Z))
= { by axiom 13 (opApply_1) }
  opApply(app(X, W), foldr(X, Y, Z))
= { by axiom 13 (opApply_1) }
  app(app(X, W), foldr(X, Y, Z))
= { by axiom 37 (foldr_2) R->L }
  foldr(X, Y, cons(W, Z))

Lemma 56: flip(uncurry_1(insert_0), nil_1, X) = tree(cons(X, nil)).
Proof:
  flip(uncurry_1(insert_0), nil_1, X)
= { by axiom 18 (foldr_1) R->L }
  flip(uncurry_1(insert_0), foldr(uncurry_1(insert_0), nil_1, nil), X)
= { by lemma 55 }
  foldr(uncurry_1(insert_0), nil_1, cons(X, nil))
= { by axiom 25 (tree_1) R->L }
  tree(cons(X, nil))

Lemma 57: flip(flip_1(X), Y, Z) = flip(X, Z, Y).
Proof:
  flip(flip_1(X), Y, Z)
= { by lemma 49 R->L }
  opApply(opApply(flip_1(X), Z), Y)
= { by axiom 13 (opApply_1) }
  opApply(app(flip_1(X), Z), Y)
= { by axiom 20 (app_flip_1_1) }
  opApply(flip_2(X, Z), Y)
= { by axiom 13 (opApply_1) }
  app(flip_2(X, Z), Y)
= { by axiom 27 (app_flip_2_1) }
  flip(X, Z, Y)

Lemma 58: flip(insert_1(X), Y, Z) = insert(X, Z, W).
Proof:
  flip(insert_1(X), Y, Z)
= { by lemma 49 R->L }
  opApply(opApply(insert_1(X), Z), Y)
= { by lemma 47 }
  opApply(insert_2(X, Z), Y)
= { by lemma 53 }
  insert(X, Z, Y)
= { by lemma 48 R->L }
  insert(X, Z, W)

Lemma 59: uncurry(X, pair(Y, Z)) = flip(X, Z, Y).
Proof:
  uncurry(X, pair(Y, Z))
= { by lemma 51 R->L }
  flip(X, snd(pair(Y, Z)), fst(pair(Y, Z)))
= { by axiom 16 (fst_1) }
  flip(X, snd(pair(Y, Z)), Y)
= { by axiom 17 (snd_1) }
  flip(X, Z, Y)

Lemma 60: opAppend(cons(X, nil), Y) = cons(X, Y).
Proof:
  opAppend(cons(X, nil), Y)
= { by axiom 26 (opAppend_2) }
  cons(X, opAppend(nil, Y))
= { by axiom 7 (opAppend_1) }
  cons(X, Y)

Lemma 61: insert(X, snd(Y), Z) = uncurry(flip_1(insert_1(X)), Y).
Proof:
  insert(X, snd(Y), Z)
= { by lemma 58 R->L }
  flip(insert_1(X), fst(Y), snd(Y))
= { by lemma 57 R->L }
  flip(flip_1(insert_1(X)), snd(Y), fst(Y))
= { by lemma 51 }
  uncurry(flip_1(insert_1(X)), Y)

Lemma 62: branch(nil_1, X, Y, nil_1) = insert(X, Y, Z).
Proof:
  branch(nil_1, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, nil_1)
= { by axiom 1 (nil_1_1) }
  branch(leaf, X, Y, leaf)
= { by axiom 30 (insert_1) R->L }
  insert(X, Y, Z)

Lemma 63: flip(uncurry_1(insert_0), tree(X), Y) = tree(cons(Y, X)).
Proof:
  flip(uncurry_1(insert_0), tree(X), Y)
= { by axiom 25 (tree_1) }
  flip(uncurry_1(insert_0), foldr(uncurry_1(insert_0), nil_1, X), Y)
= { by lemma 55 }
  foldr(uncurry_1(insert_0), nil_1, cons(Y, X))
= { by axiom 25 (tree_1) R->L }
  tree(cons(Y, X))

Lemma 64: tree(cons(pair(X, Y), Z)) = insert(X, Y, W).
Proof:
  tree(cons(pair(X, Y), Z))
= { by lemma 63 R->L }
  flip(uncurry_1(insert_0), tree(Z), pair(X, Y))
= { by lemma 54 R->L }
  flip(uncurry_1(insert_0), tree(nil), pair(X, Y))
= { by lemma 63 }
  tree(cons(pair(X, Y), nil))
= { by lemma 56 R->L }
  flip(uncurry_1(insert_0), nil_1, pair(X, Y))
= { by lemma 50 R->L }
  opApply(uncurry(insert_0, pair(X, Y)), nil_1)
= { by lemma 59 }
  opApply(flip(insert_0, Y, X), nil_1)
= { by lemma 49 R->L }
  opApply(opApply(opApply(insert_0, X), Y), nil_1)
= { by lemma 49 }
  flip(opApply(insert_0, X), nil_1, Y)
= { by lemma 45 }
  flip(insert_1(X), nil_1, Y)
= { by lemma 58 }
  insert(X, Y, W)

Lemma 65: opAppend(cons(pair(X, Y), insertions(Z)), insertions(W)) = insertions(branch(Z, X, Y, W)).
Proof:
  opAppend(cons(pair(X, Y), insertions(Z)), insertions(W))
= { by axiom 26 (opAppend_2) }
  cons(pair(X, Y), opAppend(insertions(Z), insertions(W)))
= { by axiom 40 (insertions_2) R->L }
  insertions(branch(Z, X, Y, W))

Lemma 66: foldl(flip_1(uncurry_1(insert_0)), X, cons(pair(Y, Z), W)) = foldl(flip_1(uncurry_1(insert_0)), insert(Y, Z, V), W).
Proof:
  foldl(flip_1(uncurry_1(insert_0)), X, cons(pair(Y, Z), W))
= { by axiom 36 (foldl_2) }
  foldl(flip_1(uncurry_1(insert_0)), app(app(flip_1(uncurry_1(insert_0)), X), pair(Y, Z)), W)
= { by axiom 13 (opApply_1) R->L }
  foldl(flip_1(uncurry_1(insert_0)), opApply(app(flip_1(uncurry_1(insert_0)), X), pair(Y, Z)), W)
= { by axiom 13 (opApply_1) R->L }
  foldl(flip_1(uncurry_1(insert_0)), opApply(opApply(flip_1(uncurry_1(insert_0)), X), pair(Y, Z)), W)
= { by lemma 49 }
  foldl(flip_1(uncurry_1(insert_0)), flip(flip_1(uncurry_1(insert_0)), pair(Y, Z), X), W)
= { by lemma 57 }
  foldl(flip_1(uncurry_1(insert_0)), flip(uncurry_1(insert_0), X, pair(Y, Z)), W)
= { by lemma 54 }
  foldl(flip_1(uncurry_1(insert_0)), flip(uncurry_1(insert_0), nil_1, pair(Y, Z)), W)
= { by lemma 56 }
  foldl(flip_1(uncurry_1(insert_0)), tree(cons(pair(Y, Z), nil)), W)
= { by lemma 64 }
  foldl(flip_1(uncurry_1(insert_0)), insert(Y, Z, V), W)

Goal 1 (prop_InsertCompleteForUnion): prop_InsertCompleteForUnion(X, Y) = false.
The goal is true when:
  X = cons(pair(suc(X), Y), U2)
  Y = cons(pair(zero, W), V2)

Proof:
  prop_InsertCompleteForUnion(cons(pair(suc(X), Y), U2), cons(pair(zero, W), V2))
= { by axiom 31 (prop_InsertCompleteForUnion_1) }
  insertComplete(unionNat(tree(cons(pair(suc(X), Y), U2)), tree(cons(pair(zero, W), V2))))
= { by lemma 64 }
  insertComplete(unionNat(insert(suc(X), Y, Z2), tree(cons(pair(zero, W), V2))))
= { by lemma 64 }
  insertComplete(unionNat(insert(suc(X), Y, Z2), insert(zero, W, W2)))
= { by lemma 62 R->L }
  insertComplete(unionNat(insert(suc(X), Y, Z2), branch(nil_1, zero, W, nil_1)))
= { by lemma 62 R->L }
  insertComplete(unionNat(branch(nil_1, suc(X), Y, nil_1), branch(nil_1, zero, W, nil_1)))
= { by axiom 43 (unionNat_3) }
  insertComplete(branch(unionNat(nil_1, belowNat(suc(X), branch(nil_1, zero, W, nil_1))), suc(X), Y, unionNat(nil_1, aboveNat(suc(X), branch(nil_1, zero, W, nil_1)))))
= { by lemma 46 }
  insertComplete(branch(belowNat(suc(X), branch(nil_1, zero, W, nil_1)), suc(X), Y, unionNat(nil_1, aboveNat(suc(X), branch(nil_1, zero, W, nil_1)))))
= { by lemma 46 }
  insertComplete(branch(belowNat(suc(X), branch(nil_1, zero, W, nil_1)), suc(X), Y, aboveNat(suc(X), branch(nil_1, zero, W, nil_1))))
= { by lemma 62 }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat(suc(X), branch(nil_1, zero, W, nil_1))))
= { by axiom 39 (aboveNat_2) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat_case1(geNat(suc(X), zero), suc(X), zero, nil_1, nil_1, W)))
= { by axiom 23 (geNat_1) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat_case1(not(isLT(compareNat(suc(X), zero))), suc(X), zero, nil_1, nil_1, W)))
= { by axiom 12 (compareNat_3) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat_case1(not(isLT(gt)), suc(X), zero, nil_1, nil_1, W)))
= { by axiom 2 (isLT_3) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat_case1(not(false), suc(X), zero, nil_1, nil_1, W)))
= { by axiom 5 (not_1) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat_case1(true, suc(X), zero, nil_1, nil_1, W)))
= { by axiom 32 (aboveNat_case1_1) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat(suc(X), nil_1)))
= { by axiom 1 (nil_1_1) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, aboveNat(suc(X), leaf)))
= { by axiom 10 (aboveNat_1) }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, leaf))
= { by axiom 1 (nil_1_1) R->L }
  insertComplete(branch(belowNat(suc(X), insert(zero, W, Y2)), suc(X), Y, nil_1))
= { by lemma 62 R->L }
  insertComplete(branch(belowNat(suc(X), branch(nil_1, zero, W, nil_1)), suc(X), Y, nil_1))
= { by axiom 38 (belowNat_2) }
  insertComplete(branch(belowNat_case1(leNat(suc(X), zero), suc(X), zero, nil_1, nil_1, W), suc(X), Y, nil_1))
= { by axiom 24 (leNat_1) }
  insertComplete(branch(belowNat_case1(not(isGT(compareNat(suc(X), zero))), suc(X), zero, nil_1, nil_1, W), suc(X), Y, nil_1))
= { by axiom 12 (compareNat_3) }
  insertComplete(branch(belowNat_case1(not(isGT(gt)), suc(X), zero, nil_1, nil_1, W), suc(X), Y, nil_1))
= { by axiom 3 (isGT_3) }
  insertComplete(branch(belowNat_case1(not(true), suc(X), zero, nil_1, nil_1, W), suc(X), Y, nil_1))
= { by axiom 4 (not_2) }
  insertComplete(branch(belowNat_case1(false, suc(X), zero, nil_1, nil_1, W), suc(X), Y, nil_1))
= { by axiom 35 (belowNat_case1_2) }
  insertComplete(branch(branch(nil_1, zero, W, belowNat(suc(X), nil_1)), suc(X), Y, nil_1))
= { by axiom 1 (nil_1_1) }
  insertComplete(branch(branch(nil_1, zero, W, belowNat(suc(X), leaf)), suc(X), Y, nil_1))
= { by axiom 9 (belowNat_1) }
  insertComplete(branch(branch(nil_1, zero, W, leaf), suc(X), Y, nil_1))
= { by axiom 1 (nil_1_1) R->L }
  insertComplete(branch(branch(nil_1, zero, W, nil_1), suc(X), Y, nil_1))
= { by lemma 62 }
  insertComplete(branch(insert(zero, W, X2), suc(X), Y, nil_1))
= { by lemma 58 R->L }
  insertComplete(branch(flip(insert_1(zero), Z, W), suc(X), Y, nil_1))
= { by lemma 57 R->L }
  insertComplete(branch(flip(flip_1(insert_1(zero)), W, Z), suc(X), Y, nil_1))
= { by lemma 59 R->L }
  insertComplete(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1))
= { by axiom 41 (insertComplete_1) }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(opApply(flip_0, uncurry_1(insert_0)), nil_1, insertions(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1))))
= { by axiom 13 (opApply_1) }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(app(flip_0, uncurry_1(insert_0)), nil_1, insertions(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1))))
= { by axiom 14 (app_flip_0_1) }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, insertions(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1))))
= { by lemma 61 R->L }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, insertions(branch(insert(zero, snd(pair(Z, W)), S), suc(X), Y, nil_1))))
= { by lemma 65 R->L }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, opAppend(cons(pair(suc(X), Y), insertions(insert(zero, snd(pair(Z, W)), S))), insertions(nil_1))))
= { by lemma 44 }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, opAppend(cons(pair(suc(X), Y), insertions(insert(zero, snd(pair(Z, W)), S))), nil)))
= { by lemma 62 R->L }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, opAppend(cons(pair(suc(X), Y), insertions(branch(nil_1, zero, snd(pair(Z, W)), nil_1))), nil)))
= { by lemma 65 R->L }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, opAppend(cons(pair(suc(X), Y), opAppend(cons(pair(zero, snd(pair(Z, W))), insertions(nil_1)), insertions(nil_1))), nil)))
= { by lemma 44 }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, opAppend(cons(pair(suc(X), Y), opAppend(cons(pair(zero, snd(pair(Z, W))), nil), insertions(nil_1))), nil)))
= { by lemma 60 }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, opAppend(cons(pair(suc(X), Y), cons(pair(zero, snd(pair(Z, W))), insertions(nil_1))), nil)))
= { by lemma 44 }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, opAppend(cons(pair(suc(X), Y), cons(pair(zero, snd(pair(Z, W))), nil)), nil)))
= { by axiom 26 (opAppend_2) }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, cons(pair(suc(X), Y), opAppend(cons(pair(zero, snd(pair(Z, W))), nil), nil))))
= { by lemma 60 }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), nil_1, cons(pair(suc(X), Y), cons(pair(zero, snd(pair(Z, W))), nil))))
= { by lemma 66 }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), insert(suc(X), Y, T), cons(pair(zero, snd(pair(Z, W))), nil)))
= { by lemma 66 }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), foldl(flip_1(uncurry_1(insert_0)), insert(zero, snd(pair(Z, W)), U), nil))
= { by axiom 19 (foldl_1) }
  eqBSTNatNat(branch(uncurry(flip_1(insert_1(zero)), pair(Z, W)), suc(X), Y, nil_1), insert(zero, snd(pair(Z, W)), U))
= { by lemma 61 R->L }
  eqBSTNatNat(branch(insert(zero, snd(pair(Z, W)), V), suc(X), Y, nil_1), insert(zero, snd(pair(Z, W)), U))
= { by lemma 62 R->L }
  eqBSTNatNat(branch(insert(zero, snd(pair(Z, W)), V), suc(X), Y, nil_1), branch(nil_1, zero, snd(pair(Z, W)), nil_1))
= { by axiom 42 (eqBSTNatNat_4) }
  opAnd(eqBSTNatNat(insert(zero, snd(pair(Z, W)), V), nil_1), opAnd(eqNat(suc(X), zero), opAnd(eqNat(Y, snd(pair(Z, W))), eqBSTNatNat(nil_1, nil_1))))
= { by lemma 62 R->L }
  opAnd(eqBSTNatNat(branch(nil_1, zero, snd(pair(Z, W)), nil_1), nil_1), opAnd(eqNat(suc(X), zero), opAnd(eqNat(Y, snd(pair(Z, W))), eqBSTNatNat(nil_1, nil_1))))
= { by axiom 1 (nil_1_1) }
  opAnd(eqBSTNatNat(branch(nil_1, zero, snd(pair(Z, W)), nil_1), leaf), opAnd(eqNat(suc(X), zero), opAnd(eqNat(Y, snd(pair(Z, W))), eqBSTNatNat(nil_1, nil_1))))
= { by axiom 33 (eqBSTNatNat_3) }
  opAnd(false, opAnd(eqNat(suc(X), zero), opAnd(eqNat(Y, snd(pair(Z, W))), eqBSTNatNat(nil_1, nil_1))))
= { by axiom 8 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
