5668. foldl(flip_1(uncurry_1(flip_1(insert_0))), ?, cons(X, insertions(flip(uncurry_1(flip_1(insert_0)), ?, Y)))) -> tree(cons(Y, ?))
5669. foldl(flip_1(uncurry_1(flip_1(insert_0))), ?, cons(X, insertions(uncurry(uncurry_1(flip_1(insert_0)), Y)))) -> uncurry(uncurry_1(insert_0), Y)
