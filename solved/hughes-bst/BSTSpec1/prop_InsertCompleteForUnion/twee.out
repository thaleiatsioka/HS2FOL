5656. foldl(flip_1(insert_0), X, cons(Y, insertions(flip(uncurry_1(flip_1(insert_0)), ?, Z)))) = insert_2(pair(snd(Z), fst(Z)), insert_2(Y, X))
5657. insert_2(pair(snd(fst(X)), fst(fst(X))), insert_2(Y, Z)) = foldl(flip_1(insert_0), Z, cons(Y, insertions(uncurry(uncurry_1(flip_1(insert_0)), X))))
5658. foldl(flip_1(insert_0), X, cons(Y, insertions(uncurry(uncurry_1(insert_0), Z)))) -> foldr(insert_0, insert_2(Y, X), insertions(uncurry(uncurry_1(insert_0), Z)))
