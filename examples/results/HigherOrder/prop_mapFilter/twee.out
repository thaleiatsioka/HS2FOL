466. eqListNat(cons(X, nil), map(fn_id, map(Y, cons(Z, cons(W, V))))) -> opAnd(eqNat(X, app(Y, Z)), false)
467. map(fn_case_Nat(app(X, Y), fn_case_Nat(Z, X)), cons(suc(suc(Y)), W)) -> map(fn_case_Nat(app(X, Y), fn_case_Nat(Z, X)), cons(zero, W))
468. filter_case1(X, fn_id, X, map(fn_const(X), map(Y, filter(Z, W)))) = filter(fn_id, map(fn_const(X), map(Y, filter_case1(true, Z, ?, W))))
469. filter_case1(X, fn_id, X, map(fn_const(X), map(Y, map(Z, W)))) = filter(fn_id, map(fn_const(X), map(Y, map(Z, cons(?, W)))))
470. map(fn_case_Nat(X, fn_id), cons(suc(Y), cons(suc(Z), cons(zero, nil)))) -> cons(Y, cons(Z, cons(X, nil)))
471. map(fn_case_Nat(X, fn_id), cons(suc(Y), cons(zero, cons(zero, nil)))) = cons(Y, cons(X, cons(X, nil)))
472. map(fn_case_Nat(X, fn_id), cons(suc(Y), cons(zero, cons(suc(Z), nil)))) -> cons(Y, cons(X, cons(Z, nil)))
473. map(fn_case_Nat(X, fn_id), cons(zero, cons(suc(Y), cons(suc(Z), nil)))) -> cons(X, cons(Y, cons(Z, nil)))
474. filter_case1(true, fn_case_Nat(X, fn_id), Y, map(fn_id, cons(suc(false), Z))) -> filter_case1(true, fn_case_Nat(X, fn_id), Y, map(fn_id, Z))
475. filter_case1(X, fn_id, X, map(fn_const(X), cons(?, cons(?, nil)))) -> filter(fn_id, cons(X, cons(X, cons(X, nil))))
476. map(X, cons(Y, cons(Y, nil))) = map(fn_case_Nat(?, X), map(fn_const(suc(Y)), cons(?, cons(?, nil))))
477. map(fn_case_Nat(X, Y), map(fn_const(suc(Z)), cons(?, cons(?, nil)))) ~> map(fn_case_Nat(?, Y), map(fn_const(suc(Z)), cons(?, cons(?, nil))))
478. eqListNat(cons(X, nil), map(Y, map(Z, cons(W, cons(V, U))))) -> opAnd(eqNat(X, app(Y, app(Z, W))), false)
479. filter_case1(X, fn_const(X), app(Y, Z), filter(fn_const(true), map(Y, W))) -> filter(fn_const(X), filter(fn_const(true), map(Y, cons(Z, W))))
480. eqListNat(nil, filter(fn_const(true), filter(fn_const(true), map(X, cons(Y, Z))))) -> false
481. eqListNat(filter(fn_const(true), filter(fn_const(true), map(X, cons(Y, Z)))), nil) -> false
482. filter(fn_const(false), filter(fn_const(true), map(X, cons(Y, Z)))) -> filter(fn_const(false), filter(fn_const(true), map(X, Z)))
483. eqListNat(nil, map(X, filter(fn_const(true), filter(fn_const(true), map(Y, cons(Z, W)))))) -> false
484. eqListNat(map(X, filter(fn_const(true), filter(fn_const(true), map(Y, cons(Z, W))))), nil) -> false
485. eqListNat(nil, filter(fn_const(true), filter(fn_const(true), map(X, filter_case1(true, Y, Z, W))))) -> false
486. eqListNat(nil, filter(fn_const(true), filter(fn_const(true), map(X, map(Y, cons(Z, W)))))) -> false
487. eqListNat(filter(fn_const(true), filter(fn_const(true), map(X, filter_case1(true, Y, Z, W)))), nil) -> false
488. eqListNat(filter(fn_const(true), filter(fn_const(true), map(X, map(Y, cons(Z, W))))), nil) -> false
489. map(fn_const(X), map(Y, cons(?, filter_case1(true, Z, W, V)))) ~> map(fn_const(X), map(Y, cons(?, filter_case1(true, Z, ?, V))))
490. map(fn_const(X), map(Y, map(Z, cons(?, cons(W, V))))) ~> map(fn_const(X), map(Y, map(Z, cons(?, cons(?, V)))))
491. filter_case1(X, fn_const(X), Y, map(fn_id, map(fn_id, filter(Z, W)))) = filter(fn_const(X), map(fn_id, map(fn_id, filter_case1(true, Z, Y, W))))
492. map(fn_const(X), map(Y, cons(?, cons(?, map(Z, W))))) -> map(fn_const(X), map(Y, map(Z, cons(?, cons(?, W)))))
493. filter_case1(X, fn_case_Nat(Y, fn_id), suc(X), map(fn_id, filter(Z, W))) = filter(fn_case_Nat(Y, fn_id), map(fn_id, filter_case1(true, Z, suc(X), W)))
494. eqListNat(map(X, map(Y, cons(Z, cons(W, V)))), cons(U, nil)) -> opAnd(eqNat(app(X, app(Y, Z)), U), false)
495. map(fn_case_Nat(X, fn_id), cons(zero, map(fn_case_Nat(suc(X), Y), Z))) -> map(fn_case_Nat(X, fn_id), map(fn_case_Nat(suc(X), Y), cons(zero, Z)))
496. map(fn_const(app(X, Y)), cons(?, cons(?, cons(?, nil)))) = map(X, cons(Y, cons(Y, cons(Y, nil))))
497. cons(X, map(fn_case_Nat(Y, fn_case_Nat(Z, fn_case_Nat(X, W))), V)) -> map(fn_case_Nat(Y, fn_case_Nat(Z, fn_case_Nat(X, W))), cons(suc(suc(zero)), V))
498. filter_case1(true, fn_case_Nat(true, fn_id), X, cons(zero, cons(suc(true), nil))) -> cons(X, cons(zero, cons(suc(true), nil)))
499. map(fn_const(X), map(Y, map(Z, map(W, map(V, cons(U, nil)))))) -> cons(X, nil)
500. eqListNat(map(X, filter_case1(Y, fn_id, Y, Z)), filter(fn_id, map(X, cons(Y, Z)))) -> prop_mapFilter(X, fn_id, cons(Y, Z))
501. eqListNat(map(X, cons(true, nil)), filter(fn_id, map(X, cons(true, nil)))) -> prop_mapFilter(X, fn_id, cons(true, nil))
502. eqListNat(cons(X, nil), filter(fn_id, cons(X, nil))) -> prop_mapFilter(fn_const(X), fn_id, cons(true, nil))
503. eqListNat(cons(X, nil), filter_case1(X, fn_id, X, nil)) -> prop_mapFilter(fn_const(X), fn_id, cons(true, nil))
504. prop_mapFilter(fn_const(false), fn_id, cons(true, nil)) -> false
505. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (map_1): map(X, nil) = nil.
Axiom 2 (filter_1): filter(X, nil) = nil.
Axiom 3 (app_fn_id_1): app(fn_id, X) = X.
Axiom 4 (app_fn_const_1): app(fn_const(X), Y) = X.
Axiom 5 (filter_case1_2): filter_case1(false, X, Y, Z) = filter(X, Z).
Axiom 6 (eqListNat_3): eqListNat(cons(X, Y), nil) = false.
Axiom 7 (filter_case1_1): filter_case1(true, X, Y, Z) = cons(Y, filter(X, Z)).
Axiom 8 (filter_2): filter(X, cons(Y, Z)) = filter_case1(app(X, Y), X, Y, Z).
Axiom 9 (map_2): map(X, cons(Y, Z)) = cons(app(X, Y), map(X, Z)).
Axiom 10 (prop_mapFilter_1): prop_mapFilter(X, Y, Z) = eqListNat(map(X, filter(Y, Z)), filter(Y, map(X, Z))).

Lemma 11: filter(fn_id, cons(X, Y)) = filter_case1(X, fn_id, X, Y).
Proof:
  filter(fn_id, cons(X, Y))
= { by axiom 8 (filter_2) }
  filter_case1(app(fn_id, X), fn_id, X, Y)
= { by axiom 3 (app_fn_id_1) }
  filter_case1(X, fn_id, X, Y)

Lemma 12: map(fn_const(X), cons(Y, nil)) = cons(X, nil).
Proof:
  map(fn_const(X), cons(Y, nil))
= { by axiom 9 (map_2) }
  cons(app(fn_const(X), Y), map(fn_const(X), nil))
= { by axiom 1 (map_1) }
  cons(app(fn_const(X), Y), nil)
= { by axiom 4 (app_fn_const_1) }
  cons(X, nil)

Goal 1 (prop_mapFilter): prop_mapFilter(X, Y, Z) = false.
The goal is true when:
  X = fn_const(false)
  Y = fn_id
  Z = cons(true, nil)

Proof:
  prop_mapFilter(fn_const(false), fn_id, cons(true, nil))
= { by axiom 10 (prop_mapFilter_1) }
  eqListNat(map(fn_const(false), filter(fn_id, cons(true, nil))), filter(fn_id, map(fn_const(false), cons(true, nil))))
= { by lemma 11 }
  eqListNat(map(fn_const(false), filter_case1(true, fn_id, true, nil)), filter(fn_id, map(fn_const(false), cons(true, nil))))
= { by axiom 7 (filter_case1_1) }
  eqListNat(map(fn_const(false), cons(true, filter(fn_id, nil))), filter(fn_id, map(fn_const(false), cons(true, nil))))
= { by axiom 2 (filter_1) }
  eqListNat(map(fn_const(false), cons(true, nil)), filter(fn_id, map(fn_const(false), cons(true, nil))))
= { by lemma 12 }
  eqListNat(cons(false, nil), filter(fn_id, map(fn_const(false), cons(true, nil))))
= { by lemma 12 }
  eqListNat(cons(false, nil), filter(fn_id, cons(false, nil)))
= { by lemma 11 }
  eqListNat(cons(false, nil), filter_case1(false, fn_id, false, nil))
= { by axiom 5 (filter_case1_2) }
  eqListNat(cons(false, nil), filter(fn_id, nil))
= { by axiom 2 (filter_1) }
  eqListNat(cons(false, nil), nil)
= { by axiom 6 (eqListNat_3) }
  false

RESULT: Theorem (the conjecture is true).
