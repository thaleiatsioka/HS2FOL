The conjecture is true! Here is a proof.

Axiom 1 (not_1): not(false) = true.
Axiom 2 (isGT_2): isGT(eq) = false.
Axiom 3 (len_1): len(nil) = zero.
Axiom 4 (app_insertBad_0_1): app(insertBad_0, X) = insertBad_1(X).
Axiom 5 (insertBad_1): insertBad(X, nil) = cons(X, nil).
Axiom 6 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 7 (eqNat_4): eqNat(suc(X), suc(Y)) = eqNat(X, Y).
Axiom 8 (compareNat_1): compareNat(zero, zero) = eq.
Axiom 9 (foldr_1): foldr(X, Y, nil) = Y.
Axiom 10 (isortBad_1): isortBad(X) = foldr(insertBad_0, nil, X).
Axiom 11 (app_insertBad_1_1): app(insertBad_1(X), Y) = insertBad(X, Y).
Axiom 12 (len_2): len(cons(X, Y)) = suc(len(Y)).
Axiom 13 (leNat_1): leNat(X, Y) = not(isGT(compareNat(X, Y))).
Axiom 14 (insertBad_case1_1): insertBad_case1(true, X, Y, Z) = cons(X, Z).
Axiom 15 (insertBad_case1_2): insertBad_case1(false, X, Y, Z) = cons(Y, insertBad(X, Z)).
Axiom 16 (prop_sortLength_1): prop_sortLength(X) = eqNat(len(isortBad(X)), len(X)).
Axiom 17 (insertBad_2): insertBad(X, cons(Y, Z)) = insertBad_case1(leNat(X, Y), X, Y, Z).
Axiom 18 (foldr_2): foldr(X, Y, cons(Z, W)) = app(app(X, Z), foldr(X, Y, W)).

Lemma 19: len(insertBad(X, nil)) = suc(zero).
Proof:
  len(insertBad(X, nil))
= { by axiom 5 (insertBad_1) }
  len(cons(X, nil))
= { by axiom 12 (len_2) }
  suc(len(nil))
= { by axiom 3 (len_1) }
  suc(zero)

Lemma 20: insertBad(X, isortBad(Y)) = isortBad(cons(X, Y)).
Proof:
  insertBad(X, isortBad(Y))
= { by axiom 11 (app_insertBad_1_1) R->L }
  app(insertBad_1(X), isortBad(Y))
= { by axiom 4 (app_insertBad_0_1) R->L }
  app(app(insertBad_0, X), isortBad(Y))
= { by axiom 10 (isortBad_1) }
  app(app(insertBad_0, X), foldr(insertBad_0, nil, Y))
= { by axiom 18 (foldr_2) R->L }
  foldr(insertBad_0, nil, cons(X, Y))
= { by axiom 10 (isortBad_1) R->L }
  isortBad(cons(X, Y))

Goal 1 (prop_sortLength): prop_sortLength(X) = false.
The goal is true when:
  X = insertBad_case1(false, zero, zero, nil)

Proof:
  prop_sortLength(insertBad_case1(false, zero, zero, nil))
= { by axiom 15 (insertBad_case1_2) }
  prop_sortLength(cons(zero, insertBad(zero, nil)))
= { by axiom 16 (prop_sortLength_1) }
  eqNat(len(isortBad(cons(zero, insertBad(zero, nil)))), len(cons(zero, insertBad(zero, nil))))
= { by axiom 12 (len_2) }
  eqNat(len(isortBad(cons(zero, insertBad(zero, nil)))), suc(len(insertBad(zero, nil))))
= { by lemma 19 }
  eqNat(len(isortBad(cons(zero, insertBad(zero, nil)))), suc(suc(zero)))
= { by lemma 20 R->L }
  eqNat(len(insertBad(zero, isortBad(insertBad(zero, nil)))), suc(suc(zero)))
= { by axiom 5 (insertBad_1) }
  eqNat(len(insertBad(zero, isortBad(cons(zero, nil)))), suc(suc(zero)))
= { by lemma 20 R->L }
  eqNat(len(insertBad(zero, insertBad(zero, isortBad(nil)))), suc(suc(zero)))
= { by axiom 10 (isortBad_1) }
  eqNat(len(insertBad(zero, insertBad(zero, foldr(insertBad_0, nil, nil)))), suc(suc(zero)))
= { by axiom 9 (foldr_1) }
  eqNat(len(insertBad(zero, insertBad(zero, nil))), suc(suc(zero)))
= { by axiom 5 (insertBad_1) }
  eqNat(len(insertBad(zero, cons(zero, nil))), suc(suc(zero)))
= { by axiom 17 (insertBad_2) }
  eqNat(len(insertBad_case1(leNat(zero, zero), zero, zero, nil)), suc(suc(zero)))
= { by axiom 13 (leNat_1) }
  eqNat(len(insertBad_case1(not(isGT(compareNat(zero, zero))), zero, zero, nil)), suc(suc(zero)))
= { by axiom 8 (compareNat_1) }
  eqNat(len(insertBad_case1(not(isGT(eq)), zero, zero, nil)), suc(suc(zero)))
= { by axiom 2 (isGT_2) }
  eqNat(len(insertBad_case1(not(false), zero, zero, nil)), suc(suc(zero)))
= { by axiom 1 (not_1) }
  eqNat(len(insertBad_case1(true, zero, zero, nil)), suc(suc(zero)))
= { by axiom 14 (insertBad_case1_1) }
  eqNat(len(cons(zero, nil)), suc(suc(zero)))
= { by axiom 5 (insertBad_1) R->L }
  eqNat(len(insertBad(zero, nil)), suc(suc(zero)))
= { by lemma 19 }
  eqNat(suc(zero), suc(suc(zero)))
= { by axiom 7 (eqNat_4) }
  eqNat(zero, suc(zero))
= { by axiom 6 (eqNat_2) }
  false

RESULT: Theorem (the conjecture is true).
