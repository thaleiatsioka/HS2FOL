Here is the input problem:
  Axiom 1 (reverse_1): reverse(nil) = nil.
  Axiom 2 (opAnd_2): opAnd(true, X) = X.
  Axiom 3 (opAnd_1): opAnd(false, X) = false.
  Axiom 4 (opAppend_1): opAppend(nil, X) = X.
  Axiom 5 (eqListNat_1): eqListNat(nil, nil) = true.
  Axiom 6 (eqNat_1): eqNat(zero, zero) = true.
  Axiom 7 (eqNat_2): eqNat(zero, suc(X)) = false.
  Axiom 8 (eqNat_3): eqNat(suc(X), zero) = false.
  Axiom 9 (reverse_2): reverse(cons(X, Y)) = opAppend(reverse(Y), cons(X, nil)).
  Axiom 10 (eqListNat_2): eqListNat(nil, cons(X, Y)) = false.
  Axiom 11 (eqListNat_3): eqListNat(cons(X, Y), nil) = false.
  Axiom 12 (eqNat_4): eqNat(suc(X), suc(Y)) = eqNat(X, Y).
  Axiom 13 (opAppend_2): opAppend(cons(X, Y), Z) = cons(X, opAppend(Y, Z)).
  Axiom 14 (eqListNat_4): eqListNat(cons(X, Y), cons(Z, W)) = opAnd(eqNat(X, Z), eqListNat(Y, W)).
  Axiom 15 (prop_revApp_1): prop_revApp(X, Y) = eqListNat(reverse(opAppend(X, Y)), opAppend(reverse(X), reverse(Y))).
  Axiom 16 (reflexivity): equals(X, X) = true.
  Axiom 17 (prop_revApp): equals(prop_revApp(X, Y), false) = false.
  Goal 1 (true_equals_false): true = false.

1. reverse(nil) -> nil
2. opAnd(true, X) -> X
3. opAnd(false, X) -> false
