Here is the input problem:
  Axiom 1 (opOr_2): opOr(true, X) = true.
  Axiom 2 (opOr_1): opOr(false, X) = X.
  Axiom 3 (implies_2): implies(true, X) = X.
  Axiom 4 (implies_1): implies(false, X) = true.
  Axiom 5 (elemNat_1): elemNat(X, nil) = false.
  Axiom 6 (eqNat_1): eqNat(zero, zero) = true.
  Axiom 7 (eqNat_2): eqNat(zero, suc(X)) = false.
  Axiom 8 (eqNat_3): eqNat(suc(X), zero) = false.
  Axiom 9 (eqNat_4): eqNat(suc(X), suc(Y)) = eqNat(X, Y).
  Axiom 10 (head_1): head(cons(X, Y)) = X.
  Axiom 11 (elemNat_2): elemNat(X, cons(Y, Z)) = opOr(eqNat(X, Y), elemNat(X, Z)).
  Axiom 12 (prop_elemHead_1): prop_elemHead(X, Y) = implies(elemNat(X, Y), eqNat(head(Y), X)).
  Axiom 13 (reflexivity): equals(X, X) = true.
  Axiom 14 (prop_elemHead): equals(prop_elemHead(X, Y), false) = false.
  Goal 1 (true_equals_false): true = false.

1. opOr(true, X) -> true
2. opOr(false, X) -> X
3. implies(true, X) -> X
4. implies(false, X) -> true
5. elemNat(X, nil) -> false
6. eqNat(zero, zero) -> true
7. eqNat(zero, suc(X)) -> false
8. eqNat(suc(X), zero) -> false
9. eqNat(suc(X), suc(Y)) -> eqNat(X, Y)
10. head(cons(X, Y)) -> X
11. opOr(eqNat(X, Y), elemNat(X, Z)) -> elemNat(X, cons(Y, Z))
12. implies(elemNat(X, Y), eqNat(head(Y), X)) -> prop_elemHead(X, Y)
13. equals(X, X) -> true
14. equals(prop_elemHead(X, Y), false) -> false
15. prop_elemHead(X, nil) -> true
16. equals(true, false) -> false
17. elemNat(zero, cons(zero, X)) -> true
