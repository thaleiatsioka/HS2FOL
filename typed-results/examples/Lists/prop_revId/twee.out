Goal 1 (prop_revId): prop_revId(X) = false.
The goal is true when:
  X = cons_nat(suc(X), cons_nat(zero, nil_nat))

Proof:
  prop_revId(cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 5 (prop_revId_1) }
  eqListNat(revNat(cons_nat(suc(X), cons_nat(zero, nil_nat))), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 2 (revNat_1) }
  eqListNat(revNat_go(cons_nat(suc(X), cons_nat(zero, nil_nat)), nil_nat), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 8 (revNat_go_2) }
  eqListNat(revNat_go(cons_nat(zero, nil_nat), cons_nat(suc(X), nil_nat)), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 8 (revNat_go_2) }
  eqListNat(revNat_go(nil_nat, cons_nat(zero, cons_nat(suc(X), nil_nat))), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 3 (revNat_go_1) }
  eqListNat(cons_nat(zero, cons_nat(suc(X), nil_nat)), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 9 (eqListNat_4) }
  opAnd(eqNat(zero, suc(X)), eqListNat(cons_nat(suc(X), nil_nat), cons_nat(zero, nil_nat)))
= { by axiom 9 (eqListNat_4) }
  opAnd(eqNat(zero, suc(X)), opAnd(eqNat(suc(X), zero), eqListNat(nil_nat, nil_nat)))
= { by axiom 4 (eqListNat_1) }
  opAnd(eqNat(zero, suc(X)), opAnd(eqNat(suc(X), zero), true))
= { by axiom 6 (eqNat_2) }
  opAnd(false, opAnd(eqNat(suc(X), zero), true))
= { by axiom 1 (opAnd_1) }
  false

