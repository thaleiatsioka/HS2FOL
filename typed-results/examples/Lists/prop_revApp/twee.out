The conjecture is true! Here is a proof.

Axiom 1 (reverseNat_1): reverseNat(nil_nat) = nil_nat.
Axiom 2 (opAnd_1): opAnd(false, X) = false.
Axiom 3 (opAppendNat_1): opAppendNat(nil_nat, X) = X.
Axiom 4 (eqListNat_1): eqListNat(nil_nat, nil_nat) = true.
Axiom 5 (eqNat_2): eqNat(zero, suc(X)) = false.
Axiom 8 (reverseNat_2): reverseNat(cons_nat(X, Y)) = opAppendNat(reverseNat(Y), cons_nat(X, nil_nat)).
Axiom 9 (opAppendNat_2): opAppendNat(cons_nat(X, Y), Z) = cons_nat(X, opAppendNat(Y, Z)).
Axiom 10 (eqListNat_4): eqListNat(cons_nat(X, Y), cons_nat(Z, W)) = opAnd(eqNat(X, Z), eqListNat(Y, W)).
Axiom 11 (prop_revApp_1): prop_revApp(X, Y) = eqListNat(reverseNat(opAppendNat(X, Y)), opAppendNat(reverseNat(X), reverseNat(Y))).

Lemma 12: reverseNat(cons_nat(X, nil_nat)) = cons_nat(X, nil_nat).
Proof:
  reverseNat(cons_nat(X, nil_nat))
= { by axiom 8 (reverseNat_2) }
  opAppendNat(reverseNat(nil_nat), cons_nat(X, nil_nat))
= { by axiom 1 (reverseNat_1) }
  opAppendNat(nil_nat, cons_nat(X, nil_nat))
= { by axiom 3 (opAppendNat_1) }
  cons_nat(X, nil_nat)

Lemma 13: opAppendNat(cons_nat(X, nil_nat), Y) = cons_nat(X, Y).
Proof:
  opAppendNat(cons_nat(X, nil_nat), Y)
= { by axiom 9 (opAppendNat_2) }
  cons_nat(X, opAppendNat(nil_nat, Y))
= { by axiom 3 (opAppendNat_1) }
  cons_nat(X, Y)

Goal 1 (prop_revApp): prop_revApp(X, Y) = false.
The goal is true when:
  X = cons_nat(suc(X), nil_nat)
  Y = cons_nat(zero, nil_nat)

Proof:
  prop_revApp(cons_nat(suc(X), nil_nat), cons_nat(zero, nil_nat))
= { by axiom 11 (prop_revApp_1) }
  eqListNat(reverseNat(opAppendNat(cons_nat(suc(X), nil_nat), cons_nat(zero, nil_nat))), opAppendNat(reverseNat(cons_nat(suc(X), nil_nat)), reverseNat(cons_nat(zero, nil_nat))))
= { by lemma 13 }
  eqListNat(reverseNat(cons_nat(suc(X), cons_nat(zero, nil_nat))), opAppendNat(reverseNat(cons_nat(suc(X), nil_nat)), reverseNat(cons_nat(zero, nil_nat))))
= { by lemma 12 }
  eqListNat(reverseNat(cons_nat(suc(X), cons_nat(zero, nil_nat))), opAppendNat(cons_nat(suc(X), nil_nat), reverseNat(cons_nat(zero, nil_nat))))
= { by lemma 13 }
  eqListNat(reverseNat(cons_nat(suc(X), cons_nat(zero, nil_nat))), cons_nat(suc(X), reverseNat(cons_nat(zero, nil_nat))))
= { by lemma 12 }
  eqListNat(reverseNat(cons_nat(suc(X), cons_nat(zero, nil_nat))), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 8 (reverseNat_2) }
  eqListNat(opAppendNat(reverseNat(cons_nat(zero, nil_nat)), cons_nat(suc(X), nil_nat)), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by lemma 12 }
  eqListNat(opAppendNat(cons_nat(zero, nil_nat), cons_nat(suc(X), nil_nat)), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by lemma 13 }
  eqListNat(cons_nat(zero, cons_nat(suc(X), nil_nat)), cons_nat(suc(X), cons_nat(zero, nil_nat)))
= { by axiom 10 (eqListNat_4) }
  opAnd(eqNat(zero, suc(X)), eqListNat(cons_nat(suc(X), nil_nat), cons_nat(zero, nil_nat)))
= { by axiom 10 (eqListNat_4) }
  opAnd(eqNat(zero, suc(X)), opAnd(eqNat(suc(X), zero), eqListNat(nil_nat, nil_nat)))
= { by axiom 4 (eqListNat_1) }
  opAnd(eqNat(zero, suc(X)), opAnd(eqNat(suc(X), zero), true))
= { by axiom 5 (eqNat_2) }
  opAnd(false, opAnd(eqNat(suc(X), zero), true))
= { by axiom 2 (opAnd_1) }
  false

RESULT: Theorem (the conjecture is true).
