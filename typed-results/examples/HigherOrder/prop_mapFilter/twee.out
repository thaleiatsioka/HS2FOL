307. eqListNat(mapNatNat(fn_id_nat, filterNat_case1(true, X, zero, Y)), cons_nat(zero, Z)) -> eqListNat(mapNatNat(fn_id_nat, filterNat(X, Y)), Z)
308. eqListNat(cons_nat(zero, X), mapNatNat(fn_id_nat, filterNat_case1(true, Y, zero, Z))) -> eqListNat(X, mapNatNat(fn_id_nat, filterNat(Y, Z)))
309. filterNat(fn_const_nat_bool(true), mapNatNat(X, cons_nat(Y, cons_nat(Z, nil_nat)))) -> mapNatNat(X, cons_nat(Y, cons_nat(Z, nil_nat)))
310. filterNat(fn_const_nat_bool(true), cons_nat(X, cons_nat(X, nil_nat))) -> mapNatNat(fn_const_nat_nat(X), cons_nat(?, cons_nat(?, nil_nat)))
311. cons_nat(app_nat_nat(fn_case_Nat_nat(X, fn_id_nat), Y), cons_nat(Z, nil_nat)) -> mapNatNat(fn_case_Nat_nat(X, fn_id_nat), cons_nat(Y, cons_nat(suc(Z), nil_nat)))
312. eqListNat(mapNatNat(X, cons_nat(Y, cons_nat(Z, nil_nat))), mapNatNat(X, cons_nat(Y, cons_nat(Z, nil_nat)))) -> prop_mapFilter(X, fn_const_nat_bool(true), cons_nat(Y, cons_nat(Z, nil_nat)))
313. prop_mapFilter(fn_case_Nat_nat(X, Y), fn_const_nat_bool(true), cons_nat(suc(Z), nil_nat)) -> prop_mapFilter(Y, fn_const_nat_bool(true), cons_nat(Z, nil_nat))
314. mapNatNat(fn_case_Nat_nat(X, fn_id_nat), mapNatNat(fn_id_nat, cons_nat(suc(X), Y))) -> mapNatNat(fn_case_Nat_nat(X, fn_id_nat), mapNatNat(fn_id_nat, cons_nat(zero, Y)))
315. prop_mapFilter(fn_const_nat_nat(X), fn_const_nat_bool(true), mapNatNat(?, cons_nat(?, nil_nat))) = opAnd(eqNat(X, X), true)
316. prop_mapFilter(fn_const_nat_nat(X), fn_const_nat_bool(true), mapNatNat(Y, cons_nat(Z, nil_nat))) ~> prop_mapFilter(fn_const_nat_nat(X), fn_const_nat_bool(true), mapNatNat(?, cons_nat(?, nil_nat)))
317. cons_nat(app_nat_nat(X, Y), mapNatNat(fn_case_Nat_nat(Z, fn_case_Nat_nat(W, X)), V)) -> mapNatNat(fn_case_Nat_nat(Z, fn_case_Nat_nat(W, X)), cons_nat(suc(suc(Y)), V))
318. eqListNat(mapNatNat(fn_id_nat, mapNatNat(fn_id_nat, cons_nat(zero, X))), cons_nat(zero, Y)) -> eqListNat(mapNatNat(fn_id_nat, mapNatNat(fn_id_nat, X)), Y)
319. eqListNat(mapNatNat(fn_id_nat, cons_nat(zero, X)), mapNatNat(fn_id_nat, cons_nat(zero, Y))) -> eqListNat(mapNatNat(fn_id_nat, X), mapNatNat(fn_id_nat, Y))
320. eqListNat(cons_nat(zero, X), mapNatNat(fn_id_nat, mapNatNat(fn_id_nat, cons_nat(zero, Y)))) -> eqListNat(X, mapNatNat(fn_id_nat, mapNatNat(fn_id_nat, Y)))
321. eqListNat(nil_nat, filterNat(fn_const_nat_bool(true), filterNat(fn_case_Nat_bool(true, X), cons_nat(zero, Y)))) -> false
322. prop_mapFilter(fn_id_nat, fn_case_Nat_bool(false, X), filterNat_case1(true, Y, zero, Z)) -> prop_mapFilter(fn_id_nat, fn_case_Nat_bool(false, X), filterNat(Y, Z))
323. eqListNat(filterNat(fn_const_nat_bool(true), filterNat(fn_case_Nat_bool(true, X), cons_nat(zero, Y))), nil_nat) -> false
324. eqListNat(nil_nat, filterNat(fn_case_Nat_bool(true, X), filterNat(fn_const_nat_bool(true), cons_nat(zero, Y)))) -> false
325. eqListNat(filterNat(fn_case_Nat_bool(true, X), filterNat(fn_const_nat_bool(true), cons_nat(zero, Y))), nil_nat) -> false
326. filterNat_case1(true, fn_case_Nat_bool(X, fn_const_nat_bool(true)), Y, cons_nat(suc(Z), nil_nat)) -> cons_nat(Y, cons_nat(suc(Z), nil_nat))
327. mapNatNat(fn_const_nat_nat(X), mapNatNat(Y, mapNatNat(Z, mapNatNat(W, cons_nat(V, nil_nat))))) -> cons_nat(X, nil_nat)
328. eqListNat(mapNatNat(X, mapNatNat(Y, cons_nat(Z, nil_nat))), cons_nat(W, nil_nat)) -> opAnd(eqNat(app_nat_nat(X, app_nat_nat(Y, Z)), W), true)
329. eqListNat(mapNatNat(X, cons_nat(Y, nil_nat)), mapNatNat(Z, cons_nat(W, nil_nat))) -> opAnd(eqNat(app_nat_nat(X, Y), app_nat_nat(Z, W)), true)
330. eqListNat(cons_nat(X, nil_nat), mapNatNat(Y, mapNatNat(Z, cons_nat(W, nil_nat)))) -> opAnd(eqNat(X, app_nat_nat(Y, app_nat_nat(Z, W))), true)
331. prop_mapFilter(fn_const_nat_nat(X), fn_const_nat_bool(true), mapNatNat(?, cons_nat(?, nil_nat))) -> prop_mapFilter(fn_id_nat, fn_const_nat_bool(true), cons_nat(X, nil_nat))
332. cons_nat(X, mapNatNat(fn_case_Nat_nat(Y, fn_case_Nat_nat(Z, fn_id_nat)), W)) -> mapNatNat(fn_case_Nat_nat(Y, fn_case_Nat_nat(Z, fn_id_nat)), cons_nat(suc(suc(X)), W))
333. opAnd(eqNat(X, X), true) = prop_mapFilter(fn_id_nat, fn_const_nat_bool(true), cons_nat(zero, cons_nat(X, nil_nat)))
334. eqListNat(cons_nat(X, nil_nat), filterNat(fn_const_nat_bool(true), cons_nat(Y, cons_nat(Z, W)))) -> opAnd(eqNat(X, Y), false)
335. eqListNat(filterNat(fn_const_nat_bool(true), cons_nat(X, cons_nat(Y, Z))), cons_nat(W, nil_nat)) -> opAnd(eqNat(X, W), false)
336. eqListNat(mapNatNat(X, cons_nat(zero, nil_nat)), filterNat(fn_case_Nat_bool(true, Y), mapNatNat(X, cons_nat(zero, nil_nat)))) -> prop_mapFilter(X, fn_case_Nat_bool(true, Y), cons_nat(zero, nil_nat))
337. eqListNat(cons_nat(X, nil_nat), filterNat(fn_case_Nat_bool(true, Y), cons_nat(X, nil_nat))) -> prop_mapFilter(fn_const_nat_nat(X), fn_case_Nat_bool(true, Y), cons_nat(zero, nil_nat))
338. prop_mapFilter(fn_const_nat_nat(zero), fn_case_Nat_bool(true, X), cons_nat(zero, nil_nat)) -> true
339. prop_mapFilter(fn_const_nat_nat(suc(X)), fn_case_Nat_bool(true, fn_const_nat_bool(false)), cons_nat(zero, nil_nat)) -> false
340. false -> true

The conjecture is true! Here is a proof.

Axiom 1 (mapNatNat_1): mapNatNat(X, nil_nat) = nil_nat.
Axiom 2 (filterNat_1): filterNat(X, nil_nat) = nil_nat.
Axiom 3 (app_fn_const_nat_bool_1): app_nat_bool(fn_const_nat_bool(X), Y) = X.
Axiom 5 (app_fn_const_nat_nat_1): app_nat_nat(fn_const_nat_nat(X), Y) = X.
Axiom 6 (filterNat_case1_2): filterNat_case1(false, X, Y, Z) = filterNat(X, Z).
Axiom 7 (eqListNat_3): eqListNat(cons_nat(X, Y), nil_nat) = false.
Axiom 8 (app_fn_case_Nat_bool_1): app_nat_bool(fn_case_Nat_bool(X, Y), zero) = X.
Axiom 9 (app_fn_case_Nat_bool_2): app_nat_bool(fn_case_Nat_bool(X, Y), suc(Z)) = app_nat_bool(Y, Z).
Axiom 10 (filterNat_case1_1): filterNat_case1(true, X, Y, Z) = cons_nat(Y, filterNat(X, Z)).
Axiom 12 (filterNat_2): filterNat(X, cons_nat(Y, Z)) = filterNat_case1(app_nat_bool(X, Y), X, Y, Z).
Axiom 13 (mapNatNat_2): mapNatNat(X, cons_nat(Y, Z)) = cons_nat(app_nat_nat(X, Y), mapNatNat(X, Z)).
Axiom 14 (prop_mapFilter_1): prop_mapFilter(X, Y, Z) = eqListNat(mapNatNat(X, filterNat(Y, Z)), filterNat(Y, mapNatNat(X, Z))).

Lemma 15: mapNatNat(fn_const_nat_nat(X), cons_nat(Y, nil_nat)) = cons_nat(X, nil_nat).
Proof:
  mapNatNat(fn_const_nat_nat(X), cons_nat(Y, nil_nat))
= { by axiom 13 (mapNatNat_2) }
  cons_nat(app_nat_nat(fn_const_nat_nat(X), Y), mapNatNat(fn_const_nat_nat(X), nil_nat))
= { by axiom 1 (mapNatNat_1) }
  cons_nat(app_nat_nat(fn_const_nat_nat(X), Y), nil_nat)
= { by axiom 5 (app_fn_const_nat_nat_1) }
  cons_nat(X, nil_nat)

Goal 1 (prop_mapFilter): prop_mapFilter(X, Y, Z) = false.
The goal is true when:
  X = fn_const_nat_nat(suc(X))
  Y = fn_case_Nat_bool(true, fn_const_nat_bool(false))
  Z = cons_nat(zero, nil_nat)

Proof:
  prop_mapFilter(fn_const_nat_nat(suc(X)), fn_case_Nat_bool(true, fn_const_nat_bool(false)), cons_nat(zero, nil_nat))
= { by axiom 14 (prop_mapFilter_1) }
  eqListNat(mapNatNat(fn_const_nat_nat(suc(X)), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), cons_nat(zero, nil_nat))), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, nil_nat))))
= { by axiom 12 (filterNat_2) }
  eqListNat(mapNatNat(fn_const_nat_nat(suc(X)), filterNat_case1(app_nat_bool(fn_case_Nat_bool(true, fn_const_nat_bool(false)), zero), fn_case_Nat_bool(true, fn_const_nat_bool(false)), zero, nil_nat)), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, nil_nat))))
= { by axiom 8 (app_fn_case_Nat_bool_1) }
  eqListNat(mapNatNat(fn_const_nat_nat(suc(X)), filterNat_case1(true, fn_case_Nat_bool(true, fn_const_nat_bool(false)), zero, nil_nat)), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, nil_nat))))
= { by axiom 10 (filterNat_case1_1) }
  eqListNat(mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), nil_nat))), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, nil_nat))))
= { by axiom 2 (filterNat_1) }
  eqListNat(mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, nil_nat)), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, nil_nat))))
= { by lemma 15 }
  eqListNat(cons_nat(suc(X), nil_nat), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), mapNatNat(fn_const_nat_nat(suc(X)), cons_nat(zero, nil_nat))))
= { by lemma 15 }
  eqListNat(cons_nat(suc(X), nil_nat), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), cons_nat(suc(X), nil_nat)))
= { by axiom 12 (filterNat_2) }
  eqListNat(cons_nat(suc(X), nil_nat), filterNat_case1(app_nat_bool(fn_case_Nat_bool(true, fn_const_nat_bool(false)), suc(X)), fn_case_Nat_bool(true, fn_const_nat_bool(false)), suc(X), nil_nat))
= { by axiom 9 (app_fn_case_Nat_bool_2) }
  eqListNat(cons_nat(suc(X), nil_nat), filterNat_case1(app_nat_bool(fn_const_nat_bool(false), X), fn_case_Nat_bool(true, fn_const_nat_bool(false)), suc(X), nil_nat))
= { by axiom 3 (app_fn_const_nat_bool_1) }
  eqListNat(cons_nat(suc(X), nil_nat), filterNat_case1(false, fn_case_Nat_bool(true, fn_const_nat_bool(false)), suc(X), nil_nat))
= { by axiom 6 (filterNat_case1_2) }
  eqListNat(cons_nat(suc(X), nil_nat), filterNat(fn_case_Nat_bool(true, fn_const_nat_bool(false)), nil_nat))
= { by axiom 2 (filterNat_1) }
  eqListNat(cons_nat(suc(X), nil_nat), nil_nat)
= { by axiom 7 (eqListNat_3) }
  false

RESULT: Theorem (the conjecture is true).
