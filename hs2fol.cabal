cabal-version:      2.4
name:               hs2fol
version:            0.1.0.0
synopsis:           Translate a subset of Haskell to first-order logic (TPTP) to find counterexamples to QuickCheck properties with theorem provers
license:            BSD-3-Clause
build-type:         Simple
extra-doc-files:    README.md SPEC.md

executable hs2fol
  main-is:          Main.hs
  hs-source-dirs:   src
  other-modules:    Decode
                    Desugar
                    FOL
                    Lexer
                    Lift
                    Names
                    Parser
                    PreludeSrc
                    Specialise
                    Syntax
                    Translate
                    TypeCheck
  build-depends:    base >=4.11 && <5,
                    containers,
                    mtl,
                    parsec >=3.1.12,
                    directory,
                    filepath
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-matches -Wno-incomplete-uni-patterns -Wno-unused-do-bind
